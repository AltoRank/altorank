# Copy to docker/.env and fill in.
#
# Minimum to boot: the two NEXT_PUBLIC_SUPABASE_* values.
# Minimum to be useful: add ANTHROPIC_API_KEY.

# From `supabase start` (local) or your project's API settings (hosted).
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The one key that makes content generation work at all.
ANTHROPIC_API_KEY=

# Optional. Each degrades rather than failing:
#   DATAFORSEO_*     keyword volume, SERP, rank checks   (research falls back to prompt-only)
#   OPENAI_API_KEY   generated images                    (articles publish without them)
#   PAGESPEED_API_KEY  Core Web Vitals in domain audits. Google allows unkeyed
#                      requests, but at a rate limit low enough that real use
#                      gets 429s, so audits report pagespeed as unavailable
#                      without one. Free from the Google Cloud console
#                      (enable "PageSpeed Insights API").
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
OPENAI_API_KEY=
PAGESPEED_API_KEY=

# Required to use the features they guard. Both fail closed rather than
# degrading, so leaving them blank disables the feature instead of weakening it:
#   ENCRYPTION_KEY  CMS credentials are AES-256-GCM encrypted at rest. Unset,
#                   lib/crypto.ts throws and no CMS can be connected. It never
#                   falls back to storing them in plaintext.
#   CRON_SECRET     the /api/cron/* routes compare it to an x-cron-secret
#                   header. Unset, every cron request is rejected with a 401,
#                   so rank tracking and the analytics sync simply do not run.
# Generate each with:  openssl rand -hex 32
ENCRYPTION_KEY=
CRON_SECRET=

# Optional model overrides. Defaults live in apps/web/lib/ai/models.ts and are
# current as shipped, so leave these blank unless your key has access to a
# different model set or you want to trade quality for cost.
#   ANTHROPIC_MODEL             everything Claude-backed          (default claude-sonnet-5)
#   ANTHROPIC_MODEL_STRUCTURED  short tasks only: meta, clusters,
#                               briefs, SERP summaries            (defaults to ANTHROPIC_MODEL)
#   OPENAI_MODEL                only when a workspace picks OpenAI (default gpt-4o)
#   OPENAI_IMAGE_MODEL          featured images                    (default dall-e-3)
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_STRUCTURED=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=

# Operator accounts, comma-separated. An operator sees the Operations pages:
# cross-account costs, every user, and "View as", which opens the product as
# any account in one click (every use is written to admin_impersonations).
# Operators are also unmetered. Unset, it defaults to the AltoRank team's
# address, which is useless on your install; set it to yourself. Set but
# empty means nobody is an operator.
ADMIN_EMAILS=

NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
