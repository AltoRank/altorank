# Copy to docker/.env and fill in.
#
# Required for an install that works end to end:
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#   ANTHROPIC_API_KEY
#   ENCRYPTION_KEY, CRON_SECRET   (docker compose refuses to start without CRON_SECRET)
#   RESEND_API_KEY, RESEND_FROM_EMAIL   (signup confirms by email; without them
#                                        nobody can create an account)
# Everything else below is optional and says what it turns on.

# From `supabase start` (local) or your project's API settings (hosted).
# A local stack's API is on port 54331 (apps/web/supabase/config.toml).
#   npm run dev (apps/web/.env.local):  http://127.0.0.1:54331
#   docker compose (docker/.env):        http://host.docker.internal:54331
#     Inside the container 127.0.0.1 is the container itself; compose maps
#     host.docker.internal to the host on Linux too.
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The one key that makes content generation work at all.
ANTHROPIC_API_KEY=

# Optional. Each degrades rather than failing:
#   DATAFORSEO_*     keyword volume, SERP, rank checks   (research falls back to prompt-only)
#   OPENAI_API_KEY   generated images                    (articles publish without them)
#   PAGESPEED_API_KEY  Core Web Vitals in domain audits. Google allows unkeyed
#                      requests, but at a rate limit low enough that real use
#                      gets 429s, so audits report pagespeed as unavailable
#                      without one. Free from the Google Cloud console
#                      (enable "PageSpeed Insights API").
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Or, instead of the pair, the base64("login:password") value DataForSEO shows:
DATAFORSEO_API_KEY=
OPENAI_API_KEY=
PAGESPEED_API_KEY=

# Required to use the features they guard. Both fail closed rather than
# degrading, so leaving them blank disables the feature instead of weakening it:
#   ENCRYPTION_KEY  CMS credentials are AES-256-GCM encrypted at rest. Unset,
#                   lib/crypto.ts throws and no CMS can be connected. It never
#                   falls back to storing them in plaintext.
#   CRON_SECRET     the /api/cron/* routes compare it to an x-cron-secret
#                   header. Unset, every cron request is rejected with a 401,
#                   so rank tracking and the analytics sync simply do not run.
# Generate each with:  openssl rand -hex 32
ENCRYPTION_KEY=
CRON_SECRET=

# Email. The app sends its own auth emails (confirm, reset, magic link) and every
# invite and notification through Resend; Supabase's SMTP settings are not used.
# Without RESEND_API_KEY there is no email at all, so no signup confirmation and
# no password reset. RESEND_FROM_EMAIL must be a sender on a domain verified in
# your Resend account; the default is AltoRank's, which yours will reject.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional. Where replies to app emails go. Unset: no Reply-To header, so
# replies go to RESEND_FROM_EMAIL.
RESEND_REPLY_TO=
# Where the in-app feedback widget and "Request integration" deliver. Unset
# means nowhere: both answer that feedback is not configured.
FEEDBACK_EMAIL=

# Google Search Console connect. Create an OAuth client in Google Cloud and
# register <NEXT_PUBLIC_APP_URL>/api/auth/google/callback as the redirect URI.
# Unset, the connect button reports google_oauth_not_configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Billing. Leave all of these blank on a self-hosted install: with no
# STRIPE_SECRET_KEY every account is unmetered and there is no trial or card.
# STRIPE_SECRET_KEY alone turns billing on: every account then needs a plan or
# a card trial, and checkout refuses until the price ids are set too. So set
# all six together or none. The webhook endpoint is
# <NEXT_PUBLIC_APP_URL>/api/webhooks/stripe and has to be registered in Stripe
# by hand (docs/deploy.md, "Stripe", lists its events).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_GROWTH_YEARLY=
# Only with billing on. "true" makes Checkout add VAT through Stripe Tax; set it
# only after Stripe Tax is activated and set to exclusive prices
# (docs/deploy.md, "VAT"), or nobody can pay.
STRIPE_TAX_ENABLED=
# Only with billing on. TRIAL_GATE_DISABLED=1 stops asking new accounts for a
# card trial before they reach the dashboard. TRIAL_GATE_BYPASS_EMAILS is a
# comma-separated list of addresses that skip that step (plus-tags included).
TRIAL_GATE_DISABLED=
TRIAL_GATE_BYPASS_EMAILS=
# Only with billing on. PRETRIAL_FULL_ARTICLE=1 lets an account's owner read
# their own first draft in full before the trial starts; unset, its text is
# held until then.
PRETRIAL_FULL_ARTICLE=

# Video embeds in articles. Skipped silently without it.
YOUTUBE_API_KEY=

# Optional model overrides. Defaults live in apps/web/lib/ai/models.ts and are
# current as shipped, so leave these blank unless your key has access to a
# different model set or you want to trade quality for cost.
#   ANTHROPIC_MODEL             article writing                   (default claude-sonnet-5)
#   ANTHROPIC_MODEL_STRUCTURED  short tasks only: meta, clusters,
#                               briefs, SERP summaries            (default ANTHROPIC_MODEL if set,
#                                                                  else claude-haiku-4-5-20251001)
#   ANTHROPIC_MODEL_DECISION    topic decisions: buyer fit,
#                               keyword opportunity, the outline  (default ANTHROPIC_MODEL if set,
#                                                                  else claude-sonnet-5)
#   OPENAI_MODEL                only when a workspace picks OpenAI (default gpt-4o)
#   OPENAI_IMAGE_MODEL          featured images                    (default gpt-image-1-mini)
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_STRUCTURED=
ANTHROPIC_MODEL_DECISION=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=

# Public tools (POST /api/public/tools/<slug>, unauthenticated). The paid ones
# (AI / DataForSEO-backed) share one daily budget in US cents across all
# tools, per UTC day; once it is spent they answer "resting until tomorrow".
# Needs migration 091; without it the paid tools refuse to run (fail closed).
# They spend your own Anthropic and DataForSEO keys on anonymous visitors, so
# with billing off (no STRIPE_SECRET_KEY) the default cap is 0: off until you
# set a budget here. The fetch-only tools are free and ignore both settings.
#   PUBLIC_TOOLS_DAILY_CAP_CENTS  default 0 with billing off, 500 with it on; 0 turns them off
#   PUBLIC_TOOLS_MODEL            default the Haiku id in apps/web/lib/ai/models.ts
PUBLIC_TOOLS_DAILY_CAP_CENTS=
PUBLIC_TOOLS_MODEL=

# Operator accounts, comma-separated. An operator sees the Operations pages:
# cross-account costs, every user, and "View as", which opens the product as
# any account in one click (every use is written to admin_impersonations).
# Operators are also unmetered. Set it to yourself. Unset or empty means
# nobody is an operator (and the daily operations digest goes nowhere).
ADMIN_EMAILS=

# Signs the unsubscribe and Hold links in emails. Optional: unset, the
# service role key signs them. Set it to rotate the two separately.
EMAIL_UNSUBSCRIBE_SECRET=

# Site audits refuse private and local addresses (10.x, 192.168.x, localhost).
# Set to 1 on an install that audits sites on its own private network.
ALTORANK_ALLOW_PRIVATE_FETCH=

NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Product analytics, optional. The two NEXT_PUBLIC_POSTHOG_* variables (the
# PostHog project token and the PostHog host) turn on PostHog in the browser.
# Unset, analytics stay off and `npm run dev` logs one console warning saying
# so. They are read at build time and docker/compose.yml does not pass them, so
# the Docker image never sends analytics.
