# AltoRank configuration.
#
#   cp apps/web/.env.local.example apps/web/.env.local
#
# Grouped by what actually breaks without it. Only the first group is needed to
# start the app; everything below degrades a feature rather than the process.

# ── Required: the app will not work without these ─────────────────────────

# Supabase. Create a project (or run one locally), then Project Settings > API.
# The service role key bypasses RLS and is server-only: never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic. This is the engine: without it nothing is researched or written.
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Encrypts CMS credentials at rest (AES-256-GCM). Throws on startup if unset.
# 64 hex chars is used directly as the key; anything else is SHA-256'd to 32
# bytes. Generate one with:  openssl rand -hex 32
# Changing this makes every stored CMS credential undecryptable.
ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Keyword and SERP data ─────────────────────────────────────────────────
# DataForSEO. Without these, keyword research and rank tracking skip rather
# than fail: the brief step degrades to writing without volume or SERP data.
# Note it is LOGIN and PASSWORD, not a single API key.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Scheduled jobs ────────────────────────────────────────────────────────
# Shared secret for /api/cron/*. Requests without a matching x-cron-secret
# header are rejected, so unset means every cron endpoint returns 401.
#   curl -H "x-cron-secret: $CRON_SECRET" localhost:3000/api/cron/analyze
CRON_SECRET=

# ── Optional: each disables one feature, nothing else ─────────────────────

# Model overrides. Defaults are claude-opus-5 for drafting and
# claude-haiku-4-5-20251001 for structured extraction.
# ANTHROPIC_MODEL=
# ANTHROPIC_MODEL_STRUCTURED=

# Featured images. Without it, articles are generated without images.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_IMAGE_MODEL=gpt-image-1

# Transactional email (invites, reports). Throws only when email is sent.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# PageSpeed Insights, used by the domain audit. Falls back to unkeyed quota.
# PAGESPEED_API_KEY=

# Google Search Console OAuth, for real traffic data on the dashboard.
# Without it the traffic chart stays empty rather than showing invented data.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Video embeds in generated articles. Silently skipped when unset.
# YOUTUBE_API_KEY=

# Billing. Only needed to run the hosted plans yourself; self-hosting does not
# use them. Price ids are the recurring prices for the two paid tiers.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...

# Used only by `npm run dogfood` to provision a real test workspace.
# DOGFOOD_EMAIL=
