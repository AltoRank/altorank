---
/**
 * One small drawn panel per how-it-works step.
 *
 * The step cards were text only. Every card on the category's pages carries a
 * screenshot of the app, and a step a reader can see is a step a reader
 * believes. We do not ship raster screenshots on this site (see AppShot.astro
 * for why), so each panel is drawn from the same tokens the dashboard uses,
 * with the same discipline: every label is a state or a page that exists.
 *
 *   status names            -> apps/web/lib/constants.ts STATUS_META
 *   Approve / Send back     -> apps/web/app/actions/publish.ts (requestChanges)
 *   SEO score 86            -> the same queue row AppShot draws
 *   keywords in the strip   -> real pages on this site (blog + guides)
 *   destination codes       -> data/homepage.ts CMS_LIST
 *
 * Nothing here is a metric. The one number, 86, is a per-article score already
 * on the page above the fold, not traction.
 */
interface Props {
  step: 1 | 2 | 3 | 4;
}

const { step } = Astro.props;

// Five weekdays of a plan, each a keyword this site genuinely has a page for.
const WEEK = [
  { d: 'Mon', k: 'does geo replace seo' },
  { d: 'Tue', k: 'approval-first seo content' },
  { d: 'Wed', k: 'how to rank in chatgpt' },
  { d: 'Thu', k: 'internal linking seo' },
  { d: 'Fri', k: 'collection page seo content' },
];

const DESTINATIONS = ['WP', 'SH', 'WF', 'GH'];
---

<div
  aria-hidden="true"
  class:list={[
    'mb-4 overflow-hidden rounded-[7px] border text-left select-none',
    step === 3 ? 'border-accent/40 bg-bg' : 'border-line bg-panel',
  ]}
>
  {step === 1 && (
    <div class="p-3">
      <div class="flex h-8 items-center gap-2 rounded-[6px] border border-line bg-bg px-2.5">
        <span class="font-mono text-[11px] text-ink-2">altorank.co</span>
        <span class="ml-auto rounded-[4px] bg-ink px-2 py-[3px] text-[10px] font-medium text-white">Add</span>
      </div>
      <ul class="mt-2.5 flex flex-col gap-1.5 text-[11px] text-ink-2">
        <li class="flex items-center gap-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="2.4" class="h-3 w-3 shrink-0"><path d="M5 12.5 10 17 19 7" /></svg>
          Pages crawled
        </li>
        <li class="flex items-center gap-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="2.4" class="h-3 w-3 shrink-0"><path d="M5 12.5 10 17 19 7" /></svg>
          Competitors benchmarked
        </li>
        <li class="flex items-center gap-2">
          <span class="grid h-3 w-3 shrink-0 place-items-center"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span></span>
          Finding gap keywords
        </li>
      </ul>
    </div>
  )}

  {step === 2 && (
    <div class="grid grid-cols-5 divide-x divide-line-soft">
      {WEEK.map((day) => (
        <div class="min-w-0 px-1.5 py-2.5">
          <div class="mb-1.5 text-[9.5px] text-ink-4">{day.d}</div>
          <div class="rounded-[4px] border border-line bg-bg px-1.5 py-1 text-[9.5px] leading-[1.3] text-ink-2 [overflow-wrap:anywhere]">
            {day.k}
          </div>
        </div>
      ))}
    </div>
  )}

  {step === 3 && (
    <div class="p-3">
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <div class="truncate text-[11.5px] font-medium text-ink">Does GEO Replace SEO? (2026 Guide for Agencies)</div>
          <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[10px] text-ink-3">
            <span class="inline-flex items-center gap-1 rounded-full bg-warn-soft px-1.5 py-px font-medium text-warn-ink">
              <span class="h-1.5 w-1.5 rounded-full bg-warn"></span>In review
            </span>
            <span>SEO <span class="font-mono text-ink-2">86</span></span>
            <span>Fact-check <span class="text-ok-ink">passed</span></span>
          </div>
        </div>
      </div>
      <div class="mt-2.5 flex gap-1.5">
        <span class="rounded-[5px] bg-ink px-2.5 py-1 text-[10.5px] font-medium text-white">Approve</span>
        <span class="rounded-[5px] border border-line bg-bg px-2.5 py-1 text-[10.5px] font-medium text-ink-2">Send back</span>
      </div>
    </div>
  )}

  {step === 4 && (
    <div class="p-3">
      <div class="flex items-center gap-1.5">
        {DESTINATIONS.map((code) => (
          <span class="inline-flex h-7 w-7 items-center justify-center rounded border border-line bg-bg font-mono text-[10px] font-medium text-ink-2">{code}</span>
        ))}
        <span class="ml-0.5 font-mono text-[10px] text-ink-4">+7</span>
      </div>
      <div class="mt-2.5 flex items-center justify-between rounded-[6px] border border-line bg-bg px-2.5 py-1.5">
        <span class="truncate text-[10.5px] text-ink-2">/geo/does-geo-replace-seo</span>
        <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-ok-soft px-1.5 py-px text-[10px] font-medium text-ok-ink">
          <span class="h-1.5 w-1.5 rounded-full bg-ok"></span>Published
        </span>
      </div>
    </div>
  )}
</div>
