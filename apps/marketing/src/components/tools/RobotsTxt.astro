---
import ToolShell from './ToolShell.astro';
import Button from '@/components/shared/Button.astro';
const field = 'min-h-11 w-full rounded-[9px] border border-line bg-bg px-3.5 py-2.5 text-[14.5px] text-ink placeholder:text-ink-3 focus:border-accent focus:outline-none focus:ring-[3px] focus:ring-accent-soft';
const area = 'w-full rounded-[9px] border border-line bg-bg px-3.5 py-2.5 text-[14.5px] text-ink placeholder:text-ink-3 focus:border-accent focus:outline-none focus:ring-[3px] focus:ring-accent-soft';
---
<ToolShell label="robots.txt generator">
  <div class="grid gap-4 md:grid-cols-[1fr_1.1fr]">
    <div class="flex flex-col gap-3">
      <div>
        <label class="mb-1.5 block text-[13px] font-medium text-ink-2" for="rb-sitemap">Sitemap URL</label>
        <input id="rb-sitemap" class={field} value="https://example.com/sitemap.xml" />
      </div>
      <div>
        <label class="mb-1.5 block text-[13px] font-medium text-ink-2" for="rb-disallow">Disallow paths (one per line)</label>
        <textarea id="rb-disallow" rows="3" class={area}>/cart
/checkout
/search</textarea>
      </div>
      <div>
        <label class="mb-1.5 block text-[13px] font-medium text-ink-2" for="rb-allow">Allow exceptions inside a blocked path (one per line)</label>
        <textarea id="rb-allow" rows="2" class={area} placeholder="/search/help"></textarea>
      </div>
      <fieldset>
        <legend class="mb-1.5 block text-[13px] font-medium text-ink-2">AI crawlers</legend>
        <div class="flex flex-col gap-1 rounded-lg border border-line bg-bg px-3.5 py-1.5">
          <label class="flex min-h-11 items-center gap-2 text-[13.5px] text-ink-2">
            <input type="radio" name="rb-ai" value="allow" checked class="h-4 w-4" /> Allow them (be citable)
          </label>
          <label class="flex min-h-11 items-center gap-2 text-[13.5px] text-ink-2">
            <input type="radio" name="rb-ai" value="block" class="h-4 w-4" /> Block them
          </label>
          <label class="flex min-h-11 items-center gap-2 text-[13.5px] text-ink-2">
            <input type="radio" name="rb-ai" value="split" class="h-4 w-4" /> Allow search, block training
          </label>
        </div>
      </fieldset>
    </div>
    <div>
      <div class="mb-2 flex items-center justify-between gap-3">
        <p class="text-[13px] font-medium text-ink-2">robots.txt</p>
        <Button variant="secondary" size="sm" data-rb="copy">Copy</Button>
      </div>
      <p class="mb-2 hidden rounded-md border border-[oklch(0.85_0.08_75)] bg-[oklch(0.97_0.03_75)] px-3 py-2 text-[12.5px] text-[oklch(0.4_0.1_75)]" data-rb="warn"></p>
      <pre class="max-h-[420px] overflow-auto rounded-lg border border-line bg-bg p-4 font-mono text-[12.5px] leading-relaxed text-ink whitespace-pre-wrap" data-rb="out"></pre>
    </div>
  </div>
  <p class="mt-3 text-[12.5px] leading-relaxed text-ink-3">
    Blocking an AI crawler removes you from the answers it generates. That is a legitimate choice, but it
    is a choice: a page no assistant may read cannot be a page any assistant cites. robots.txt is a request,
    not a lock; anything private needs authentication, not a Disallow line.
  </p>
</ToolShell>

<script>
  // The bot lists are split by what the crawler is FOR, because conflating
  // them is the common mistake. GPTBot and ClaudeBot fetch for training;
  // OAI-SearchBot, ChatGPT-User and Claude-User fetch to answer a live
  // question. Blocking the second group is what removes you from answers.
  function initRobots() {
    const sm = document.getElementById('rb-sitemap') as HTMLInputElement | null;
    const dis = document.getElementById('rb-disallow') as HTMLTextAreaElement | null;
    const al = document.getElementById('rb-allow') as HTMLTextAreaElement | null;
    const out = document.querySelector('[data-rb="out"]');
    const warn = document.querySelector('[data-rb="warn"]') as HTMLElement | null;
    const copy = document.querySelector('[data-rb="copy"]') as HTMLButtonElement | null;
    if (!sm || !dis || !al || !out || !warn) return;
    const TRAIN = ['GPTBot', 'ClaudeBot', 'Google-Extended', 'CCBot', 'anthropic-ai', 'Applebot-Extended', 'Bytespider', 'meta-externalagent'];
    const SEARCH = ['OAI-SearchBot', 'ChatGPT-User', 'Claude-User', 'Claude-SearchBot', 'PerplexityBot', 'Perplexity-User'];
    const paths = (el: HTMLTextAreaElement) => el.value.split('\n').map((s) => s.trim()).filter(Boolean);
    const render = () => {
      const mode = (document.querySelector('input[name="rb-ai"]:checked') as HTMLInputElement | null)?.value ?? 'allow';
      const dPaths = paths(dis), aPaths = paths(al);
      const problems: string[] = [];
      [...dPaths, ...aPaths].forEach((p) => { if (!p.startsWith('/') && p !== '*') problems.push(`"${p}" should start with a slash`); });
      if (dPaths.includes('/')) problems.push('Disallow: / blocks the whole site for every crawler');
      if (sm.value.trim() && !/^https?:\/\/\S+$/.test(sm.value.trim())) problems.push('the sitemap must be an absolute URL');
      const lines: string[] = ['User-agent: *'];
      dPaths.forEach((p) => lines.push(`Disallow: ${p}`));
      aPaths.forEach((p) => lines.push(`Allow: ${p}`));
      if (!dPaths.length) lines.push('Disallow:');
      const group = (names: string[], rule: string) => names.forEach((n) => lines.push('', `User-agent: ${n}`, rule));
      if (mode === 'allow') { lines.push('', '# AI crawlers: allowed, so this site can be read and cited'); group([...SEARCH, ...TRAIN], 'Allow: /'); }
      if (mode === 'block') { lines.push('', '# AI crawlers: blocked'); group([...SEARCH, ...TRAIN], 'Disallow: /'); }
      if (mode === 'split') {
        lines.push('', '# Answer engines: allowed, so this site can be cited');
        group(SEARCH, 'Allow: /');
        lines.push('', '# Training crawlers: blocked');
        group(TRAIN, 'Disallow: /');
      }
      if (sm.value.trim()) lines.push('', `Sitemap: ${sm.value.trim()}`);
      out.textContent = lines.join('\n');
      warn.textContent = problems.length ? 'Check: ' + problems.join('; ') + '.' : '';
      warn.classList.toggle('hidden', !problems.length);
    };
    [sm, dis, al].forEach((el) => el.addEventListener('input', render));
    document.querySelectorAll('input[name="rb-ai"]').forEach((el) => el.addEventListener('change', render));
    copy?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(out.textContent ?? ''); copy.textContent = 'Copied'; setTimeout(() => { copy.textContent = 'Copy'; }, 1400); } catch { copy.textContent = 'Select and copy'; }
    });
    render();
  }
  initRobots();
  document.addEventListener('astro:page-load', initRobots);
</script>
