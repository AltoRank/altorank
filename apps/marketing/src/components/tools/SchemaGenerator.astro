---
import ToolShell from './ToolShell.astro';
import Button from '@/components/shared/Button.astro';
const field = 'min-h-11 w-full rounded-[9px] border border-line bg-bg px-3.5 py-2.5 text-[14.5px] text-ink placeholder:text-ink-3 focus:border-accent focus:outline-none focus:ring-[3px] focus:ring-accent-soft';
const area = 'w-full rounded-[9px] border border-line bg-bg px-3.5 py-2.5 text-[14.5px] text-ink placeholder:text-ink-3 focus:border-accent focus:outline-none focus:ring-[3px] focus:ring-accent-soft';
const lbl = 'mb-1.5 block text-[13px] font-medium text-ink-2';
---
<ToolShell label="JSON-LD schema generator">
  <div class="grid gap-4 md:grid-cols-[1fr_1.1fr]">
    <div class="flex flex-col gap-3">
      <div>
        <label class={lbl} for="sg-type">Type</label>
        <select id="sg-type" class={field}>
          <option value="FAQPage">FAQPage</option>
          <option value="Article">Article</option>
          <option value="HowTo">HowTo</option>
          <option value="BreadcrumbList">BreadcrumbList</option>
          <option value="Organization">Organization</option>
        </select>
      </div>
      <div data-sg="f-article" hidden>
        <label class={lbl} for="sg-headline">Headline</label>
        <input id="sg-headline" class={field} value="How to write a meta description" />
        <label class={`${lbl} mt-3`} for="sg-author">Author</label>
        <input id="sg-author" class={field} value="Jane Doe" />
        <label class={`${lbl} mt-3`} for="sg-url">URL</label>
        <input id="sg-url" class={field} value="https://example.com/blog/meta-descriptions" />
        <label class={`${lbl} mt-3`} for="sg-date">Date published</label>
        <input id="sg-date" type="date" class={field} value="2026-09-04" />
        <label class={`${lbl} mt-3`} for="sg-modified">Date modified (leave blank if never revised)</label>
        <input id="sg-modified" type="date" class={field} value="" />
      </div>
      <div data-sg="f-faq">
        <label class={lbl} for="sg-faq">One question and answer per line, separated by a pipe</label>
        <textarea id="sg-faq" rows="5" class={area}>What is a meta description?|The short summary in a page's head that search engines may show under the title.
Is it a ranking factor?|No. It affects click-through rate, not ranking.</textarea>
      </div>
      <div data-sg="f-howto" hidden>
        <label class={lbl} for="sg-howto-name">What the guide teaches</label>
        <input id="sg-howto-name" class={field} value="How to write a meta description" />
        <label class={`${lbl} mt-3`} for="sg-howto">One step per line: step name|what to do</label>
        <textarea id="sg-howto" rows="5" class={area}>Find the ranking query|Check Search Console for the query the page already ranks for.
Answer it in the first clause|Lead with the answer, not the brand.
Check the width|Keep it under about 960 pixels on desktop.</textarea>
      </div>
      <div data-sg="f-crumbs" hidden>
        <label class={lbl} for="sg-crumbs">One crumb per line: label|url</label>
        <textarea id="sg-crumbs" rows="4" class={area}>Home|https://example.com/
Blog|https://example.com/blog/
Meta descriptions|https://example.com/blog/meta-descriptions</textarea>
      </div>
      <div data-sg="f-org" hidden>
        <label class={lbl} for="sg-org-name">Organisation name</label>
        <input id="sg-org-name" class={field} value="Example Ltd" />
        <label class={`${lbl} mt-3`} for="sg-org-url">Website</label>
        <input id="sg-org-url" class={field} value="https://example.com" />
        <label class={`${lbl} mt-3`} for="sg-org-logo">Logo URL</label>
        <input id="sg-org-logo" class={field} value="https://example.com/logo.png" />
        <label class={`${lbl} mt-3`} for="sg-org-same">Profile URLs, one per line (LinkedIn, GitHub, Wikidata…)</label>
        <textarea id="sg-org-same" rows="3" class={area}>https://www.linkedin.com/company/example</textarea>
      </div>
    </div>
    <div>
      <div class="mb-2 flex items-center justify-between gap-3">
        <p class="text-[13px] font-medium text-ink-2">Paste into your &lt;head&gt;</p>
        <Button variant="secondary" size="sm" data-sg="copy">Copy</Button>
      </div>
      <p class="mb-2 hidden rounded-md border border-[oklch(0.85_0.08_75)] bg-[oklch(0.97_0.03_75)] px-3 py-2 text-[12.5px] text-[oklch(0.4_0.1_75)]" data-sg="warn"></p>
      <pre class="max-h-[420px] overflow-auto rounded-lg border border-line bg-bg p-4 font-mono text-[12.5px] leading-relaxed text-ink whitespace-pre-wrap" data-sg="out"></pre>
    </div>
  </div>
  <p class="mt-3 text-[12.5px] leading-relaxed text-ink-3">
    Schema describes what a page already says. It cannot add authority a page has not earned, and marking
    up a claim the page does not make is the one use of structured data that reliably backfires.
  </p>
</ToolShell>

<script>
  function initSchemaGen() {
    const type = document.getElementById('sg-type') as HTMLSelectElement | null;
    const out = document.querySelector('[data-sg="out"]');
    const warn = document.querySelector('[data-sg="warn"]') as HTMLElement | null;
    if (!type || !out || !warn) return;
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value?.trim() ?? '';
    const show = (k: string, on: boolean) => {
      const el = document.querySelector(`[data-sg="f-${k}"]`) as HTMLElement | null;
      if (el) el.hidden = !on;
    };
    const pairs = (id: string) => val(id).split('\n').map((l) => l.split('|')).filter((p) => p.length >= 2 && p[0].trim() && p[1].trim()).map(([a, b]) => [a.trim(), b.trim()] as const);
    const isUrl = (s: string) => /^https?:\/\/\S+$/.test(s);
    const render = () => {
      const t = type.value;
      ['article', 'faq', 'howto', 'crumbs', 'org'].forEach((k) => show(k, false));
      const problems: string[] = [];
      let obj: Record<string, unknown> = { '@context': 'https://schema.org', '@type': t };
      if (t === 'Article') {
        show('article', true);
        if (!val('sg-headline')) problems.push('headline is empty');
        if (!val('sg-author')) problems.push('author is empty');
        if (!isUrl(val('sg-url'))) problems.push('URL should be absolute (https://…)');
        if (val('sg-modified') && val('sg-modified') < val('sg-date')) problems.push('modified date is before the publish date');
        obj = { ...obj, headline: val('sg-headline'), author: { '@type': 'Person', name: val('sg-author') }, mainEntityOfPage: val('sg-url'), datePublished: val('sg-date'), ...(val('sg-modified') ? { dateModified: val('sg-modified') } : {}) };
      } else if (t === 'FAQPage') {
        show('faq', true);
        const qa = pairs('sg-faq');
        if (!qa.length) problems.push('no complete question|answer pairs yet');
        const rawLines = val('sg-faq').split('\n').filter((l) => l.trim()).length;
        if (rawLines > qa.length) problems.push(`${rawLines - qa.length} line${rawLines - qa.length === 1 ? '' : 's'} skipped: each needs a pipe between question and answer`);
        obj.mainEntity = qa.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }));
      } else if (t === 'HowTo') {
        show('howto', true);
        const steps = pairs('sg-howto');
        if (!val('sg-howto-name')) problems.push('name is empty');
        if (steps.length < 2) problems.push('a HowTo needs at least two steps');
        obj = { ...obj, name: val('sg-howto-name'), step: steps.map(([name, text], i) => ({ '@type': 'HowToStep', position: i + 1, name, text })) };
      } else if (t === 'BreadcrumbList') {
        show('crumbs', true);
        const crumbs = pairs('sg-crumbs');
        if (crumbs.length < 2) problems.push('a breadcrumb trail needs at least two crumbs');
        crumbs.forEach(([, u]) => { if (!isUrl(u)) problems.push(`"${u}" is not an absolute URL`); });
        obj.itemListElement = crumbs.map(([name, item], i) => ({ '@type': 'ListItem', position: i + 1, name, item }));
      } else {
        show('org', true);
        if (!val('sg-org-name')) problems.push('name is empty');
        if (!isUrl(val('sg-org-url'))) problems.push('website should be absolute (https://…)');
        const same = val('sg-org-same').split('\n').map((s) => s.trim()).filter(Boolean);
        obj = { ...obj, name: val('sg-org-name'), url: val('sg-org-url'), ...(val('sg-org-logo') ? { logo: val('sg-org-logo') } : {}), ...(same.length ? { sameAs: same } : {}) };
      }
      out.textContent = '<script type="application/ld+json">\n' + JSON.stringify(obj, null, 2) + '\n<\/script>';
      warn.textContent = problems.length ? 'Check: ' + problems.join('; ') + '.' : '';
      warn.classList.toggle('hidden', !problems.length);
    };
    document.querySelectorAll('#sg-type, [data-sg^="f-"] input, [data-sg^="f-"] textarea').forEach((el) => {
      el.addEventListener('input', render); el.addEventListener('change', render);
    });
    const copy = document.querySelector('[data-sg="copy"]') as HTMLButtonElement | null;
    copy?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(out.textContent ?? ''); copy.textContent = 'Copied'; setTimeout(() => { copy.textContent = 'Copy'; }, 1400); } catch { copy.textContent = 'Select and copy'; }
    });
    render();
  }
  initSchemaGen();
  document.addEventListener('astro:page-load', initSchemaGen);
</script>
