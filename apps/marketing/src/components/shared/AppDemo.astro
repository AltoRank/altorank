---
/**
 * The hero product video. Default is the kinetic launch cut rendered from
 * altorank-video/launch (HyperFrames): text beats alternating with tilted
 * recordings of the real dashboard, the competitors-on-autopilot beat, the
 * CMS orbit, and the one number we have earned (274 sites scanned). Pass
 * src="hero-demo" chrome aspect="8 / 5" for the plain screen recording made
 * by altorank-video/scripts/record-hero.mjs.
 *
 * Neither cut shows the dashboard traffic curve, for the same reason AppShot
 * renders organic traffic as an em dash: nothing on this page draws a number
 * we have not measured.
 *
 * Phones keep AppShot. A 1040px recording at 375px wide is a blur, and the
 * app collapses its sidebar there anyway.
 */
interface Props {
  /** Basename under /demo/, without extension. */
  src?: string;
  url?: string;
  /** Draw the browser chrome. Off for the kinetic launch cut, which is not a screen recording. */
  chrome?: boolean;
  /** CSS aspect-ratio of the take. */
  aspect?: string;
}
const { src = 'hero-launch', url = 'app.altorank.co', chrome = false, aspect = '16 / 9' } = Astro.props;
---

{/* Cropped by the fold on purpose, like AppShot: no bottom border, the next
    section overlaps it. */}
<div
  class="mx-auto hidden max-w-[880px] overflow-hidden rounded-t-lg border border-b-0 border-[oklch(1_0_0/0.14)] bg-[#07070d] text-left shadow-[0_-1px_0_oklch(1_0_0/0.10),0_-24px_60px_-30px_oklch(0.62_0.16_275/0.45)] sm:rounded-t-xl md:block"
>
  {chrome && (
    <div class="flex h-[32px] items-center gap-1.5 border-b border-line bg-panel px-3">
      <span class="h-[8px] w-[8px] rounded-full bg-line"></span>
      <span class="h-[8px] w-[8px] rounded-full bg-line"></span>
      <span class="h-[8px] w-[8px] rounded-full bg-line"></span>
      <span class="mx-auto rounded border border-line bg-bg px-2.5 py-[2px] font-mono text-[11px] text-ink-3">
        {url}
      </span>
    </div>
  )}

  {/* The aspect box holds the fold steady before the first frame. */}
  <video
    id="hero-demo"
    class="block w-full bg-[#07070d]"
    style={`aspect-ratio: ${aspect}`}
    muted
    loop
    playsinline
    preload="none"
    poster={`/demo/${src}.jpg`}
    aria-label="AltoRank in one minute: pick a keyword, get a month of articles planned, approve each one, publish to eleven CMSs."
  >
    <source src={`/demo/${src}.webm`} type="video/webm" />
    <source src={`/demo/${src}.mp4`} type="video/mp4" />
  </video>
</div>

<script>
  // No `autoplay` attribute: that would download the take on phones too, where
  // the frame is display:none and AppShot stands in. Play only where it shows,
  // and hold the poster for anyone who asked for reduced motion.
  const v = document.getElementById('hero-demo') as HTMLVideoElement | null;
  const shows = matchMedia('(min-width: 768px)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (v && shows && !still) {
    v.preload = 'auto';
    v.play().catch(() => {});
  }
</script>
