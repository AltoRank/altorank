---
import Marketing from '@/layouts/Marketing.astro';
import Button from '@/components/shared/Button.astro';
import AppShot from '@/components/shared/AppShot.astro';
import { APP_NAME, PRIMARY_CTA, APP_URL, SIGNUP_URL, SITE_URL } from '@/constants';
import { buildProductSchema } from '@/lib/schema';
import {
  STEPS_IT,
  COMPARISON_IT,
  COMPARISON_LEGACY_HEADER_IT,
  OSS_BULLETS_IT,
  COMPARISON_THEM,
  CMS_LIST,
  LOCALE_COUNT,
  READINESS_SCAN,
} from '@/data/homepage-it';

// Italian mirror of /. Hand-translated, same pattern as /it/agency-blueprint
// and /de/alternatives/*: no i18n runtime, full page copy per locale.
//
// Why this page exists: the Italian UGC videos all point at altorank.co, and
// until now /it was a 404, so every Italian viewer landed on English copy.
//
// Numbers, rows and claims are identical to the English homepage by
// construction: homepage-it.ts re-exports CMS_LIST, LOCALE_COUNT,
// READINESS_SCAN and COMPARISON_THEM from homepage.ts rather than restating
// them, so an evidenced number cannot drift between locales. Only prose is
// translated. Keep the two pages in sync whenever a claim changes.
//
// The growth-plan form posts to the same cross-origin endpoint with the same
// contract as the English page; only the strings the visitor reads differ.
// Unlike the English page, the results here are built with DOM methods rather
// than innerHTML, so no response field can be interpreted as markup.
const structuredData = [buildProductSchema()];

const alternateLanguages = [
  { hreflang: 'en', href: SITE_URL },
  { hreflang: 'it', href: `${SITE_URL}/it` },
  { hreflang: 'x-default', href: SITE_URL },
];
---

<Marketing
  title="AltoRank | Il motore SEO open source con AI"
  description="Articoli che si posizionano, pubblicati sul tuo sito ogni settimana. Piano di crescita gratuito per qualsiasi dominio in 60 secondi. Ricerca parole chiave, bozze nella tua voce, pubblicazione su undici CMS. Open source, self-host gratis."
  canonicalUrl={`${SITE_URL}/it`}
  lang="it"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
  headerOverlay
>
  {/* ── HERO ───────────────────────────────────────────────────────────── */}
  <header class="relative overflow-hidden border-b border-line bg-[radial-gradient(760px_400px_at_50%_-14%,oklch(0.46_0.17_275/0.85),transparent_68%),linear-gradient(178deg,oklch(0.24_0.09_275),oklch(0.155_0.02_275)_62%)] -mt-14 px-5 pt-[112px] text-center sm:px-6 lg:-mt-16 lg:pt-[148px]">
    <div class="mx-auto max-w-[1240px]">
      <h1 class="mx-auto mb-4 max-w-[19ch] text-[clamp(30px,7vw,52px)] font-medium leading-[1.12] tracking-[-0.028em] text-white [text-wrap:balance] sm:mb-5">
        Articoli che si posizionano, pubblicati sul tuo sito ogni settimana.
      </h1>

      <p class="mx-auto mb-7 max-w-[52ch] text-[15.5px] leading-relaxed text-[oklch(0.82_0.03_275)] [text-wrap:pretty] sm:text-[17px] md:mb-8">
        Punti un dominio lunedì. Primo articolo online entro venerdì. Ricerca
        delle parole chiave, bozze nella tua voce, pubblicazione su undici CMS.
        Open source, self-host gratis.
      </p>

      <form
        id="growth-plan-form"
        class="mx-auto flex max-w-[560px] flex-col gap-2.5 sm:flex-row"
        data-api={`${APP_URL}/api/growth-plan`}
        data-lead={`${APP_URL}/api/growth-plan/lead`}
        data-signup={SIGNUP_URL}
        novalidate
      >
        <label for="growth-plan-domain" class="sr-only">Il tuo dominio</label>
        <input
          id="growth-plan-domain"
          name="domain"
          type="text"
          inputmode="url"
          autocomplete="url"
          spellcheck="false"
          required
          placeholder="iltuosito.it"
          class="h-12 flex-1 rounded-[9px] border border-white/15 bg-white/[0.07] px-4 text-[15px] text-white placeholder:text-[oklch(0.68_0.03_275)] focus:border-white/40 focus:outline-none focus:ring-[3px] focus:ring-white/10"
        />
        <button
          type="submit"
          class="inline-flex h-12 shrink-0 cursor-pointer items-center justify-center gap-1.5 rounded-[9px] bg-white px-5 text-[15px] font-medium text-[oklch(0.2_0.06_275)] transition-colors hover:bg-[oklch(0.94_0.01_275)] disabled:cursor-wait disabled:opacity-70"
        >
          <span data-label>Ricevi il piano di crescita</span>
        </button>
      </form>

      <p class="mb-9 mt-4 text-[12.5px] text-[oklch(0.68_0.03_275)] sm:text-[13px] md:mb-12">
        Gratis. Circa 60 secondi. Senza registrazione. Oppure <a href={PRIMARY_CTA.href} class="underline decoration-white/30 underline-offset-[3px] hover:decoration-white">aggiungi il tuo dominio</a> e fai self-hosting gratis.
      </p>

      <section
        id="growth-plan"
        hidden
        aria-live="polite"
        class="mx-auto mb-10 max-w-[1040px] text-left md:mb-14"
      ></section>

      <AppShot />
    </div>
  </header>

  <div data-header-overlay-end aria-hidden="true" class="h-px -mb-px"></div>

  {/* ── CONFRONTO ──────────────────────────────────────────────────────── */}
  <section id="vs" class="border-b border-line py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <h2 class="mb-3 max-w-[22ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Stesso lavoro dei tool in autopilot. Risposta opposta su chi preme pubblica.
      </h2>
      <p class="mb-8 max-w-[58ch] md:mb-11 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
        Outrank, Distribb e BabyLoveGrowth aprono tutti con la parola
        &ldquo;autopilot&rdquo;. Ogni riga qui sotto è verificabile sulle loro
        homepage.
      </p>

      <ul class="flex flex-col gap-3 md:hidden">
        {COMPARISON_IT.map((row) => (
          <li class="rounded-lg border border-line bg-bg p-4">
            <div class="text-[14px] font-semibold tracking-[-0.01em] text-ink">{row.label}</div>
            <dl class="mt-3 flex flex-col gap-2.5">
              <div class="flex flex-col gap-0.5">
                <dt class="text-[12px] text-ink-3">{COMPARISON_THEM}</dt>
                <dd class="ml-0 text-[14px] text-ink-3">{row.legacy}</dd>
              </div>
              <div class="flex flex-col gap-0.5 border-t border-line-soft pt-2.5">
                <dt class="text-[12px] text-accent-ink">{APP_NAME}</dt>
                <dd class="ml-0 text-[14px] font-medium text-ink">{row.ours}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>

      <table class="hidden w-full border-collapse text-left md:table">
        <thead>
          <tr>
            <th class="w-[30%] border-b border-ink pb-3 text-[13.5px] font-medium text-ink-3">
              <span class="sr-only">Voce</span>
            </th>
            <th class="w-[35%] border-b border-ink pb-3 text-[14px] font-medium text-ink-3">
              {COMPARISON_LEGACY_HEADER_IT}
            </th>
            <th class="w-[35%] border-b border-ink pb-3 text-[14px] font-semibold tracking-[-0.01em] text-ink">
              {APP_NAME}
            </th>
          </tr>
        </thead>
        <tbody>
          {COMPARISON_IT.map((row) => (
            <tr>
              <td class="border-b border-line-soft py-3.5 pr-6 align-top text-[14px] text-ink-2">{row.label}</td>
              <td class="border-b border-line-soft py-3.5 pr-6 align-top text-[14px] text-ink-3">{row.legacy}</td>
              <td class="border-b border-line-soft py-3.5 align-top text-[14px] font-medium text-ink">{row.ours}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {/* ── OPEN SOURCE ────────────────────────────────────────────────────── */}
  <section class="border-b border-line bg-panel py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <div class="grid items-start gap-10 lg:gap-12 lg:grid-cols-[1.15fr_1fr]">
        <div>
          <h2 class="mb-4 max-w-[22ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
            Eseguilo tu, mettici il tuo brand, tieniti il margine.
          </h2>
          <p class="mb-6 max-w-[56ch] md:mb-7 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
            {APP_NAME} diventa open source con tutto il prodotto in chiaro:
            workspace multi-cliente, report white-label e il gate di
            approvazione stanno nella build self-hosted gratuita, non dietro un
            piano a pagamento. Ottieni tutto il livello di esecuzione senza una
            trattativa sulla licenza. Noi veniamo pagati quando preferisci non
            gestirlo da solo.
          </p>
          <Button href="/open-source" variant="secondary" arrow>
            Cosa significa open source per te
          </Button>
        </div>

        <div class="overflow-hidden rounded-lg border border-line bg-bg">
          <ul>
            {OSS_BULLETS_IT.map((item, i) => (
              <li
                class={`flex items-center gap-3 px-5 py-3.5 text-[14px] text-ink-2 ${
                  i > 0 ? 'border-t border-line-soft' : ''
                }`}
              >
                <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="2.2">
                  <path d="M5 12.5 10 17 19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <p class="border-t border-line px-5 py-4 text-[13px] leading-relaxed text-ink-3">
            Nessuna directory <code class="rounded bg-panel-2 px-1 py-0.5 font-mono text-[0.85em]">ee/</code>.
            Nessun piano a pagamento tenuto fuori dal sorgente.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── COME FUNZIONA ──────────────────────────────────────────────────── */}
  <section id="how-it-works" class="border-b border-line py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <h2 class="mb-3 max-w-[20ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Cinque giorni lavorativi dal dominio al primo articolo pubblicato.
      </h2>
      <p class="mb-8 max-w-[58ch] md:mb-11 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
        Dieci minuti di setup: il dominio, tre contenuti già pubblicati per
        imparare la tua voce, e il collegamento al CMS. Dopodiché va avanti da
        solo, e si ferma alla tua inbox.
      </p>

      <div class="grid overflow-hidden rounded-lg border border-line bg-bg md:grid-cols-2 lg:grid-cols-4">
        {STEPS_IT.map((step, i) => (
          <div class={`p-5 sm:p-6 ${i < STEPS_IT.length - 1 ? 'border-b border-line md:border-b-0 md:border-r' : ''}`}>
            <h3 class="mb-2.5 text-[17px] font-semibold tracking-[-0.015em]">
              <span class="mr-1 font-medium tabular-nums text-ink-3">{step.n}.</span>
              {step.title}
            </h3>
            <p class="text-sm leading-relaxed text-ink-2">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── LEGGIBILITÀ PER GLI ASSISTENTI AI ──────────────────────────────── */}
  <section class="border-b border-line bg-panel py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <div class="grid items-start gap-10 lg:gap-12 lg:grid-cols-[1.15fr_1fr]">
        <div>
          <h2 class="mb-4 max-w-[20ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
            La maggior parte dei siti è invisibile agli assistenti AI.
          </h2>
          <p class="mb-5 max-w-[56ch] text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
            Abbiamo analizzato {READINESS_SCAN.sites} siti di agenzie con nove
            controlli che decidono se un assistente riesce a leggere un sito:
            regole per i crawler, dati strutturati, un’entità risolvibile, una
            copia leggibile a macchina di ogni pagina. L’{READINESS_SCAN.failedEverything}%
            non ne aveva superato nemmeno uno. I siti di agenzie sono la
            popolazione che abbiamo misurato; nulla suggerisce che il resto del
            web faccia meglio.
          </p>
          <p class="mb-6 max-w-[56ch] md:mb-7 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
            {APP_NAME} esegue quei nove controlli su qualsiasi dominio aggiungi,
            poi genera le correzioni invece di consegnarti una lista.
          </p>
          <Button href="/geo/track-ai-citations-for-clients" variant="secondary" arrow>
            Leggi la metodologia
          </Button>
        </div>

        <div class="rounded-lg border border-line bg-bg p-5 sm:p-6">
          <div class="flex items-baseline gap-3">
            <span class="text-[56px] font-semibold leading-none tracking-[-0.035em] tabular-nums text-ink">
              {READINESS_SCAN.failedEverything}%
            </span>
            <span class="text-[15px] leading-snug text-ink-2">
              non ha superato nessun controllo
            </span>
          </div>
          <p class="mt-4 border-t border-line-soft pt-4 text-[13.5px] leading-relaxed text-ink-3">
            {READINESS_SCAN.sites} siti di agenzie, analizzati ad agosto 2026.
            Nove controlli, eseguiti dallo stesso codice che gira sui domini dei
            clienti.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── COSA FA ────────────────────────────────────────────────────────── */}
  <section id="features" class="border-b border-line py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <h2 class="mb-8 max-w-[24ch] md:mb-11 text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Costruito per essere letto, non solo eseguito.
      </h2>

      <div class="grid gap-4 md:grid-cols-3">
        <div class="flex flex-col rounded-lg border border-line bg-bg p-5 sm:p-6">
          <h3 class="mb-3 text-[19px] font-semibold leading-snug tracking-[-0.018em] [text-wrap:balance]">
            Scrive nella tua voce, non in quella di un modello
          </h3>
          <p class="text-[14.5px] leading-relaxed text-ink-2">
            Carichi da tre a cinque contenuti già pubblicati. {APP_NAME} estrae
            tono, ritmo, vocabolario e le frasi che ti rifiuti di usare, dentro
            un profilo di voce con cui viene scritta ogni bozza. Un profilo per
            workspace, così un secondo sito non eredita mai la voce del primo.
          </p>
        </div>

        <div class="flex flex-col rounded-lg border border-line bg-bg p-5 sm:p-6">
          <h3 class="mb-3 text-[19px] font-semibold leading-snug tracking-[-0.018em] [text-wrap:balance]">
            Niente viene pubblicato senza revisione
          </h3>
          <p class="text-[14.5px] leading-relaxed text-ink-2">
            Non è un’impostazione che lasci disattivata, è un’assenza. Il server
            MCP non espone nessuno strumento di pubblicazione, e <code class="rounded bg-panel-2 px-1 py-0.5 font-mono text-[0.85em]">auto_generate</code>
            non ha una controparte che pubblichi. Una macchina sceglie
            l’argomento e scrive la bozza. Una persona decide che esce.
          </p>
          <a
            href="/approval-first-seo-content"
            class="mt-4 inline-flex items-center gap-1.5 text-[13.5px] font-medium text-accent-ink underline decoration-line decoration-1 underline-offset-[3px] transition-colors hover:decoration-current"
          >
            Perché il gate è il prodotto
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="flex flex-col rounded-lg border border-line bg-bg p-5 sm:p-6">
          <h3 class="mb-3 text-[19px] font-semibold leading-snug tracking-[-0.018em] [text-wrap:balance]">
            Pubblica dove sei già
          </h3>
          <p class="mb-5 text-[14.5px] leading-relaxed text-ink-2">
            Undici destinazioni che puoi collegare oggi, più {LOCALE_COUNT}
            lingue se non vendi in inglese.
          </p>
          <div class="mt-auto flex flex-wrap gap-1.5">
            {CMS_LIST.map((cms) => (
              <span
                class:list={[
                  'rounded-md border px-2.5 py-1 text-[12px]',
                  cms.soon ? 'border-dashed border-line bg-transparent text-ink-3' : 'border-line bg-panel text-ink-2',
                ]}
              >
                {cms.name}
                {cms.soon && <span class="ml-1.5 text-[10.5px] uppercase tracking-[0.04em]">Presto</span>}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── CTA ──────────────────────────────────────────────────────────────
      Inlined rather than reusing CTABanner.astro, which is English-only.     */}
  <section data-print-hide class="border-b border-line bg-[radial-gradient(500px_260px_at_50%_0%,var(--accent-soft),transparent_70%),var(--bg)] py-14 text-center md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <h2 class="mb-4 text-[clamp(26px,5.2vw,42px)] font-semibold leading-[1.08] tracking-[-0.026em] [text-wrap:balance]">
        Leggi il sorgente prima di affidargli il tuo sito.
      </h2>
      <p class="mx-auto mb-7 max-w-[52ch] text-[15.5px] leading-relaxed text-ink-2 [text-wrap:pretty] sm:text-[16.5px]">
        Fai self-hosting gratis e gestiscilo tu, oppure lascialo ospitare a noi.
        In entrambi i casi niente va online sul tuo sito finché non lo dici tu.
      </p>
      <div class="flex flex-col items-stretch gap-2.5 sm:inline-flex sm:flex-row sm:flex-wrap sm:justify-center">
        <Button href={PRIMARY_CTA.href} size="lg" block arrow>
          Aggiungi il tuo dominio
        </Button>
        <Button href="/open-source" variant="secondary" size="lg" block>
          Fai self-hosting gratis
        </Button>
      </div>
      <p class="mt-4 text-[13px] text-ink-3">Aggiungi un dominio. Iniziare è gratis.</p>
    </div>
  </section>
</Marketing>

<script>
  // Same growth-plan hook as the English homepage: same endpoints, same
  // response contract, Italian strings. The results are assembled with DOM
  // methods and textContent rather than innerHTML, so nothing the API returns
  // can be parsed as markup.
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('growth-plan-form') as HTMLFormElement | null;
    const out = document.getElementById('growth-plan');
    if (!form || !out) return;

    const endpoints = () => ({ api: form.dataset.api!, leadApi: form.dataset.lead!, signup: form.dataset.signup! });
    const input = form.querySelector<HTMLInputElement>('input[name=domain]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = button.querySelector<HTMLElement>('[data-label]')!;

    /** Create an element; text always goes in via textContent. */
    const el = (tag: string, cls?: string, text?: unknown) => {
      const node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text !== undefined && text !== null) node.textContent = String(text);
      return node;
    };
    const clear = (node: HTMLElement) => { while (node.firstChild) node.removeChild(node.firstChild); };
    // Italian number formatting: 1.758, not 1,758.
    const n = (v: number | null) => (v === null || v === undefined ? '—' : v.toLocaleString('it-IT'));
    const clean = (d: string) =>
      d.trim().toLowerCase().replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/[/?#].*$/, '');

    const emptyNode = (msg: string) => el('p', 'text-[13.5px] text-[oklch(0.78_0.03_275)]', msg);

    const rowNode = (left: string, right: string, muted?: string) => {
      const li = el('li', 'flex items-baseline justify-between gap-4 border-t border-white/10 py-2.5 text-[13.5px] first:border-t-0');
      const l = el('span', 'text-white', left);
      if (muted) l.appendChild(el('span', 'text-[oklch(0.68_0.03_275)]', ` · ${muted}`));
      li.append(l, el('span', 'shrink-0 font-mono text-[12px] text-[oklch(0.78_0.03_275)]', right));
      return li;
    };

    const listNode = (items: HTMLElement[]) => {
      const ul = el('ul');
      items.forEach((i) => ul.appendChild(i));
      return ul;
    };

    const cardNode = (title: string, sub: string, body: HTMLElement) => {
      const card = el('div', 'rounded-xl border border-white/12 bg-white/[0.05] p-5 sm:p-6');
      card.append(
        el('h3', 'text-[15px] font-semibold text-white', title),
        el('p', 'mb-4 mt-1 text-[13px] leading-relaxed text-[oklch(0.72_0.03_275)]', sub),
        body,
      );
      return card;
    };

    const showMessage = (msg: string) => { clear(out); out.appendChild(emptyNode(msg)); out.hidden = false; };

    const render = (plan: any) => {
      const { leadApi, signup } = endpoints();
      const ranked = plan.layers?.find((l: any) => l.id === 'ranked');
      const wins = plan.closestWins ?? [];
      const gaps = plan.gaps ?? [];
      const failing = plan.readiness?.failing ?? [];
      const artifacts = (plan.readiness?.artifacts ?? []).filter((a: any) => a.body);

      const winsBody = wins.length
        ? listNode(wins.map((w: any) => rowNode(w.keyword, `#${w.position} · ${n(w.volume)}/mese`, w.path)))
        : ranked && !ranked.ok
          ? emptyNode('Nessun dato di posizionamento per questo dominio.')
          : plan.rankingKeywords
            ? emptyNode(`${n(plan.rankingKeywords)} termini posizionati, nessuno in seconda pagina in questo momento. Il lavoro sta nei gap.`)
            : emptyNode('Ancora niente di posizionato. Ogni articolo è il primo, quindi i gap qui sotto sono il piano.');

      const gapsBody = gaps.length
        ? listNode(gaps.map((g: any) =>
            rowNode(g.keyword, `${n(g.volume)}/mese · ${g.rankedBy.map((r: any) => `${r.domain} #${r.position}`).join(', ')}`)))
        : emptyNode(plan.competitors?.length
            ? 'Niente in prima pagina per i tuoi competitor che tu non abbia.'
            : 'Per ora non è stato identificato nessun competitor organico per questo dominio.');

      let readyBody: HTMLElement;
      if (plan.readiness?.error) {
        readyBody = emptyNode(plan.readiness.error);
      } else if (failing.length) {
        readyBody = el('div');
        const score = el('p', 'mb-3 text-[28px] font-semibold leading-none text-white', plan.readiness.score);
        score.appendChild(el('span', 'text-[14px] font-normal text-[oklch(0.68_0.03_275)]', '/100'));
        readyBody.append(score, listNode(failing.map((f: any) => rowNode(String(f.check).replace(/_/g, ' '), ''))));
        if (artifacts.length) {
          const word = artifacts.length === 1 ? 'correzione generata, pronta' : 'correzioni generate, pronte';
          readyBody.appendChild(el('p', 'mt-3 text-[12.5px] text-[oklch(0.72_0.03_275)]',
            `${artifacts.length} ${word} da incollare. Arrivano con il piano completo.`));
        }
      } else {
        readyBody = el('div');
        const score = el('p', 'mb-3 text-[28px] font-semibold leading-none text-white', plan.readiness.score);
        score.appendChild(el('span', 'text-[14px] font-normal text-[oklch(0.68_0.03_275)]', '/100'));
        readyBody.append(score, emptyNode('Tutti i controlli superati. Gli assistenti AI riescono a leggere questo sito.'));
      }

      clear(out);
      out.appendChild(el('p', 'mb-4 font-mono text-[11px] uppercase tracking-[0.08em] text-[oklch(0.72_0.03_275)]',
        `Piano di crescita per ${plan.domain}${plan.cached ? ' · in cache da oggi' : ''}`));

      const grid = el('div', 'grid gap-3 md:grid-cols-3');
      const rivals = plan.competitors?.map((c: any) => c.domain).join(' e ') || 'chi ti fa concorrenza';
      grid.append(
        cardNode('Vittorie più vicine', 'Termini per cui sei già in seconda pagina. Una revisione dalla prima.', winsBody),
        cardNode('Gap', `Cosa posiziona in prima pagina ${rivals} e tu no.`, gapsBody),
        cardNode('Gli assistenti AI leggono il tuo sito?', 'Nove controlli: regole per i crawler, dati strutturati, una copia leggibile a macchina.', readyBody),
      );
      out.appendChild(grid);

      const panel = el('div', 'mt-4 rounded-xl border border-white/12 bg-white/[0.05] p-5 sm:p-6');
      const targets: string[] = plan.cadence?.firstTargets ?? [];
      const cadence = el('p', 'text-[14.5px] leading-relaxed text-white',
        `${plan.cadence?.articlesPerMonth ?? 4} articoli al mese`);
      if (targets.length) {
        cadence.appendChild(document.createTextNode(', a partire da '));
        targets.forEach((t, i) => {
          if (i) cadence.appendChild(document.createTextNode(', '));
          cadence.appendChild(el('em', 'font-display-italic', t));
        });
      }
      cadence.appendChild(document.createTextNode(
        `. Il primo pubblicato in ${plan.cadence?.firstPublishDays ?? 5} giorni lavorativi, dopo che lo hai approvato.`));
      panel.appendChild(cadence);

      const actions = el('div', 'mt-4 flex flex-col gap-2.5 sm:flex-row sm:items-center');
      const start = el('a', 'inline-flex h-11 items-center justify-center rounded-[9px] bg-white px-5 text-[14px] font-medium text-[oklch(0.2_0.06_275)] hover:bg-[oklch(0.94_0.01_275)]',
        'Inizia a pubblicare con questo piano →');
      (start as HTMLAnchorElement).href = `${signup}?domain=${encodeURIComponent(plan.domain)}`;

      const lead = el('form', 'flex flex-1 gap-2') as HTMLFormElement;
      const email = el('input', 'h-11 min-w-0 flex-1 rounded-[9px] border border-white/15 bg-white/[0.07] px-3.5 text-[14px] text-white placeholder:text-[oklch(0.68_0.03_275)] focus:border-white/40 focus:outline-none') as HTMLInputElement;
      Object.assign(email, { name: 'email', type: 'email', required: true, placeholder: 'tu@azienda.it' });
      const send = el('button', 'h-11 shrink-0 cursor-pointer rounded-[9px] border border-white/25 px-4 text-[14px] text-white hover:bg-white/10', 'Inviami il piano completo') as HTMLButtonElement;
      send.type = 'submit';
      lead.append(email, send);
      actions.append(start, lead);
      panel.appendChild(actions);

      const status = el('p', 'mt-2 min-h-[1.2em] text-[12.5px] text-[oklch(0.72_0.03_275)]');
      panel.appendChild(status);
      out.appendChild(panel);
      out.hidden = false;

      lead.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.textContent = 'Invio in corso…';
        try {
          const res = await fetch(leadApi, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email.value.trim(), domain: plan.domain }),
          });
          const body = await res.json();
          status.textContent = !res.ok
            ? body.error ?? 'Non è stato possibile salvare.'
            : body.emailed
              ? 'Inviato. Il piano completo, correzioni incluse, è nella tua inbox.'
              : 'Salvato. Ti mandiamo il piano completo via email.';
        } catch {
          status.textContent = 'Server non raggiungibile. Riprova.';
        }
      });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const domain = clean(input.value);
      if (!/^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*\.[a-z]{2,}$/.test(domain)) {
        showMessage('Non sembra un dominio. Prova con esempio.it.');
        input.focus();
        return;
      }
      const { api } = endpoints();
      button.disabled = true;
      label.textContent = 'Sto leggendo il tuo sito…';
      showMessage(`Controllo per cosa si posiziona ${domain}, chi altro si posiziona per gli stessi termini, e se gli assistenti AI riescono a leggerlo. Al massimo 60 secondi, di solito pochi.`);
      try {
        const res = await fetch(api, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ domain }),
        });
        const body = await res.json();
        if (!res.ok) showMessage(body.error ?? 'Non è stato possibile costruire un piano per questo dominio.');
        else render(body);
      } catch {
        showMessage('Server non raggiungibile. Riprova tra poco.');
      } finally {
        button.disabled = false;
        label.textContent = 'Ricevi il piano di crescita';
      }
    });
  });
</script>
