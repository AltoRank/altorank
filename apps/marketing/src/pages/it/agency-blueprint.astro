---
import PSEO from '@/layouts/PSEO.astro';
import Button from '@/components/shared/Button.astro';
import { buildArticleSchema, buildFAQSchema } from '@/lib/schema';
import { APP_NAME, SITE_URL, AUTHOR_NAME, AUTHOR_URL, OSS_REPO_PUBLIC, PILOT_START } from '@/constants';

// Italian mirror of /agency-blueprint. Hand-translated, following the same
// pattern as src/pages/de/alternatives/* (no i18n runtime, full page copy).
//
// This locale matters more than the others: 160 of the 274 verified agencies on
// the target shortlist are Italian, and Italian is currently the only outreach
// copy approved in hanoi/leadgen. Keep this page in sync with the English one
// whenever the numbers or the ladder change.
//
// Tone follows hanoi/leadgen/OUTREACH_PLAYBOOK.md: informal-professional `tu`,
// peer to peer, never markety.

const pageUrl = `${SITE_URL}/it/agency-blueprint`;
const publishDate = new Date('2026-08-15');
const dateModified = new Date('2026-08-15');
const publishDateDisplay = publishDate.toLocaleDateString('it-IT', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Il piano per le agenzie', href: '/it/agency-blueprint' },
];

// Numeri in formato italiano: 1.758 con il punto come separatore delle migliaia.
const SCAN = [
  { stat: '1.758', label: 'siti di agenzie analizzati', note: 'Raggiungibili, in 12 lingue' },
  { stat: '19%', label: 'vende GEO in una pagina servizi', note: 'Con evidenza citata dalla pagina stessa' },
  { stat: '27%', label: 'ha una SEO solida e nessun GEO', note: 'La capacità c’è, l’offerta no' },
];

const PROBLEMS = [
  {
    title: 'I clienti chiedono, e non esiste una risposta ripetibile',
    body: 'La domanda arriva prima dell’offerta. Quasi tutte le agenzie sanno spiegare cos’è l’AI search, ma non riescono a consegnare al cliente un metodo documentato, un capitolato e un report mensile. Senza queste tre cose resta una conversazione, non una voce in fattura.',
  },
  {
    title: 'Gli strumenti di misurazione si contraddicono tra loro',
    body: 'Punta tre tool di AI visibility sullo stesso brand con gli stessi prompt e i tassi di citazione tornano diversi. Dato che ogni fornitore tiene la propria metodologia privata, non c’è modo di capire quale sia più vicino alla realtà, e questo rende il numero difficilissimo da difendere davanti al cliente.',
  },
  {
    title: 'Il volume non scala su un portafoglio senza assumere',
    body: 'Produrre contenuti per un brand è un problema di workflow. Produrli per quindici, ognuno con la propria voce, il proprio CMS e la propria catena di approvazione, è un problema di operations. La soluzione abituale è assumere, che riporta il margine al punto di partenza.',
  },
  {
    title: 'L’AI non revisionata sul brand di un cliente è un rischio concreto',
    body: 'Lo scaled-content enforcement di Google del 2025 ha reso l’AI non revisionata ad alto volume un rischio di penalizzazione. Sul sito di un cliente quel rischio non è tuo da prendere. La maggior parte dei tool di questa categoria pubblica ancora in automatico per impostazione predefinita.',
  },
];

const SOLUTION = [
  {
    title: 'È il livello di esecuzione, non l’ennesima dashboard',
    body: 'Ricerca una keyword, costruisce il brief, scrive la bozza, la valuta e la pubblica sul CMS del cliente. L’output sono pagine pubblicate, non un report che ti dice cosa andare a fare.',
  },
  {
    title: 'Open source, tutto il prodotto',
    body: 'Installalo sulla tua infrastruttura. Nessun prezzo per postazione, nessun ciclo di procurement e nessun fornitore che può cambiare le condizioni quando ormai i tuoi clienti ci si appoggiano. Workspace multi-cliente e report white-label sono nella build gratuita, non dietro un piano premium.',
  },
  {
    title: 'Niente va online senza che una persona lo approvi',
    body: 'Il blocco di approvazione sta dentro lo step di pubblicazione, quindi job schedulati e azioni massive non possono aggirarlo, e la pubblicazione parte sempre in bozza. Puoi vendere giudizio editoriale invece che automazione, che è la cosa più sicura da mettere sul brand di un cliente.',
  },
  {
    title: 'La misurazione è verificabile',
    body: 'Il set di prompt, il metodo di campionamento e i controlli di scoring sono codice leggibile, non una scatola nera. Quando un cliente ti chiede come è stato prodotto quel numero, puoi mostrarglielo: è una conversazione molto diversa dal citare la dashboard di un fornitore.',
  },
];

const OUTCOMES = [
  'Un retainer GEO o di AI visibility che puoi definire, prezzare e difendere, costruito su un metodo che puoi mostrare al cliente.',
  'Un report mensile per il cliente con il tuo brand, sul lavoro che il sistema ha davvero fatto e non su dati di terzi ri-visualizzati.',
  'Volume di contenuti su tutto il portafoglio senza aggiungere copywriter, con voce per cliente e 11 destinazioni CMS.',
  'Un costo software che è la tua bolletta di infrastruttura, non una voce per postazione che cresce contro di te man mano che acquisisci clienti.',
];

const PLANS_IT = [
  {
    name: 'Self-host',
    price: '$0',
    period: 'per sempre',
    desc: OSS_REPO_PUBLIC
      ? 'Tutto il motore, open source. La tua infrastruttura, le tue API key, nessun blocco sulle funzionalità.'
      : 'Tutto il motore, open source: la tua infrastruttura, le tue API key, nessun blocco sulle funzionalità. Il repository non è ancora pubblico.',
  },
  {
    name: 'Managed',
    price: '€69',
    period: '/mese',
    desc: 'Nessuna API key da gestire, perché i costi di modello e dati sono inclusi. Per operatori singoli e agenzie con uno o due brand.',
  },
  {
    name: 'Agency',
    price: '€199',
    period: '/mese',
    desc: 'Per agenzie che gestiscono contenuti su un portafoglio clienti completo. Tutto misurato sull’output, non su postazioni o workspace.',
  },
];

const AGENCY_LAYER = [
  {
    title: 'Un workspace per cliente, e i workspace non sono il contatore',
    body: 'Ogni cliente ha un workspace isolato con il suo sito, il suo set di keyword, il suo profilo di voce e la sua destinazione di pubblicazione. Niente è condiviso tra loro se non lo condividi tu. Il piano Agency non mette un tetto a quanti ne apri, quindi prendere un cliente non costa nulla finché gli articoli di quel cliente non vengono davvero prodotti. Managed si ferma a tre workspace, che è la linea onesta tra un operatore singolo e un portafoglio.',
  },
  {
    title: 'Il white-label non è dietro un piano, nemmeno nella build gratuita',
    body: 'Logo, colore d’accento, dominio personalizzato e l’indirizzo da cui partono i report mensili sono impostazioni dell’account, applicate a tutto quello che il cliente vede. Non è un upsell: sotto la licenza non ci sono funzionalità bloccate, quindi la build self-hosted ha lo stesso white-label e la stessa capacità multi-cliente dei piani a pagamento. Chi ti vende il branding client-facing come piano premium ti sta facendo pagare qualcosa che noi non blocchiamo.',
  },
  {
    title: 'Tre ruoli, così un copywriter non può cambiare il brand dell’account',
    body: 'Owner, admin ed editor. Gli editor scrivono, revisionano e approvano i contenuti ma non toccano fatturazione, branding o portafoglio clienti, e modificare le impostazioni white-label è riservato a owner e admin. È la separazione che conta quando un copywriter junior lavora dentro il brand di un cliente vero e non in una sandbox.',
  },
  {
    title: 'L’approvazione sta dentro la pubblicazione, con sign-off del cliente opzionale',
    body: 'Il blocco fa parte dello step di pubblicazione e non è un campo di stato lì accanto, quindi job schedulati e azioni massive non possono aggirarlo, e la pubblicazione parte sempre in bozza. Aggiungi il cliente come revisore e la traccia registra chi ha approvato quale versione e quando: è esattamente il documento che ti serve quando un cliente chiede perché una pagina è andata online.',
  },
  {
    title: 'Voce per cliente, undici destinazioni di pubblicazione',
    body: 'Ogni workspace allena il proprio profilo di voce sui testi esistenti di quel cliente, così l’output non converge su un unico stile di casa su tutto il portafoglio. La pubblicazione arriva su WordPress, Shopify, WooCommerce, Magento, Webflow, Ghost, Wix, HubSpot, Notion, Framer o un repository git, che copre buona parte di quello che gira davvero su una base clienti mista.',
  },
];

const FAQS = [
  {
    question: 'È disponibile oggi?',
    answer: OSS_REPO_PUBLIC
      ? 'Sì. Il repository è pubblico e puoi installarlo da solo adesso. Anche i piani ospitati sono attivi.'
      : `No, e sarebbe scorretto far finta del contrario. Al momento in cui scriviamo il repository non è pubblico e ${APP_NAME} non ha clienti paganti. La licenza, il perimetro e i prezzi qui sotto sono decisi e non aspirazionali, ma questa pagina descrive quello che stiamo costruendo ed è un invito a darle forma, non un prodotto che puoi comprare oggi pomeriggio.`,
  },
  {
    question: 'Cosa stai chiedendo, concretamente?',
    answer: 'Una conversazione e, con poche agenzie, un rapporto da design partner. Vuol dire che ci racconti come oggi definisci, eroghi e rendiconti il lavoro sull’AI search, noi costruiamo su quello, e tu ottieni accesso anticipato e influenza diretta su cosa viene rilasciato. Non è un acquisto e non c’è nulla da firmare.',
  },
  {
    question: 'Da dove arrivano i numeri di questa pagina?',
    answer: 'Da una nostra analisi di 1.758 siti di agenzie raggiungibili in 12 lingue, verificando se i servizi GEO o di AI search compaiono in una pagina servizi con evidenza citata dalla pagina stessa. Una parte del campione è stata raccolta cercando specificamente agenzie che già promuovono il GEO, quindi è esclusa da ogni denominatore. È un dato di prima mano e ti mostriamo volentieri il metodo, se vuoi contestarlo.',
  },
  {
    question: 'Cosa comporta la licenza per la mia agenzia?',
    answer: 'Installarlo e usarlo così com’è per i tuoi clienti non comporta alcun obbligo di pubblicazione. Usare il software commercialmente e per conto dei clienti è esattamente ciò che la licenza permette. L’obbligo scatta solo se modifichi il sorgente e poi offri quella versione modificata ad altri attraverso la rete. Farci girare un’agenzia sopra è libero e senza vincoli.',
  },
  {
    question: 'Perché regalare le parti che gli altri tool fanno pagare?',
    answer: 'Perché il codice non è il vantaggio competitivo. I concorrenti hanno già rilasciato le stesse funzionalità e la categoria è ben servita. Quello che non abbiamo è distribuzione, né un motivo per cui un’agenzia dovrebbe fidarsi di un tool senza storico. Rilasciare tutto in open source è il modo in cui compriamo entrambe le cose, e la licenza è ciò che impedisce a un concorrente di prenderlo e richiuderlo.',
  },
  {
    question: 'Fate pagare per workspace cliente o per postazione?',
    answer: 'Né l’uno né l’altro. La misurazione è sugli articoli pubblicati e su chi paga il conto di modelli e dati. Il piano Agency a €199 al mese include 400 articoli e un numero illimitato di workspace, con i permessi per ruolo inclusi invece che pagati per utente. Acquisire un cliente non deve alzarti la bolletta software prima che quel cliente abbia prodotto qualcosa.',
  },
  {
    question: 'Cosa succede se pubblico più di 400 articoli in un mese?',
    answer: 'Ogni articolo aggiuntivo costa €0,45. Non c’è un salto forzato al piano superiore e non c’è una penale di eccedenza, perché il costo marginale è un costo reale di modelli e dati e non una leva di pricing. Su Managed la stessa eccedenza è €0,60, quindi il gradino Agency abbassa il costo marginale oltre ad alzare il volume incluso.',
  },
  {
    question: 'Il report white-label è riservato al piano Agency?',
    answer: 'No, ed è il caso di essere precisi perché la maggior parte dei tool di questa categoria lo blocca davvero. Branding white-label e workspace multi-cliente non sono dietro nessun piano, nemmeno nella build gratuita self-hosted. I piani a pagamento vendono hosting, costi di modelli e dati inclusi, volume, ruoli e supporto: non l’accesso al branding che vede il cliente.',
  },
  {
    question: 'Un cliente può approvare i suoi contenuti prima che vadano online?',
    answer: 'Sì. Il sign-off del cliente è un secondo blocco opzionale sopra la tua approvazione editoriale, e in ogni caso la pubblicazione parte in bozza. La traccia registra quale versione è stata approvata e da chi, così alla domanda "chi ha approvato questa pagina" si risponde con un registro e non con un ricordo.',
  },
];

const structuredData = [
  buildArticleSchema({
    title: `Software di contenuti SEO white-label per agenzie: il piano ${APP_NAME}`,
    description:
      'Workspace multi-cliente, white-label non bloccato e approvazione prima di ogni pubblicazione. Il problema che AltoRank affronta per le agenzie, l’approccio, il risultato che puoi rivendere e quanto costa.',
    publishDate,
    dateModified,
    author: AUTHOR_NAME,
    authorType: 'Person',
    authorUrl: AUTHOR_URL,
    url: pageUrl,
  }),
  buildFAQSchema(FAQS),
];
---

<PSEO
  title="Software di contenuti SEO white-label per agenzie"
  description="Workspace multi-cliente, white-label non bloccato, approvazione prima di pubblicare. Cosa costruiamo per le agenzie, quanto costa e i dati da 1.758 siti."
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
  lang="it"
  alternateLanguages={[
    { hreflang: 'en', href: `${SITE_URL}/agency-blueprint` },
    { hreflang: 'it', href: `${SITE_URL}/it/agency-blueprint` },
    { hreflang: 'x-default', href: `${SITE_URL}/agency-blueprint` },
  ]}
>
  {/* HERO */}
  <header class="border-b border-line bg-[radial-gradient(600px_300px_at_88%_-10%,var(--accent-soft),transparent_70%),linear-gradient(180deg,var(--bg),var(--bg-2))] py-[72px]">
    <div class="mx-auto max-w-[760px] px-8">
      <h1 class="mb-6 text-[clamp(34px,5vw,48px)] font-semibold leading-[1.05] tracking-[-0.025em] text-ink [text-wrap:balance]">
        Il piano, in una pagina
      </h1>
      <p class="mb-5 text-lg font-semibold leading-relaxed text-ink [text-wrap:pretty]">
        Cosa stiamo costruendo, per chi, cosa può farci un’agenzia e quanto costa. Nessun
        caso studio, perché non ne esistono ancora. Se preferisci contestare la premessa
        piuttosto che leggere una presentazione commerciale, la premessa è nella prima sezione.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-line-soft pt-5 text-[13px] text-ink-3">
        <span>Di <a href={AUTHOR_URL} target="_blank" rel="noopener noreferrer" class="font-medium text-ink-2 underline decoration-line decoration-1 underline-offset-[3px] transition-colors hover:text-ink hover:decoration-accent">{AUTHOR_NAME}</a></span>
        <span class="text-line">&middot;</span>
        <span><time datetime={publishDate.toISOString().slice(0, 10)}>{publishDateDisplay}</time></span>
        <span class="text-line">&middot;</span>
        <span><a href="/agency-blueprint" class="underline decoration-line decoration-1 underline-offset-[3px] hover:text-ink-2 hover:decoration-accent">Read in English</a></span>
      </div>
    </div>
  </header>

  {/* I DATI */}
  <section class="border-b border-line py-[72px]">
    <div class="mx-auto max-w-[760px] px-8">
      <h2 class="mb-4 text-[clamp(24px,3.2vw,30px)] font-semibold tracking-[-0.02em] text-ink [text-wrap:balance]">
        Cosa abbiamo trovato analizzando 1.758 siti di agenzie
      </h2>
      <p class="mb-8 text-[15.5px] leading-relaxed text-ink-2">
        Prima di costruire qualsiasi cosa abbiamo analizzato i siti di agenzie raggiungibili
        in 12 lingue, verificando con evidenza citata dalla pagina se vendono servizi GEO o
        di AI search. Il divario tra capacità e offerta è tutta la tesi.
      </p>
      <div class="grid gap-3 sm:grid-cols-3">
        {SCAN.map((s) => (
          <div class="rounded-xl border border-line bg-bg p-5">
            <div class="text-[30px] font-semibold leading-none tracking-[-0.025em] text-ink">{s.stat}</div>
            <div class="mt-2 text-[14px] font-medium text-ink">{s.label}</div>
            <div class="mt-1.5 text-[12.5px] leading-relaxed text-ink-3">{s.note}</div>
          </div>
        ))}
      </div>
      <p class="mt-5 text-[13px] leading-relaxed text-ink-3">
        Nota sul metodo: una parte del campione è stata raccolta cercando agenzie che già
        promuovono il GEO, quindi è esclusa da ogni denominatore qui sopra. Il campione
        italiano e quello internazionale divergono molto, rispettivamente 8% e 29%, quindi
        tratta il dato aggregato come un intervallo e non come un singolo tasso di mercato.
      </p>
    </div>
  </section>

  {/* IL PROBLEMA */}
  <section class="border-b border-line py-[72px]">
    <div class="mx-auto max-w-[760px] px-8">
      <h2 class="mb-3 text-[clamp(24px,3.2vw,30px)] font-semibold tracking-[-0.02em] text-ink [text-wrap:balance]">
        Il problema
      </h2>
      <p class="mb-8 text-[15.5px] leading-relaxed text-ink-2">
        Non &laquo;alle agenzie servono più contenuti&raquo;. Quattro cose precise che
        impediscono a un’offerta sull’AI search di diventare una voce fatturabile.
      </p>
      <div class="flex flex-col gap-3">
        {PROBLEMS.map((p, i) => (
          <div class="flex gap-4 rounded-xl border border-line bg-bg p-5">
            <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-panel-2 font-mono text-[12px] font-semibold text-ink-2">{i + 1}</span>
            <div>
              <h3 class="mb-1.5 text-[16px] font-semibold tracking-[-0.015em] text-ink">{p.title}</h3>
              <p class="text-[14.5px] leading-relaxed text-ink-2">{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* L'APPROCCIO */}
  <section class="border-b border-line py-[72px]">
    <div class="mx-auto max-w-[760px] px-8">
      <h2 class="mb-3 text-[clamp(24px,3.2vw,30px)] font-semibold tracking-[-0.02em] text-ink [text-wrap:balance]">
        L&rsquo;approccio
      </h2>
      <p class="mb-8 text-[15.5px] leading-relaxed text-ink-2">
        Quattro decisioni, ognuna rivolta a un problema specifico qui sopra.
      </p>
      <div class="flex flex-col gap-3">
        {SOLUTION.map((s) => (
          <div class="rounded-xl border border-line bg-bg p-5">
            <h3 class="mb-1.5 text-[16px] font-semibold tracking-[-0.015em] text-ink">{s.title}</h3>
            <p class="text-[14.5px] leading-relaxed text-ink-2">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* IL RISULTATO */}
  <section class="border-b border-line py-[72px]">
    <div class="mx-auto max-w-[760px] px-8">
      <div class="relative overflow-hidden rounded-xl border border-ink bg-ink p-8 text-bg">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(500px_240px_at_100%_0%,oklch(0.45_0.15_265/0.45),transparent_60%)]"></div>
        <div class="relative z-10">
          <h2 class="mb-4 text-[clamp(23px,3vw,29px)] font-semibold leading-[1.15] tracking-[-0.02em] [text-wrap:balance]">
            Il risultato, detto come quello che puoi vendere
          </h2>
          <ul class="flex flex-col gap-3.5">
            {OUTCOMES.map((o) => (
              <li class="flex items-start gap-3 text-[15.5px] leading-relaxed text-[oklch(0.85_0.01_80)]">
                <svg class="mt-1 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="oklch(0.75 0.14 155)" stroke-width="2">
                  <path d="M5 12.5 10 17 19 7" />
                </svg>
                {o}
              </li>
            ))}
          </ul>
          <p class="mt-6 border-t border-[oklch(0.3_0.008_80)] pt-5 text-[14px] leading-relaxed text-[oklch(0.72_0.01_80)]">
            Volutamente non mettiamo qui un moltiplicatore di fatturato. Non abbiamo risultati
            di clienti su cui basarlo, e tu sai prezzare il tuo retainer meglio di quanto
            potremmo indovinare noi.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* IL LIVELLO AGENZIA */}
  <section class="border-b border-line py-[72px]">
    <div class="mx-auto max-w-[760px] px-8">
      <h2 class="mb-3 text-[clamp(24px,3.2vw,30px)] font-semibold tracking-[-0.02em] text-ink [text-wrap:balance]">
        Come funziona il livello agenzia
      </h2>
      <p class="mb-8 text-[15.5px] leading-relaxed text-ink-2">
        Le parti che esistono perché un portafoglio non è un sito ripetuto. Workspace,
        branding, ruoli e traccia di approvazione, descritti come sono davvero costruiti e
        non come una griglia di funzionalità.
      </p>
      <div class="flex flex-col gap-3">
        {AGENCY_LAYER.map((a) => (
          <div class="rounded-xl border border-line bg-bg p-5">
            <h3 class="mb-1.5 text-[16px] font-semibold tracking-[-0.015em] text-ink">{a.title}</h3>
            <p class="text-[14.5px] leading-relaxed text-ink-2">{a.body}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 rounded-xl border border-line bg-panel-2 p-5 text-[14.5px] leading-relaxed text-ink-2">
        In termini di portafoglio: i 400 articoli inclusi nel piano Agency sono circa 26 al
        mese su un book da quindici clienti, o 40 su dieci, prima di un solo euro di
        eccedenza. Il primo limite che incontrerai è la capacità di revisione editoriale,
        non il piano, ed è il limite che preferiamo tu incontri.
      </p>
    </div>
  </section>

  {/* IL PREZZO */}
  <section class="border-b border-line py-[72px]">
    <div class="mx-auto max-w-[760px] px-8">
      <h2 class="mb-3 text-[clamp(24px,3.2vw,30px)] font-semibold tracking-[-0.02em] text-ink [text-wrap:balance]">
        Il prezzo
      </h2>
      <p class="mb-8 text-[15.5px] leading-relaxed text-ink-2">
        La misurazione è sugli articoli pubblicati e su chi paga il conto dei modelli. Non è
        sulle postazioni e non è su quanti brand clienti gestisci, perché far pagare a
        un’agenzia il fatto di acquisire clienti è un pessimo modo di essere il tool di
        un’agenzia.
      </p>
      <div class="grid gap-3 sm:grid-cols-2">
        {PLANS_IT.map((plan) => (
          <div class="rounded-xl border border-line bg-bg p-5">
            <div class="mb-1 flex items-baseline gap-1.5">
              <span class="text-[26px] font-semibold leading-none tracking-[-0.025em] text-ink">{plan.price}</span>
              <span class="text-[13px] text-ink-3">{plan.period}</span>
            </div>
            <h3 class="mb-2 text-[15px] font-semibold tracking-[-0.015em] text-ink">{plan.name}</h3>
            <p class="text-[13.5px] leading-relaxed text-ink-2">{plan.desc}</p>
          </div>
        ))}
      </div>
      <p class="mt-5 text-[13.5px] text-ink-3">
