---
import Marketing from '@/layouts/Marketing.astro';
import Button from '@/components/shared/Button.astro';
import { APP_NAME, SIGNUP_URL } from '@/constants';
import { buildProductSchema, buildFAQSchema, buildBreadcrumbSchema } from '@/lib/schema';
import { PLANS, YEARLY_MONTHS_FREE, yearlyMonthly, AT_A_GLANCE, PRICING_FAQ } from '@/data/pricing';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Pricing', href: '/pricing' },
];
// Product + Offer (buildProductSchema), FAQPage, BreadcrumbList. No
// AggregateRating: there are no reviews to aggregate, and a rating without
// reviews is a fabricated one.
const structuredData = [buildProductSchema(), buildBreadcrumbSchema(breadcrumbs), buildFAQSchema(PRICING_FAQ)];
---

<Marketing
  title={`Pricing: Self-Host Free, Managed €69, Agency €199 | ${APP_NAME}`}
  description="Self-host it free on your own infrastructure, or let us run it from €69 a month. Articles are the only meter: no seats, no add-ons, no trial clock."
  structuredData={structuredData}
>
  <section class="border-b border-line py-12 md:py-16 lg:py-[72px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <nav class="mb-8 flex items-center gap-2 text-xs text-ink-3">
        <a href="/" class="transition-colors hover:text-ink">Home</a><span>/</span><span class="text-ink-2">Pricing</span>
      </nav>
      <div class="mb-9 max-w-[720px] sm:mb-12">
        <h1 class="mb-3 text-[clamp(28px,5vw,42px)] font-semibold leading-[1.08] tracking-[-0.025em] [text-wrap:balance]">
          Simple, transparent pricing
        </h1>
        <p class="max-w-[62ch] text-[15px] leading-relaxed text-ink-2 sm:text-base [text-wrap:pretty]">
          No per-seat charges. No hidden fees. Self-host it for free, or let us
          run it. There is no trial and no card up front &mdash; your first
          article is free instead, so you can read the draft and its fact check
          before you decide. Nothing is charged until you choose a plan,
          cancelling is a button on your billing page, and your articles stay
          readable after you do.
        </p>
      </div>

      {/* Billing toggle.
          Both prices are rendered and one is hidden, so the page still says
          what it costs with JavaScript off - and the yearly figure is in the
          HTML for anything reading the page without running it, which for this
          product is the point. */}
      <div class="mb-8 flex">
        <div
          id="billing-toggle"
          role="group"
          aria-label="Billing period"
          class="inline-flex items-center gap-0.5 rounded-lg border border-line bg-panel p-0.5"
        >
          <button
            type="button"
            data-period="monthly"
            aria-pressed="true"
            class="btn btn-secondary btn-sm !border-0 !shadow-none"
          >
            Monthly
          </button>
          <button
            type="button"
            data-period="yearly"
            aria-pressed="false"
            class="btn btn-secondary btn-sm !border-0 !shadow-none"
          >
            Yearly
            <span class="ml-1 text-[11px] opacity-70">{YEARLY_MONTHS_FREE} months free</span>
          </button>
        </div>
      </div>

      <div class="grid max-w-[1080px] items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {PLANS.map((plan) => (
          <div
            class={`relative flex h-full flex-col overflow-hidden rounded-xl border p-6 ${
              plan.popular
                ? 'border-accent bg-ink text-bg'
                : 'border-line bg-bg'
            }`}
          >
            <div class="flex flex-1 flex-col">
              <h2 class="text-lg font-semibold tracking-[-0.015em]">{plan.name}</h2>
              <div class="mt-3 flex items-baseline gap-1">
                <span class="text-[42px] font-semibold tracking-[-0.025em] leading-none">
                  <span data-price="monthly">{plan.price}</span>
                  <span data-price="yearly" hidden>
                    {plan.monthly > 0 ? `€${yearlyMonthly(plan.monthly)}` : plan.price}
                  </span>
                </span>
                <span class={`text-sm ${plan.popular ? 'text-[oklch(0.7_0.03_265)]' : 'text-ink-3'}`}>
                  {plan.period}
                </span>
              </div>
              <p class={`mt-1.5 min-h-[18px] text-[12.5px] ${plan.popular ? 'text-[oklch(0.75_0.01_80)]' : 'text-ink-3'}`}>
                {plan.monthly > 0 && (
                  <>
                  <span data-note="monthly">
                    or €{yearlyMonthly(plan.monthly)}/mo billed yearly, {YEARLY_MONTHS_FREE} months free
                  </span>
                  <span data-note="yearly" hidden>
                    €{yearlyMonthly(plan.monthly) * 12} billed once a year, {YEARLY_MONTHS_FREE} months free
                  </span>
                  </>
                )}
              </p>
              <p class={`mt-3 min-h-[92px] text-sm leading-relaxed ${plan.popular ? 'text-[oklch(0.8_0.01_80)]' : 'text-ink-2'}`}>
                {plan.desc}
              </p>

              <Button
                href={plan.href ?? SIGNUP_URL}
                variant={plan.popular ? 'light' : 'secondary'}
                size="sm"
                block
                arrow
                class="mt-6 !flex w-full"
              >
                {plan.cta}
              </Button>

              {plan.ctaNote && (
                <p
                  class={`mt-2.5 text-[12.5px] leading-snug ${
                    plan.popular ? 'text-[oklch(0.75_0.01_80)]' : 'text-ink-3'
                  }`}
                >
                  {plan.ctaNote}
                </p>
              )}

              <ul class="mt-6 flex flex-1 flex-col gap-3 border-t border-line-soft pt-6">
                {plan.features.map((feat) => (
                  <li
                    class={`flex items-start gap-2.5 text-sm ${
                      plan.popular ? 'text-[oklch(0.85_0.01_80)]' : 'text-ink-2'
                    }`}
                  >
                    <svg
                      class="mt-0.5 h-[16px] w-[16px] shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke={plan.popular ? 'oklch(0.75 0.14 155)' : 'oklch(0.55 0.13 155)'}
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M5 12.5 10 17 19 7" />
                    </svg>
                    {feat}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-10 max-w-[62ch] text-sm text-ink-3">
        Running content for more clients than the Agency tier comfortably covers, or need terms in writing?{' '}
        <a href="mailto:hello@altorank.co?subject=AltoRank%20Custom%20plan%20enquiry" class="font-medium text-accent-ink hover:text-accent">
          Talk to sales &rarr;
        </a>
      </p>
    </div>
  </section>

  {/* Every plan, at a glance. One table, one row per thing the code enforces
      or the operator provides; see AT_A_GLANCE for the source of each row. */}
  <section class="border-b border-line bg-panel py-12 md:py-16">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <div class="mb-6 max-w-[720px]">
        <h2 class="mb-2 text-2xl font-semibold tracking-[-0.015em]">Every plan, at a glance</h2>
        <p class="text-[15px] text-ink-2">
          The software is the same on every row. The paid plans sell hosting, included model and data costs,
          volume and support: the things self-hosting makes you provide yourself.
        </p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-line bg-bg">
        <table class="w-full min-w-[640px] border-collapse text-left text-[14px]">
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="px-4 py-3 font-medium text-ink-3">&nbsp;</th>
              {PLANS.map((p) => (
                <th scope="col" class="px-4 py-3 font-semibold text-ink">{p.name}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {AT_A_GLANCE.map((row, i) => (
              <tr class={i < AT_A_GLANCE.length - 1 ? 'border-b border-line-soft' : ''}>
                <th scope="row" class="px-4 py-3 align-top font-medium text-ink-2">{row.label}</th>
                {row.values.map((v) => (
                  <td class="px-4 py-3 align-top text-ink-2">{v}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-b border-line py-12 md:py-16">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <div class="max-w-[820px]">
        <h2 class="mb-6 text-2xl font-semibold tracking-[-0.015em]">Pricing questions</h2>
        <div class="flex flex-col gap-2">
          {PRICING_FAQ.map((item) => (
            <details class="group rounded-lg border border-line bg-bg">
              <summary class="cursor-pointer list-none px-5 py-4 text-[15px] font-medium text-ink [&::-webkit-details-marker]:hidden">{item.question}</summary>
              <p class="border-t border-line-soft px-5 py-4 text-[14.5px] leading-relaxed text-ink-2">{item.answer}</p>
            </details>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-2.5">
          <Button href={SIGNUP_URL} size="sm" arrow>Add your domain</Button>
          <Button href="/open-source" variant="secondary" size="sm">Self-host it instead</Button>
        </div>
      </div>
    </div>
  </section>
</Marketing>

<script>
  // ClientRouter swaps the document without re-executing module scripts,
  // so this re-binds the toggle each time the pricing page is navigated to.
  // Every listener below is bound to an element inside the swapped DOM,
  // which takes them with it when it goes: nothing to tear down.
  document.addEventListener('astro:page-load', () => {

  // Progressive: both prices ship in the HTML and this swaps which is hidden.
  // Without it the page still shows the monthly price and the yearly line, so
  // nothing is lost when the script does not run - which matters more than
  // usual for a product about being readable by machines.
  const group = document.getElementById("billing-toggle");
  if (group) {
    const setPeriod = (period: string) => {
      for (const el of document.querySelectorAll<HTMLElement>("[data-price]")) {
        el.hidden = el.dataset.price !== period;
      }
      for (const el of document.querySelectorAll<HTMLElement>("[data-note]")) {
        el.hidden = el.dataset.note !== period;
      }
      for (const b of group.querySelectorAll<HTMLButtonElement>("button")) {
        const on = b.dataset.period === period;
        b.setAttribute("aria-pressed", String(on));
        b.classList.toggle("!bg-ink", on);
        b.classList.toggle("!text-bg", on);
        b.classList.toggle("!bg-transparent", !on);
      }
    };

    group.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-period]");
      if (btn?.dataset.period) setPeriod(btn.dataset.period);
    });

    setPeriod("monthly");
  }
  });
</script>
