---
import PSEO from '@/layouts/PSEO.astro';
import Button from '@/components/shared/Button.astro';
import { COMPETITORS } from '@/data/competitors';
import { buildItemListSchema } from '@/lib/schema';
import { APP_NAME, SITE_URL, PRIMARY_CTA } from '@/constants';

// The directory of head-to-heads. Renders from src/data/competitors.ts, the
// same array /compare and /alternatives/altorank use, so the three cannot
// disagree about who is on the list or what decides each comparison. It used
// to carry its own copy of the list, and two entries had already drifted.
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Alternatives', href: '/alternatives' },
];

const structuredData = [
  buildItemListSchema(
    COMPETITORS.map((c) => ({
      name: `${c.name} alternative`,
      url: `${SITE_URL}/alternatives/${c.slug}`,
      description: c.bestFor,
    })),
  ),
];
---

<PSEO
  title="Alternatives"
  description={`Honest comparisons of ${APP_NAME} against the SEO content tools people actually evaluate. Picked by use case, not marketing copy.`}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <section class="border-b border-line py-14 md:py-20">
    <div class="mx-auto max-w-[1100px] px-5 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-[720px]">
        <h1 class="text-[clamp(28px,5vw,44px)] font-semibold leading-[1.06] tracking-[-0.025em] text-ink [text-wrap:balance]">
          Tool alternatives, evaluated by what you actually ship
        </h1>
        <p class="mt-5 text-[17px] leading-relaxed text-ink-2 [text-wrap:pretty]">
          Every SEO content tool is sold as &ldquo;all-in-one&rdquo;. These comparisons separate the ones that hold
          up across several sites from the ones built for solo operators, and each says plainly where the other
          tool is the better pick.
        </p>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-2">
          Weighing {APP_NAME} itself?{' '}
          <a href="/alternatives/altorank" class="text-ink underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-accent">{APP_NAME} alternatives</a>{' '}
          is our own roundup, including the cases where we are the wrong choice. Prefer one table per tool?{' '}
          <a href="/compare" class="text-ink underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-accent">The compare hub</a>{' '}
          indexes every head-to-head by the axis that decides it.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {COMPETITORS.map((c) => (
          <a
            href={`/alternatives/${c.slug}`}
            class="group flex flex-col gap-3 rounded-xl border border-line bg-bg p-6 transition-colors hover:border-accent hover:bg-accent-soft/15"
          >
            <h2 class="text-2xl font-semibold tracking-[-0.015em] text-ink">
              {c.name} alternative
            </h2>
            <p class="text-sm leading-relaxed text-ink-2">{c.bestFor}</p>
            <p class="text-[13px] leading-relaxed text-ink-3">
              Decided by: {c.axis.toLowerCase()}.
              {c.toolsTested ? ` ${c.toolsTested} tools tested.` : ' Head to head.'}
            </p>
            <span class="mt-auto inline-flex min-h-[44px] items-center gap-1.5 pt-2 text-[13px] font-medium text-accent-ink sm:min-h-0">
              Read the comparison
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="14" height="14" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                <path d="M5 12h14m0 0-6-6m6 6-6 6" />
              </svg>
            </span>
          </a>
        ))}
      </div>

      <div class="mt-12">
        <Button href={PRIMARY_CTA.href} size="sm" arrow>{PRIMARY_CTA.label}</Button>
      </div>
    </div>
  </section>
</PSEO>
