---
import PSEO from '@/layouts/PSEO.astro';
import Button from '@/components/shared/Button.astro';
import { buildArticleSchema, buildFAQSchema, buildItemListSchema } from '@/lib/schema';
import { APP_NAME, SIGNUP_URL, SITE_URL, AUTHOR_NAME, AUTHOR_URL, OSS_COMPARISON_LABEL, PRIMARY_CTA } from '@/constants';

const pageUrl = `${SITE_URL}/alternatives/rankyak`;

const publishDate = new Date('2026-06-21');
const dateModified = new Date('2026-06-21');
const publishDateDisplay = publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Alternatives', href: '/alternatives' },
  { label: 'RankYak alternative', href: '/alternatives/rankyak' },
];

interface TldrRow {
  name: string;
  bestFor: string;
  editorialControl: string;
  whiteLabel: string;
  ecommerce: string;
  price: string;
  ours?: boolean;
}

const TLDR_ROWS: TldrRow[] = [
  { name: APP_NAME, bestFor: 'Open source, approval before publish', editorialControl: 'Approve before publish + client sign-off', whiteLabel: 'Included (Agency)', ecommerce: 'Native (Shopify/Woo)', price: 'From $0 self-host', ours: true },
  { name: 'RankYak', bestFor: 'Solo / hands-off volume', editorialControl: 'None, daily autopilot', whiteLabel: 'Yes', ecommerce: 'Generic', price: 'From ~$49/mo' },
  { name: 'Outrank', bestFor: 'Solo founders, one site', editorialControl: 'None, autopilot', whiteLabel: 'No', ecommerce: 'Generic blog', price: '$99/mo' },
  { name: 'contentbird', bestFor: 'In-house B2B content teams', editorialControl: 'Approval workflow (no client sign-off)', whiteLabel: 'Paid add-on', ecommerce: 'Generic', price: 'From €399/mo' },
  { name: 'SEOwind', bestFor: 'Research-led long-form', editorialControl: 'Manual review', whiteLabel: 'WL content service', ecommerce: 'No', price: 'From $49/mo' },
  { name: 'Scalenut', bestFor: 'Budget all-in-one', editorialControl: 'Manual', whiteLabel: 'No', ecommerce: 'No', price: 'From $39/mo' },
  { name: 'Frase', bestFor: 'Content briefs + writing', editorialControl: 'Manual', whiteLabel: 'No', ecommerce: 'No', price: 'From $45/mo' },
];

const ALTORANK_VS_RANKYAK = [
  { feature: 'Publishing model', ours: 'Draft → review → approve, then publish (human gate)', theirs: 'Daily autopilot, AI publishes unsupervised' },
  { feature: 'Client sign-off', ours: 'Per-client reviewer can approve before anything goes live', theirs: 'None' },
  { feature: 'Audit trail', ours: 'Who approved + when, recorded', theirs: 'None' },
  { feature: 'Multi-client', ours: 'Isolated per-client workspaces', theirs: 'Multi-site, but no per-client editorial isolation' },
  { feature: 'Per-client voice', ours: 'AI-trained voice profile per client', theirs: 'Generic' },
  { feature: 'White-label', ours: 'Reports + portal, included at €199', theirs: 'Yes' },
  { feature: 'E-commerce', ours: 'Shopify/Woo native: product schema, collection SEO', theirs: 'Generic articles' },
  { feature: 'Penalty posture', ours: 'Approval gate = the answer to Google\'s scaled-content enforcement', theirs: 'Unattended AI volume, the exact risk Google penalised' },
  { feature: 'Source code', ours: 'Open source, self-hostable at no cost', theirs: 'Proprietary SaaS' },
  { feature: 'Editorial approval gate', ours: 'Required before anything publishes, by design', theirs: 'None confirmed' },
  { feature: 'AI-readiness audit', ours: 'Scores agent readiness, then generates the missing JSON-LD, markdown twins and llms.txt', theirs: 'None confirmed' },
];

interface Tool {
  index: string;
  name: string;
  ours?: boolean;
  url?: string;
  subtitle: string;
  whatItIs: string;
  bestFor: string;
  pricing: string;
  beatsRankyak: string;
  beatsTheirs: string;
}

const TOOLS: Tool[] = [
  {
    index: '01',
    name: APP_NAME,
    ours: true,
    subtitle: 'Best RankYak Alternative for Agencies That Need Editorial Control',
    whatItIs: 'An approval-first AI SEO content engine for e-commerce agencies. Same research → draft → publish pipeline, but with a human editorial-approval gate (and per-client client sign-off) between draft and a client\'s live site.',
    bestFor: 'Agencies producing SEO content for Shopify/WooCommerce clients who cannot publish unreviewed AI to a client\'s brand.',
    pricing: '€69/mo Managed (100 articles, model costs included, all CMS, rank tracking), €199/mo Agency (400 articles, unlimited client workspaces, white-label reports, referral traffic exchange).',
    beatsRankyak: '',
    beatsTheirs: 'RankYak is genuinely hands-off: if you want volume with zero review and you run your own sites, its daily autopilot is cheaper and simpler. AltoRank deliberately adds a human step, so it is not the tool for someone who wants to never look at the content.',
  },
  {
    index: '02',
    name: 'RankYak',
    url: 'https://rankyak.com',
    subtitle: 'Reference, EU Autopilot',
    whatItIs: 'A Netherlands-built tool that auto-researches keywords, builds a monthly plan, and publishes daily SEO articles on autopilot, with a white-label platform and multi-site support.',
    bestFor: 'Solo operators and small teams who want hands-off, high-volume content on their own sites.',
    pricing: 'From ~$49/mo. EU-based.',
    beatsRankyak: 'It is the cheapest, most hands-off way to ship daily articles, white-label and multi-site included. For your own sites, the autopilot is a feature.',
    beatsTheirs: `RankYak's autopilot is the opposite of what agencies need on client sites: no review step, no per-client editorial isolation, no client sign-off. Publishing unsupervised AI to a client's brand is precisely the behaviour Google's 2025 scaled-content enforcement penalised. ${APP_NAME} keeps the same pipeline but gates publishing behind human approval.`,
  },
  {
    index: '03',
    name: 'Outrank',
    url: 'https://www.outrank.so',
    subtitle: 'Single-Site Autopilot',
    whatItIs: 'A $99/mo AI SEO tool that drafts and auto-publishes articles for one site, with a backlink-exchange network and 9-CMS publishing.',
    bestFor: 'Solo founders running one blog or e-commerce site.',
    pricing: '$99/mo per site.',
    beatsRankyak: 'More mature ecosystem and a backlink network; better known, with more tutorials.',
    beatsTheirs: `Like RankYak, Outrank is autopilot and single-site, no multi-client workspaces, no per-client voice, no white-label, no approval gate. ${APP_NAME} is the open-source alternative Outrank isn't. See the dedicated /alternatives/outrank breakdown.`,
  },
  {
    index: '04',
    name: 'contentbird',
    url: 'https://contentbird.io',
    subtitle: 'B2B Content-Ops Suite',
    whatItIs: 'A 13-year Berlin content-operations suite with a workflow/approval engine, aimed at in-house B2B content teams.',
    bestFor: 'In-house B2B marketing teams wanting one broad all-in-one suite.',
    pricing: 'From €399/mo (no free trial).',
    beatsRankyak: 'A real approval workflow and a mature, broad suite, far more control than RankYak\'s autopilot.',
    beatsTheirs: `contentbird has approval but no client-facing sign-off or audit trail, is priced from €399 with white-label as a paid add-on, and is B2B-content-generic (no Shopify/Woo plumbing). ${APP_NAME} is e-commerce-agency-native at a quarter of the entry price. See /alternatives/contentbird.`,
  },
  {
    index: '05',
    name: 'SEOwind',
    url: 'https://seowind.io',
    subtitle: 'Research-Led Long-Form',
    whatItIs: 'An AI long-form article generator with a research-first workflow and a white-label content-production option.',
    bestFor: 'Agencies that mainly need well-researched long-form articles.',
    pricing: 'From $49/mo.',
    beatsRankyak: 'Stronger, research-led long-form than autopilot volume; EEAT-focused structure.',
    beatsTheirs: `SEOwind is a done-for-you content workflow, not a per-client SaaS workspace, no isolated client dashboards, no per-client rank tracking, no e-commerce plumbing. ${APP_NAME} gives each client an isolated, approval-gated, catalog-aware workspace.`,
  },
  {
    index: '06',
    name: 'Frase',
    url: 'https://www.frase.io',
    subtitle: 'Content Briefs + Research',
    whatItIs: 'A content brief and research tool, strong at building the brief a writer then uses.',
    bestFor: 'Teams that brief out to human writers.',
    pricing: 'From $45/mo.',
    beatsRankyak: 'Best-in-class briefs; a human writes the article, so quality control is inherent.',
    beatsTheirs: `Frase stops at the brief, no end-to-end publishing, no multi-client workspaces, no white-label, no e-commerce features. ${APP_NAME} runs brief → approve → publish per client.`,
  },
];

interface DecisionRow {
  when: string;
  pick: string;
  rationale: string;
  ours?: boolean;
}

const DECISION_MATRIX: DecisionRow[] = [
  { when: 'You run an agency publishing SEO content to client e-commerce sites', pick: APP_NAME, rationale: "You cannot ship unreviewed AI to a client's brand. Editorial approval + client sign-off + per-client workspaces + e-commerce-native content are exactly what RankYak's autopilot lacks.", ours: true },
  { when: 'You run your own sites and want hands-off daily volume', pick: 'Stick with RankYak', rationale: 'If no review step is a feature for you and there is no client brand at risk, RankYak is cheap and fully automated.' },
  { when: "You're a solo agency with one e-commerce client (and plans to grow)", pick: APP_NAME + ' Managed', rationale: '€69/mo with the approval gate + multi-client architecture + e-commerce features ready as you add clients.', ours: true },
  { when: 'You want a broad in-house B2B content-ops suite', pick: 'contentbird', rationale: 'Mature approval workflow and broad suite, if budget (€399+) and B2B fit aren\'t constraints.' },
  { when: 'You mainly need research-led long-form', pick: 'SEOwind', rationale: 'Research-first briefs and EEAT structure.' },
  { when: 'Your workflow is brief → human writer → publish', pick: 'Frase', rationale: 'Best brief generator; the human is your quality gate.' },
];

const FAQS = [
  { question: 'What is RankYak?', answer: "RankYak is a Netherlands-built AI SEO tool that auto-researches keywords, builds a monthly content plan, and publishes daily SEO articles on autopilot, with white-label and multi-site support. It is designed to be hands-off. There is no human review step between draft and publish." },
  { question: "What's the best RankYak alternative for agencies?", answer: `${APP_NAME}. RankYak is built for hands-off volume on your own sites; agencies publishing to client brands need an editorial-approval gate. ${APP_NAME} keeps the same research → draft → publish pipeline but requires human approval (and offers per-client client sign-off) before anything reaches a client's live site, plus per-client workspaces, white-label, and e-commerce-native content.` },
  { question: 'Is autopilot AI content safe for client sites?', answer: "It carries real risk. Google's 2025 scaled-content-abuse enforcement penalised sites that published large volumes of unreviewed AI content. For an agency, that risk lands on the client's brand. An editorial-approval gate, a human reviewing before publish, is the direct mitigation, which is why AltoRank is approval-first by design." },
  { question: 'Does AltoRank publish automatically like RankYak?', answer: `No, and that's the point. ${APP_NAME} drafts and schedules, but nothing publishes to a CMS until it has been approved. You get the speed of AI drafting with a human (and optional client) sign-off before it goes live.` },
  { question: 'Can I migrate from RankYak to AltoRank?', answer: `Yes. Both publish to common CMS platforms (WordPress, Shopify), so existing content stays live. Connect your CMS, set up per-client workspaces, and resume, with an approval gate in front of every publish. Typically a few hours of setup.` },
];

const structuredData = [
  buildArticleSchema({
    title: `${APP_NAME} vs. RankYak: 6 RankYak Alternatives Tested for Agencies (2026)`,
    description: 'RankYak publishes daily SEO articles on autopilot. For agencies publishing to client sites, AltoRank adds the editorial-approval gate RankYak lacks. We tested 6 RankYak alternatives.',
    publishDate,
    dateModified,
    author: AUTHOR_NAME,
    authorType: 'Person',
    authorUrl: AUTHOR_URL,
    url: pageUrl,
  }),
  buildFAQSchema(FAQS),
  buildItemListSchema(
    TLDR_ROWS.map((t) => ({
      name: t.name,
      description: `${t.bestFor}, starting at ${t.price}`,
    })),
  ),
];
---

<PSEO
  title="6 RankYak Alternatives for Agencies (2026)"
  description="RankYak publishes daily SEO articles on autopilot. For agencies publishing to client sites, we tested 6 alternatives across editorial control, white-label, and e-commerce fit."
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  {/* ── HERO ──────────────────────────────────────────── */}
  <header class="border-b border-line bg-[radial-gradient(600px_300px_at_88%_-10%,var(--accent-soft),transparent_70%),linear-gradient(180deg,var(--bg),var(--bg-2))] py-[72px]">
    <div class="mx-auto max-w-[820px] px-8">
      <h1 class="mb-6 text-[clamp(36px,5vw,52px)] font-semibold leading-[1.04] tracking-[-0.025em] text-ink [text-wrap:balance]">
        {APP_NAME} vs. RankYak: We Tested 6 RankYak Alternatives for Agencies (2026)
      </h1>
      <p class="mb-5 max-w-[680px] text-lg font-semibold leading-relaxed text-ink [text-wrap:pretty]">
        For agencies publishing to client sites, {APP_NAME} is the strongest RankYak alternative: it keeps a human editorial-approval gate (with per-client client sign-off) between draft and publish, where RankYak's daily autopilot ships unreviewed AI straight to live client sites.
      </p>
      <p class="mb-5 max-w-[680px] text-lg leading-relaxed text-ink-2 [text-wrap:pretty]">
        <a href="https://rankyak.com" target="_blank" rel="noopener noreferrer" class="text-ink underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-accent">RankYak</a> is an EU-built tool that auto-researches keywords and publishes daily SEO articles on autopilot. That's great for hands-off volume on your own sites, but an agency publishing to a <em>client's</em> brand can't ship unreviewed AI, especially after Google's 2025 scaled-content enforcement. The 6 RankYak alternatives below are ranked by <strong class="font-semibold text-ink">agency editorial-control criteria</strong>, with honest verdicts on when autopilot actually wins.
      </p>
      <p class="max-w-[680px] text-base leading-relaxed text-ink-2">
        If you run your own sites and want fully hands-off daily content, stick with RankYak, it's cheap and built for exactly that. If you publish to client brands, read on.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-line-soft pt-5 text-[13px] text-ink-3">
        <span>By <a href={AUTHOR_URL} target="_blank" rel="noopener noreferrer" class="font-medium text-ink-2 underline decoration-line decoration-1 underline-offset-[3px] transition-colors hover:text-ink hover:decoration-accent">{AUTHOR_NAME}</a></span>
        <span class="text-line">·</span>
        <span>Published <time datetime={publishDate.toISOString().slice(0, 10)}>{publishDateDisplay}</time></span>
        <span class="text-line">·</span>
        <span>16 min read</span>
      </div>
    </div>
  </header>

  {/* ── TL;DR TABLE ───────────────────────────────────── */}
  <section class="border-b border-line py-[72px]">
    <div class="mx-auto max-w-[1100px] px-8">
      <div class="mb-10">
        <h2 class="text-[clamp(28px,3.5vw,36px)] font-semibold leading-[1.1] tracking-[-0.02em] text-ink [text-wrap:balance]">
          The 7 tools at a glance
        </h2>
      </div>
      <div class="overflow-hidden rounded-lg border border-line bg-bg">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[820px] text-sm">
            <caption class="sr-only">Comparison of RankYak and 6 alternatives across editorial control, white-label, e-commerce fit, and starting price.</caption>
            <thead class="bg-panel text-left font-mono text-[11px] uppercase tracking-[0.06em] text-ink-2">
              <tr>
                <th scope="col" class="px-5 py-3.5 font-medium">Tool</th>
                <th scope="col" class="px-5 py-3.5 font-medium">Best for</th>
                <th scope="col" class="px-5 py-3.5 font-medium">Editorial control</th>
                <th scope="col" class="px-5 py-3.5 font-medium">White-label</th>
                <th scope="col" class="px-5 py-3.5 font-medium">E-commerce</th>
                <th scope="col" class="px-5 py-3.5 font-medium">Starting price</th>
              </tr>
            </thead>
            <tbody>
              {TLDR_ROWS.map((row, i) => (
                <tr class={`${i > 0 ? 'border-t border-line-soft' : ''} ${row.ours ? 'bg-accent-soft/30' : ''}`}>
                  <td class={`px-5 py-3.5 ${row.ours ? 'font-semibold text-ink' : 'text-ink-2'}`}>
                    {row.ours ? (
                      <span class="inline-flex items-center gap-2">
                        {row.name}
                        <span class="rounded-full bg-accent px-1.5 py-[1px] font-mono text-[9.5px] tracking-[0.08em] text-white">OURS</span>
                      </span>
                    ) : (
                      <span>{row.name}</span>
                    )}
                  </td>
                  <td class="px-5 py-3.5 text-ink-2">{row.bestFor}</td>
                  <td class="px-5 py-3.5 font-mono text-[12.5px] text-ink-2">{row.editorialControl}</td>
                  <td class="px-5 py-3.5 font-mono text-[12.5px] text-ink-2">{row.whiteLabel}</td>
                  <td class="px-5 py-3.5 font-mono text-[12.5px] text-ink-2">{row.ecommerce}</td>
                  <td class="px-5 py-3.5 font-mono text-[12.5px] text-ink-2">{row.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <Button href={SIGNUP_URL}>
  Add your domain with {APP_NAME}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="16" height="16"><path d="M5 12h14m0 0-6-6m6 6-6 6" /></svg>
</Button>
      </div>
    </div>
  </section>

  {/* ── WHY AGENCIES SEARCH ───────────────────────────── */}
  <section class="border-b border-line py-[88px]">
    <div class="mx-auto max-w-[820px] px-8">
      <div class="mb-10">
        <h2 class="text-[clamp(28px,3.5vw,36px)] font-semibold leading-[1.1] tracking-[-0.02em] text-ink [text-wrap:balance]">
          Why agencies search for RankYak alternatives
        </h2>
      </div>
      <div class="flex flex-col gap-4 text-[15.5px] leading-relaxed text-ink-2">
        <p>RankYak does one thing well: it publishes SEO articles on autopilot, every day, hands-off. For a solo operator on their own site, that's the whole appeal. For an agency, the same autopilot is the problem.</p>
        <h3 class="mt-6 mb-2 text-lg font-semibold tracking-[-0.015em] text-ink">No review step before a client's brand goes live</h3>
        <p>An agency is accountable for what publishes to a <span class="font-medium text-ink">client's</span> site. RankYak's model is draft → publish with no human in between, so the first time anyone reviews the article is after it's already live under the client's name. That's the opposite of how agencies sell content: they sell editorial judgment on top of automation.</p>
        <h3 class="mt-6 mb-2 text-lg font-semibold tracking-[-0.015em] text-ink">Unattended AI volume is now a penalty risk</h3>
        <p>Google's 2025 scaled-content-abuse enforcement penalised sites that shipped large volumes of unreviewed AI content, with 50–80% traffic drops and deindexing in the worst cases. When an agency runs autopilot on a client site, that risk lands on the client. An <span class="font-medium text-ink">approval gate</span> is the direct mitigation.</p>
        <h3 class="mt-6 mb-2 text-lg font-semibold tracking-[-0.015em] text-ink">No per-client isolation or e-commerce depth</h3>
        <p>RankYak is multi-site, but not multi-<span class="font-medium text-ink">client</span> in the way agencies need: no isolated per-client voice, no client-facing sign-off, no Shopify/WooCommerce product or collection content. Agencies running e-commerce clients end up doing the commerce-specific work by hand.</p>
        <p>None of this is a knock on RankYak for its audience. It's a structural mismatch for an agency publishing to client brands.</p>
      </div>
    </div>
  </section>

  {/* ── EVALUATION CRITERIA ───────────────────────────── */}
  <section class="border-b border-line py-[88px]">
    <div class="mx-auto max-w-[820px] px-8">
      <div class="mb-10">
        <h2 class="text-[clamp(28px,3.5vw,36px)] font-semibold leading-[1.1] tracking-[-0.02em] text-ink [text-wrap:balance]">
          How we evaluated each RankYak alternative
        </h2>
      </div>
      <div class="flex flex-col gap-4 text-[15.5px] leading-relaxed text-ink-2">
        <p>We scored each tool against the criteria that matter when you publish to client sites, not generic content quality:</p>
        <ol class="my-2 flex flex-col gap-2 pl-5 list-decimal">
          <li><strong class="font-semibold text-ink">Editorial control</strong>: is there a human approval gate (and client sign-off) before publish, or is it autopilot?</li>
          <li><strong class="font-semibold text-ink">Per-client isolation</strong>: isolated voice, workspace, and reporting per client?</li>
          <li><strong class="font-semibold text-ink">White-label</strong>, can the agency hand it to a client under its own brand?</li>
          <li><strong class="font-semibold text-ink">E-commerce depth</strong>, product/collection content + schema for Shopify/WooCommerce clients?</li>
        </ol>
        <p>We didn't score raw output quality. Every tool here can draft a publishable article. For an agency, the differentiation is control and accountability.</p>
      </div>
    </div>
  </section>

  {/* ── TOOL SECTIONS ─────────────────────────────────── */}
  {TOOLS.map((tool) => (
    <section class={`border-b border-line py-[72px] ${tool.ours ? 'bg-accent-soft/15' : ''}`}>
      <div class="mx-auto max-w-[820px] px-8">
        <div class="mb-2 flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">
          <span>Tool {tool.index}</span>
          {tool.ours && (
            <span class="rounded-full bg-accent px-1.5 py-[1px] font-mono text-[9.5px] tracking-[0.08em] text-white">OURS</span>
          )}
        </div>
        <h2 class="mb-2 text-[clamp(28px,3.5vw,34px)] font-semibold leading-[1.1] tracking-[-0.02em] text-ink [text-wrap:balance]">
          {tool.name}
        </h2>
        <p class="mb-7 text-base font-medium text-accent-ink">{tool.subtitle}</p>
        <div class="mb-5 grid gap-3 rounded-lg border border-line bg-bg p-5 sm:grid-cols-3">
          <div>
            <div class="mb-1.5 font-mono text-[10.5px] uppercase tracking-[0.08em] text-ink-3">What it is</div>
            <div class="text-[13.5px] leading-relaxed text-ink-2">{tool.whatItIs}</div>
          </div>
          <div>
            <div class="mb-1.5 font-mono text-[10.5px] uppercase tracking-[0.08em] text-ink-3">Best for</div>
            <div class="text-[13.5px] leading-relaxed text-ink-2">{tool.bestFor}</div>
          </div>
          <div>
            <div class="mb-1.5 font-mono text-[10.5px] uppercase tracking-[0.08em] text-ink-3">Pricing</div>
            <div class="text-[13.5px] leading-relaxed text-ink-2">{tool.pricing}</div>
          </div>
        </div>

        {tool.ours ? (
          <>
            <h3 class="mt-7 mb-4 font-mono text-[11px] uppercase tracking-[0.08em] text-ink-3">How {APP_NAME} differs from RankYak</h3>
            <div class="overflow-hidden rounded-lg border border-line bg-bg">
              <table class="w-full text-sm">
                <caption class="sr-only">{APP_NAME} versus RankYak, feature-by-feature comparison.</caption>
                <thead class="bg-panel text-left font-mono text-[10.5px] uppercase tracking-[0.06em] text-ink-2">
                  <tr>
                    <th scope="col" class="px-4 py-3 font-medium">Feature</th>
                    <th scope="col" class="px-4 py-3 font-medium">{APP_NAME}</th>
                    <th scope="col" class="px-4 py-3 font-medium">RankYak</th>
                  </tr>
                </thead>
                <tbody>
                  {ALTORANK_VS_RANKYAK.map((row, i) => (
                    <tr class={i > 0 ? 'border-t border-line-soft' : ''}>
                      <td class="px-4 py-3 text-ink">{row.feature}</td>
                      <td class="px-4 py-3 text-ink-2">{row.ours}</td>
                      <td class="px-4 py-3 font-mono text-[12.5px] text-ink-3">{row.theirs}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="mt-5 text-[15px] leading-relaxed text-ink-2">
              The difference isn't speed, both draft fast. It's that {APP_NAME} puts a human approval gate (and an optional per-client sign-off) between the draft and a client's live site, so an agency can sell editorial judgment, not just automation.
            </p>
            <p class="mt-4 text-[15px] leading-relaxed text-ink-2">
              {APP_NAME} Managed is €69/mo; <a href="/pricing" class="text-ink underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-accent">Agency at €199/mo</a> adds 400 articles a month, unlimited client workspaces, white-label reports, and rank tracking.
            </p>
            <h3 class="mt-7 mb-3 font-mono text-[11px] uppercase tracking-[0.08em] text-ink-3">Where {APP_NAME} loses</h3>
            <p class="text-[15px] leading-relaxed text-ink-2">{tool.beatsTheirs}</p>
            <div class="mt-7">
              <Button href={SIGNUP_URL}>
  {PRIMARY_CTA.label}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="16" height="16"><path d="M5 12h14m0 0-6-6m6 6-6 6" /></svg>
</Button>
            </div>
          </>
        ) : (
          <>
            <h3 class="mt-6 mb-3 font-mono text-[11px] uppercase tracking-[0.08em] text-ink-3">
              {tool.name === 'RankYak' ? 'Where RankYak wins' : `Where ${tool.name} differs from RankYak`}
            </h3>
            <p class="text-[15px] leading-relaxed text-ink-2">{tool.beatsRankyak}</p>
            <h3 class="mt-6 mb-3 font-mono text-[11px] uppercase tracking-[0.08em] text-ink-3">
              {tool.name === 'RankYak' ? `Where ${APP_NAME} wins` : `Where ${APP_NAME} beats ${tool.name}`}
            </h3>
            <p class="text-[15px] leading-relaxed text-ink-2">{tool.beatsTheirs}</p>
            {tool.url && (
              <p class="mt-6 text-[13px] text-ink-3">
                Visit <a href={tool.url} target="_blank" rel="noopener noreferrer" class="text-ink-2 underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-accent hover:text-ink">{tool.name}</a> for current pricing and feature details.
              </p>
            )}
          </>
        )}
      </div>
    </section>
  ))}

  {/* ── DECISION MATRIX ───────────────────────────────── */}
  <section class="border-b border-line py-[88px]">
    <div class="mx-auto max-w-[1100px] px-8">
      <div class="mb-10">
        <h2 class="text-[clamp(28px,3.5vw,36px)] font-semibold leading-[1.1] tracking-[-0.02em] text-ink [text-wrap:balance]">
          Which RankYak alternative should you choose?
        </h2>
        <p class="mt-3 max-w-[640px] text-base leading-relaxed text-ink-2">After the tool deep-dives, here's the short version.</p>
      </div>
      <div class="grid gap-3 md:grid-cols-2">
        {DECISION_MATRIX.map((row) => (
          <div class={`rounded-xl border p-5 ${row.ours ? 'border-accent bg-accent-soft/40' : 'border-line bg-bg'}`}>
            <div class="mb-2 font-mono text-[11px] uppercase tracking-[0.08em] text-ink-3">If</div>
            <div class="mb-3 text-[15px] font-medium text-ink">{row.when}</div>
            <div class="mb-1 font-mono text-[11px] uppercase tracking-[0.08em] text-accent-ink">Then</div>
            <div class="mb-2 text-lg font-semibold tracking-[-0.01em] text-ink">→ {row.pick}</div>
            <p class="text-sm leading-relaxed text-ink-2">{row.rationale}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── FAQ ───────────────────────────────────────────── */}
  <section class="border-b border-line py-[88px]">
    <div class="mx-auto max-w-[820px] px-8">
      <div class="mb-10">
        <h2 class="text-[clamp(28px,3.5vw,36px)] font-semibold leading-[1.1] tracking-[-0.02em] text-ink [text-wrap:balance]">
          Frequently asked questions
        </h2>
      </div>
      <div class="flex flex-col gap-3">
        {FAQS.map((f) => (
          <details class="group rounded-lg border border-line bg-bg p-5">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-[15px] font-medium text-ink list-none">
              <span>{f.question}</span>
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-panel text-ink-3 transition-transform group-open:rotate-45">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-2">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</PSEO>
