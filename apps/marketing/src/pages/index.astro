---
import Marketing from '@/layouts/Marketing.astro';
import Button from '@/components/shared/Button.astro';
import CTABanner from '@/components/shared/CTABanner.astro';
import AppShot from '@/components/shared/AppShot.astro';
import { APP_NAME, PRIMARY_CTA, APP_URL, SIGNUP_URL } from '@/constants';
import { buildProductSchema, buildFAQSchema } from '@/lib/schema';
import { STEPS, COMPARISON, COMPARISON_THEM, CMS_LIST, READINESS_SCAN, STATS, REPLACES, MORE_FEATURES, CMS_BLURB, HOME_FAQ } from '@/data/homepage';
import { PLANS } from '@/data/pricing';

// Base.astro already auto-injects Organization + WebSite + WebPage on every
// page, so passing buildOrganizationSchema() here emitted a duplicate
// Organization node on the homepage only. Dropped 2026-08-15.
const structuredData = [buildProductSchema(), buildFAQSchema(HOME_FAQ)];
---

<Marketing
  title="AltoRank | Open-source AI SEO content engine"
  description="Articles that rank, published to your site every week. Free growth plan for any domain in 60 seconds. Keyword research, drafts in your voice, publishing to eleven CMSs. Open source, self-host it free."
  structuredData={structuredData}
  headerOverlay
>
  {/* ── HERO ─────────────────────────────────────────────────────────────
      One claim, one action, one screenshot. The previous hero opened with a
      pill above the h1, ran two CTAs plus a caveat, and put a drawn dashboard
      beside the copy; this one puts the product under the fold line so the
      page reads as a window into something real rather than an illustration.  */}
  <header class="relative overflow-hidden border-b border-line bg-[radial-gradient(760px_400px_at_50%_-14%,oklch(0.46_0.17_275/0.85),transparent_68%),linear-gradient(178deg,oklch(0.24_0.09_275),oklch(0.155_0.02_275)_62%)] -mt-14 px-5 pt-[112px] text-center sm:px-6 lg:-mt-16 lg:pt-[148px]">
    <div class="mx-auto max-w-[1240px]">
      <h1 class="mx-auto mb-4 max-w-[19ch] text-[clamp(30px,7vw,52px)] font-medium leading-[1.12] tracking-[-0.028em] text-white [text-wrap:balance] sm:mb-5">
        Articles that rank, published to your site every week.
      </h1>

      <p class="mx-auto mb-7 max-w-[52ch] text-[15.5px] leading-relaxed text-[oklch(0.82_0.03_275)] [text-wrap:pretty] sm:text-[17px] md:mb-8">
        Point it at a domain Monday. First article live by Friday. Keyword
        research, drafts in your voice, publishing to eleven CMSs. Open source,
        self-host it free.
      </p>

      {/* The hook. RankPill's "free growth plan in 60 seconds, no signup" is
          the one thing on the autopilot tools' pages that turns the visitor's
          own site into the proof, and it is the one thing this page can do
          with zero customers: every line the plan returns names a URL or a
          term on the visitor's site. The form posts cross-origin to the app;
          the results render here. No email gate before the result, because a
          gated result is a promise and a visible one is an outcome. */}
      <form
        id="growth-plan-form"
        class="mx-auto flex max-w-[560px] flex-col gap-2.5 sm:flex-row"
        data-api={`${APP_URL}/api/growth-plan`}
        data-lead={`${APP_URL}/api/growth-plan/lead`}
        data-signup={SIGNUP_URL}
        novalidate
      >
        <label for="growth-plan-domain" class="sr-only">Your domain</label>
        <input
          id="growth-plan-domain"
          name="domain"
          type="text"
          inputmode="url"
          autocomplete="url"
          spellcheck="false"
          required
          placeholder="yourdomain.com"
          class="h-12 flex-1 rounded-[9px] border border-white/15 bg-white/[0.07] px-4 text-[15px] text-white placeholder:text-[oklch(0.68_0.03_275)] focus:border-white/40 focus:outline-none focus:ring-[3px] focus:ring-white/10"
        />
        <button
          type="submit"
          class="inline-flex h-12 shrink-0 cursor-pointer items-center justify-center gap-1.5 rounded-[9px] bg-white px-5 text-[15px] font-medium text-[oklch(0.2_0.06_275)] transition-colors hover:bg-[oklch(0.94_0.01_275)] disabled:cursor-wait disabled:opacity-70"
        >
          <span data-label>Get my growth plan</span>
        </button>
      </form>

      <p class="mb-9 mt-4 text-[12.5px] text-[oklch(0.68_0.03_275)] sm:text-[13px] md:mb-12">
        Free. About 60 seconds. No signup. Or <a href={PRIMARY_CTA.href} class="underline decoration-white/30 underline-offset-[3px] hover:decoration-white">add your domain</a> and self-host it free.
      </p>
      {/* The category puts avatars, five stars and "750m+ views" here. We put
          the one number we can defend, and the licence. */}
      <p class="-mt-6 mb-10 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[12.5px] text-[oklch(0.78_0.03_275)] md:mb-12">
        <span>{READINESS_SCAN.sites} sites scanned</span>
        <span aria-hidden="true" class="text-[oklch(0.5_0.03_275)]">&middot;</span>
        <span>{READINESS_SCAN.failedEverything} unreadable by AI</span>
        <span aria-hidden="true" class="text-[oklch(0.5_0.03_275)]">&middot;</span>
        <a href="/open-source" class="underline decoration-white/30 underline-offset-[3px] hover:decoration-white">Open source, self-host free</a>
      </p>

      {/* Results land here. Hidden until there is something to show, so the
          page reads exactly as before for anyone who never types a domain. */}
      <section
        id="growth-plan"
        hidden
        aria-live="polite"
        class="mx-auto mb-10 max-w-[1040px] text-left md:mb-14"
      ></section>

      <AppShot />
    </div>
  </header>

  {/* Sentinel for the header overlay. It needs real height: a zero-area
      element can never intersect, so the observer fires once and never again.
      -mb-px cancels the 1px it costs the layout. */}
  <div data-header-overlay-end aria-hidden="true" class="h-px -mb-px"></div>

  {/* ── PROOF ─────────────────────────────────────────────────────────────
      The category opens with four customer testimonials and a stat bar
      ("750,000+ articles"). We have no customers to quote, so this slot holds
      the one dataset we actually own: the readiness scan. Every number names
      its source in data/homepage.ts. A testimonial block goes here the day a
      real customer says something, and not one commit before.               */}
  <section id="proof" class="border-b border-line py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">What we measured</p>
      <h2 class="mb-3 max-w-[24ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Most sites cannot be <span class="text-accent-ink">read by AI</span> at all.
      </h2>
      <p class="mb-8 max-w-[60ch] md:mb-11 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
        We scanned {READINESS_SCAN.sites} agency sites for the nine technical signals an AI assistant
        needs to read a page. {READINESS_SCAN.failedEverything} failed every one. That is the gap the
        product is built to close, and it is the only statistic on this page, because it is the only
        one we have earned.
      </p>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
        {STATS.map((s) => (
          <div class="rounded-lg border border-line bg-panel p-5">
            <div class="text-[clamp(30px,4.5vw,44px)] font-semibold leading-none tracking-[-0.03em] text-ink">{s.value}</div>
            <div class="mt-2 text-[13.5px] leading-snug text-ink-2">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── PROBLEM / SOLUTION ───────────────────────────────────────────────  */}
  <section id="replaces" class="border-b border-line bg-panel py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">Your problem, our solution</p>
      <h2 class="mb-3 max-w-[22ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Six tools and a spreadsheet, <span class="text-accent-ink">or one workspace</span>.
      </h2>
      <p class="mb-8 max-w-[58ch] md:mb-11 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
        Every row is a capability that exists in the product today, not on a roadmap.
      </p>
      <div class="overflow-hidden rounded-lg border border-line bg-bg">
        {REPLACES.map((r, i) => (
          <div class={`grid gap-1 p-5 sm:grid-cols-[1fr_1.8fr] sm:gap-6 ${i > 0 ? 'border-t border-line-soft' : ''}`}>
            <div class="text-[14px] text-ink-3 line-through decoration-line-soft sm:no-underline sm:text-ink-2">
              <span class="sm:hidden">Replaces: </span>{r.tool}
            </div>
            <div class="text-[14.5px] font-medium leading-relaxed text-ink">{r.ours}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── HOW IT WORKS ─────────────────────────────────────────────────────  */}
  <section id="how-it-works" class="border-b border-line py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">How it works</p>
      <h2 class="mb-3 max-w-[20ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Four steps. <span class="text-accent-ink">You own the third.</span>
      </h2>
      <p class="mb-8 max-w-[58ch] md:mb-11 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
        Research, plan and draft are automatic. Approval is not, and cannot be made so.
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {STEPS.map((step) => (
          <div class={`rounded-lg border p-5 sm:p-6 ${step.n === 3 ? 'border-accent bg-accent-soft/40' : 'border-line bg-bg'}`}>
            <div class="mb-3 font-mono text-[12px] text-accent-ink">0{step.n}</div>
            <h3 class="mb-2.5 text-[17px] font-semibold tracking-[-0.015em]">{step.title}</h3>
            <p class="text-sm leading-relaxed text-ink-2">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── COMPARISON (kept) ────────────────────────────────────────────────  */}
  <section id="vs" class="border-b border-line bg-panel py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">Versus the autopilot tools</p>
      <h2 class="mb-3 max-w-[22ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Same job as the autopilot tools. Opposite answer on <span class="text-accent-ink">who presses publish</span>.
      </h2>
      <p class="mb-8 max-w-[58ch] md:mb-11 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
        {COMPARISON_THEM} all open with the word &ldquo;autopilot&rdquo;. Every row below is checkable
        against their own homepages, and the full head-to-heads are on{' '}
        <a href="/compare" class="text-ink underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-accent">the compare page</a>.
      </p>
      <div class="flex flex-col gap-3 md:hidden">
        {COMPARISON.map((row) => (
          <div class="rounded-lg border border-line bg-bg p-4">
            <div class="text-[13px] font-semibold text-ink">{row.label}</div>
            <dl class="mt-3 flex flex-col gap-2.5">
              <div><dt class="text-[12px] text-ink-3">{COMPARISON_THEM}</dt><dd class="ml-0 text-[14px] text-ink-3">{row.legacy}</dd></div>
              <div><dt class="text-[12px] text-accent-ink">{APP_NAME}</dt><dd class="ml-0 text-[14px] font-medium text-ink">{row.ours}</dd></div>
            </dl>
          </div>
        ))}
      </div>
      <div class="hidden overflow-hidden rounded-lg border border-line bg-bg md:block">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-line bg-panel text-ink-2">
            <tr>
              <th scope="col" class="px-5 py-3.5 font-medium"></th>
              <th scope="col" class="px-5 py-3.5 font-medium">{COMPARISON_THEM}</th>
              <th scope="col" class="px-5 py-3.5 font-medium text-accent-ink">{APP_NAME}</th>
            </tr>
          </thead>
          <tbody>
            {COMPARISON.map((row, i) => (
              <tr class={i > 0 ? 'border-t border-line-soft' : ''}>
                <th scope="row" class="px-5 py-4 font-semibold text-ink">{row.label}</th>
                <td class="px-5 py-4 text-ink-3">{row.legacy}</td>
                <td class="px-5 py-4 font-medium text-ink">{row.ours}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* ── OPEN SOURCE ──────────────────────────────────────────────────────  */}
  <section id="open-source" class="border-b border-line py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <div class="grid items-start gap-10 lg:gap-12 lg:grid-cols-[1.15fr_1fr]">
        <div>
          <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">Open source</p>
          <h2 class="mb-4 max-w-[22ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
            Run it yourself, put your brand on it, keep the margin.
          </h2>
          <p class="mb-6 max-w-[56ch] md:mb-7 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
            {APP_NAME} is going open source with the whole product in the open:
            multi-client workspaces, white-label reporting and the approval gate
            all sit in the free self-hosted build, not behind a paid tier.
            You get the whole execution layer without a licence conversation. We
            get paid when you would rather not run it yourself.
          </p>
          <Button href="/open-source" variant="secondary" arrow>
  What open source means for you
</Button>
        </div>

        <div class="overflow-hidden rounded-lg border border-line bg-bg">
          <ul>
            {[
              'Multi-client workspaces',
              'White-label reports',
              'All 12 publishing destinations',
              'Editorial approval gate',
              'The SEO scoring algorithm, readable',
            ].map((item, i) => (
              <li
                class={`flex items-center gap-3 px-5 py-3.5 text-[14px] text-ink-2 ${
                  i > 0 ? 'border-t border-line-soft' : ''
                }`}
              >
                <svg
                  class="h-4 w-4 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--ok)"
                  stroke-width="2.2"
                >
                  <path d="M5 12.5 10 17 19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <p class="border-t border-line px-5 py-4 text-[13px] leading-relaxed text-ink-3">
            No <code class="rounded bg-panel-2 px-1 py-0.5 font-mono text-[0.85em]">ee/</code>
            directory. No paid tier held back from the source.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── LINKS ─────────────────────────────────────────────────────────────
      The category sells a "Backlink Exchange" here. apps/web/lib/seo/exchange.ts
      implements one, so we say so; it is small and every placement is
      human-approved, so we say that too.                                      */}
  <section id="links" class="border-b border-line bg-panel py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-14">
        <div>
          <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">Authority</p>
          <h2 class="mb-4 max-w-[20ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
            Links, with a <span class="text-accent-ink">person in the loop</span>.
          </h2>
          <p class="mb-5 max-w-[56ch] text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
            Every article links to your existing pages, chosen from your sitemap. Between sites, a
            credit-based exchange proposes matches and scores relevance &mdash; and then a person
            accepts, places and verifies each link before any credit moves.
          </p>
          <p class="max-w-[56ch] text-[14.5px] leading-relaxed text-ink-3 [text-wrap:pretty]">
            It is small, because we are early. We would rather say so than sell a network that is not
            there yet.
          </p>
        </div>
        <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
          {[
            { h: 'Internal links in every draft', p: 'From the pages you already have, not invented anchors.' },
            { h: 'Relevance scored, never automatic', p: 'The software proposes. A human accepts, places and verifies.' },
            { h: 'Verified before it counts', p: 'A link is checked live on the page before a credit moves.' },
          ].map((c) => (
            <div class="rounded-lg border border-line bg-panel p-5">
              <div class="mb-1.5 text-[15px] font-semibold text-ink">{c.h}</div>
              <p class="text-[13.5px] leading-relaxed text-ink-2">{c.p}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ── INTEGRATIONS ─────────────────────────────────────────────────────  */}
  <section id="integrations" class="border-b border-line py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">Integrations</p>
      <h2 class="mb-3 max-w-[20ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        One click to <span class="text-accent-ink">any platform</span>.
      </h2>
      <p class="mb-8 max-w-[58ch] md:mb-11 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
        A connection is a destination, not a permission. Each one uses a credential you create and can
        revoke yourself, and nothing publishes to it until you approve the draft.
      </p>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {CMS_LIST.map((cms) => (
          <a
            href={cms.soon ? '/integrations' : `/integrations`}
            class:list={[
              'group flex items-center gap-3 rounded-lg border p-4 transition-colors',
              cms.soon ? 'border-dashed border-line bg-transparent' : 'border-line bg-bg hover:border-accent',
            ]}
          >
            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded border border-line bg-panel font-mono text-[11px] font-medium text-ink-2">{cms.code}</span>
            <span class="min-w-0">
              <span class="block truncate text-[14.5px] font-semibold text-ink group-hover:text-accent-ink">
                {cms.name}{cms.soon && <span class="ml-1.5 font-mono text-[10px] uppercase tracking-[0.04em] text-ink-3">Soon</span>}
              </span>
              <span class="block truncate text-[12.5px] text-ink-3">{CMS_BLURB[cms.code]}</span>
            </span>
          </a>
        ))}
      </div>
      <p class="mt-5 text-[14px] text-ink-3">
        Setup guides for WordPress, Shopify, Ghost and the webhook are in{' '}
        <a href="/docs" class="text-ink-2 underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-accent">the docs</a>.
      </p>
    </div>
  </section>

  {/* ── MORE FEATURES ────────────────────────────────────────────────────  */}
  <section id="features" class="border-b border-line bg-panel py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">Everything else</p>
      <h2 class="mb-8 max-w-[24ch] md:mb-11 text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Built to be <span class="text-accent-ink">read</span>, not just run.
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {MORE_FEATURES.map((f) => (
          <div class="flex flex-col rounded-lg border border-line bg-bg p-5 sm:p-6">
            <h3 class="mb-2.5 text-[17px] font-semibold leading-snug tracking-[-0.018em] [text-wrap:balance]">{f.title}</h3>
            <p class="text-[14px] leading-relaxed text-ink-2">{f.desc}</p>
            {f.href && (
              <a href={f.href} class="mt-4 inline-flex items-center gap-1.5 text-[13.5px] font-medium text-accent-ink underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-accent">
                Read more <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── EXAMPLES ─────────────────────────────────────────────────────────  */}
  <section id="examples" class="border-b border-line py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 text-center sm:px-6 lg:px-8">
      <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">Examples</p>
      <h2 class="mx-auto mb-4 max-w-[22ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Read what it writes <span class="text-accent-ink">before you trust it</span>.
      </h2>
      <p class="mx-auto mb-7 max-w-[56ch] text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
        Our own blog is produced by the product, approved by a person, and published through the same
        gate every customer gets. Every claim in it cites a source that resolves.
      </p>
      <Button href="/blog" variant="secondary" size="lg" arrow>Visit the blog</Button>
    </div>
  </section>

  {/* ── AI VISIBILITY ────────────────────────────────────────────────────  */}
  <section id="ai" class="border-b border-line bg-panel py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">AI search</p>
      <h2 class="mb-3 max-w-[20ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Make AI assistants <span class="text-accent-ink">recommend you</span>.
      </h2>
      <p class="mb-8 max-w-[58ch] md:mb-11 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
        ChatGPT, Perplexity and AI Overviews cite pages they can read, extract and attribute. Most sites
        fail the first step.
      </p>
      <div class="grid gap-4 md:grid-cols-3">
        {[
          { h: 'How an assistant chooses', p: 'It reads the pages a search returns, extracts a passage it can attribute, and cites the source it can verify. Pages it cannot parse are simply not in the running.' },
          { h: 'What we do about it', p: `Nine technical checks on whether your site can be read at all, fixed rather than scored. Then articles structured to be extractable: a direct answer up top, headings shaped like questions, schema that describes rather than disguises.` },
          { h: 'Why now', p: 'Assistants form their preferences from what already ranks and already parses. The sites that are readable this year are the ones cited next year.' },
        ].map((c) => (
          <div class="rounded-lg border border-line bg-bg p-5 sm:p-6">
            <h3 class="mb-2.5 text-[17px] font-semibold tracking-[-0.015em]">{c.h}</h3>
            <p class="text-[14px] leading-relaxed text-ink-2">{c.p}</p>
          </div>
        ))}
      </div>
      <div class="mt-7">
        <Button href="/geo" variant="secondary" arrow>The GEO guides</Button>
      </div>
    </div>
  </section>

  {/* ── PRICING ──────────────────────────────────────────────────────────
      Renders from data/pricing.ts so this and /pricing cannot drift. The
      struck-through "was" price the category shows is absent on purpose: a
      price we never charged is a fabricated discount.                         */}
  <section id="pricing" class="border-b border-line py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">Pricing</p>
      <h2 class="mb-3 max-w-[22ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Free to run yourself. <span class="text-accent-ink">Paid to have it run for you.</span>
      </h2>
      <p class="mb-8 max-w-[58ch] md:mb-11 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
        No trial that converts. Nothing is charged until you choose a plan, and cancelling is a button.
      </p>
      <div class="grid gap-4 md:grid-cols-3">
        {PLANS.map((plan) => (
          <div class="flex flex-col rounded-lg border border-line bg-bg p-6">
            <div class="mb-1 text-[13px] font-medium text-ink-3">{plan.name}</div>
            <div class="mb-3 text-[clamp(30px,4vw,40px)] font-semibold leading-none tracking-[-0.03em] text-ink">
              {plan.price}<span class="text-[14px] font-normal text-ink-3">{plan.price === '€0' ? '' : '/mo'}</span>
            </div>
            <p class="mb-5 text-[14px] leading-relaxed text-ink-2">{plan.desc}</p>
            <ul class="mb-6 flex flex-col gap-2">
              {plan.features.slice(0, 4).map((f) => (
                <li class="flex gap-2.5 text-[13.5px] leading-snug text-ink-2">
                  <svg viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="2.2" class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true"><path d="M5 12.5 10 17 19 7" /></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto">
              <Button href="/pricing" variant="secondary" block>See the full plan</Button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── FAQ ──────────────────────────────────────────────────────────────  */}
  <section id="faq" class="border-b border-line bg-panel py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[820px] px-5 sm:px-6 lg:px-8">
      <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">FAQ</p>
      <h2 class="mb-8 text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink">
        Have questions?
      </h2>
      <div class="flex flex-col gap-2">
        {HOME_FAQ.map((item) => (
          <details class="group rounded-lg border border-line bg-bg">
            <summary class="cursor-pointer list-none px-5 py-4 text-[15px] font-medium text-ink [&::-webkit-details-marker]:hidden">{item.question}</summary>
            <p class="border-t border-line-soft px-5 py-4 text-[14.5px] leading-relaxed text-ink-2">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Marketing>

<script>
  // ClientRouter swaps the document without re-executing module scripts,
  // so this re-binds the form each time the homepage is navigated to.
  // Every listener below is bound to an element inside the swapped DOM,
  // which takes them with it when it goes: nothing to tear down.
  document.addEventListener('astro:page-load', () => {

  // The growth plan hook. Progressive in the only way that matters here: with
  // no script the form still submits nowhere harmful (novalidate, no action),
  // and the rest of the page is unchanged.
  const form = document.getElementById("growth-plan-form") as HTMLFormElement | null;
  const out = document.getElementById("growth-plan");
  if (form && out) {
    // Read at submit time, not load time, so the endpoints are one attribute
    // to point elsewhere (a local API while developing, a staging app).
    const endpoints = () => ({ api: form.dataset.api!, leadApi: form.dataset.lead!, signup: form.dataset.signup! });
    const input = form.querySelector<HTMLInputElement>("input[name=domain]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const label = button.querySelector<HTMLElement>("[data-label]")!;

    const esc = (s: unknown) =>
      String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
    const n = (v: number | null) => (v === null || v === undefined ? "—" : v.toLocaleString("en-US"));
    const clean = (d: string) => d.trim().toLowerCase().replace(/^https?:\/\//, "").replace(/^www\./, "").replace(/[/?#].*$/, "");

    const card = (title: string, sub: string, body: string) => `
      <div class="rounded-xl border border-white/12 bg-white/[0.05] p-5 sm:p-6">
        <h3 class="text-[15px] font-semibold text-white">${title}</h3>
        <p class="mb-4 mt-1 text-[13px] leading-relaxed text-[oklch(0.72_0.03_275)]">${sub}</p>
        ${body}
      </div>`;
    const empty = (msg: string) => `<p class="text-[13.5px] text-[oklch(0.78_0.03_275)]">${msg}</p>`;
    const row = (l: string, r: string) =>
      `<li class="flex items-baseline justify-between gap-4 border-t border-white/10 py-2.5 text-[13.5px] first:border-t-0"><span class="text-white">${l}</span><span class="shrink-0 font-mono text-[12px] text-[oklch(0.78_0.03_275)]">${r}</span></li>`;

    const render = (plan: any) => {
      const { leadApi, signup } = endpoints();
      const d = esc(plan.domain);
      const ranked = plan.layers?.find((l: any) => l.id === "ranked");
      const wins = plan.closestWins ?? [];
      const gaps = plan.gaps ?? [];
      const failing = plan.readiness?.failing ?? [];
      const artifacts = (plan.readiness?.artifacts ?? []).filter((a: any) => a.body);

      const winsBody = wins.length
        ? `<ul>${wins.map((w: any) => row(`${esc(w.keyword)} <span class="text-[oklch(0.68_0.03_275)]">· ${esc(w.path)}</span>`, `#${w.position} · ${n(w.volume)}/mo`)).join("")}</ul>`
        : ranked && !ranked.ok
          ? empty("No rank data came back for this domain.")
          : plan.rankingKeywords
            ? empty(`${n(plan.rankingKeywords)} ranking terms found, none sitting on page two right now. The gaps are where the work is.`)
            : empty("Nothing ranking yet. Every article is a first one, so the gaps below are the plan.");

      const gapsBody = gaps.length
        ? `<ul>${gaps.map((g: any) => row(esc(g.keyword), `${n(g.volume)}/mo · ${g.rankedBy.map((r: any) => `${esc(r.domain)} #${r.position}`).join(", ")}`)).join("")}</ul>`
        : empty(plan.competitors?.length ? "Nothing on page one for your competitors that you lack." : "No organic competitors could be identified for this domain yet.");

      const readyBody = plan.readiness?.error
        ? empty(esc(plan.readiness.error))
        : `<p class="mb-3 text-[28px] font-semibold leading-none text-white">${plan.readiness.score}<span class="text-[14px] font-normal text-[oklch(0.68_0.03_275)]">/100</span></p>` +
          (failing.length
            ? `<ul>${failing.map((f: any) => row(esc(f.check.replace(/_/g, " ")), "")).join("")}</ul>` +
              (artifacts.length ? `<p class="mt-3 text-[12.5px] text-[oklch(0.72_0.03_275)]">${artifacts.length} fix${artifacts.length === 1 ? "" : "es"} generated, ready to paste. They come with the full plan.</p>` : "")
            : empty("Every check passes. AI assistants can read this site."));

      const targets = (plan.cadence?.firstTargets ?? []).map(esc);
      out.innerHTML = `
        <p class="mb-4 font-mono text-[11px] uppercase tracking-[0.08em] text-[oklch(0.72_0.03_275)]">Growth plan for ${d}${plan.cached ? " · cached today" : ""}</p>
        <div class="grid gap-3 md:grid-cols-3">
          ${card("Closest wins", "Terms you already rank for on page two. One revision from page one.", winsBody)}
          ${card("Gaps", `What ${plan.competitors?.map((c: any) => esc(c.domain)).join(" and ") || "competitors"} rank for on page one and you do not.`, gapsBody)}
          ${card("Can AI read your site?", "Nine checks: crawler rules, structured data, a machine-readable copy.", readyBody)}
        </div>
        <div class="mt-4 rounded-xl border border-white/12 bg-white/[0.05] p-5 sm:p-6">
          <p class="text-[14.5px] leading-relaxed text-white">
            ${plan.cadence?.articlesPerMonth ?? 4} articles a month${targets.length ? `, starting with <em class="font-display-italic">${targets.join("</em>, <em class=\"font-display-italic\">")}</em>` : ""}. First one published in ${plan.cadence?.firstPublishDays ?? 5} working days, after you approve it.
          </p>
          <div class="mt-4 flex flex-col gap-2.5 sm:flex-row sm:items-center">
            <a href="${signup}?domain=${encodeURIComponent(plan.domain)}" class="inline-flex h-11 items-center justify-center rounded-[9px] bg-white px-5 text-[14px] font-medium text-[oklch(0.2_0.06_275)] hover:bg-[oklch(0.94_0.01_275)]">Start publishing against this plan &rarr;</a>
            <form id="growth-plan-lead" class="flex flex-1 gap-2">
              <input name="email" type="email" required placeholder="you@company.com" class="h-11 min-w-0 flex-1 rounded-[9px] border border-white/15 bg-white/[0.07] px-3.5 text-[14px] text-white placeholder:text-[oklch(0.68_0.03_275)] focus:border-white/40 focus:outline-none" />
              <button type="submit" class="h-11 shrink-0 cursor-pointer rounded-[9px] border border-white/25 px-4 text-[14px] text-white hover:bg-white/10">Email me the full plan</button>
            </form>
          </div>
          <p data-lead-status class="mt-2 min-h-[1.2em] text-[12.5px] text-[oklch(0.72_0.03_275)]"></p>
        </div>`;
      out.hidden = false;

      const lead = document.getElementById("growth-plan-lead") as HTMLFormElement | null;
      const status = out.querySelector<HTMLElement>("[data-lead-status]")!;
      lead?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = (lead.querySelector<HTMLInputElement>("input[name=email]")!).value.trim();
        status.textContent = "Sending…";
        try {
          const res = await fetch(leadApi, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email, domain: plan.domain }) });
          const body = await res.json();
          status.textContent = !res.ok
            ? body.error ?? "Could not save that."
            : body.emailed
              ? "Sent. The full plan, generated fixes included, is in your inbox."
              : "Saved. We will email you the full plan.";
        } catch {
          status.textContent = "Could not reach the server. Try again.";
        }
      });
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const domain = clean(input.value);
      if (!/^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*\.[a-z]{2,}$/.test(domain)) {
        out.innerHTML = empty("That does not look like a domain. Try example.com.");
        out.hidden = false;
        input.focus();
        return;
      }
      const { api } = endpoints();
      button.disabled = true;
      label.textContent = "Reading your site…";
      out.innerHTML = empty(`Checking what ${esc(domain)} ranks for, who else ranks for it, and whether AI assistants can read it. About 60 seconds at most, usually a few.`);
      out.hidden = false;
      try {
        const res = await fetch(api, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ domain }) });
        const body = await res.json();
        if (!res.ok) {
          out.innerHTML = empty(esc(body.error ?? "Could not build a plan for that domain right now."));
        } else {
          render(body);
        }
      } catch {
        out.innerHTML = empty("Could not reach the server. Try again in a moment.");
      } finally {
        button.disabled = false;
        label.textContent = "Get my growth plan";
      }
    });
  }
  });
</script>
