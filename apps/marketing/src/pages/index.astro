---
import Marketing from '@/layouts/Marketing.astro';
import Button from '@/components/shared/Button.astro';
import CTABanner from '@/components/shared/CTABanner.astro';
import AppShot from '@/components/shared/AppShot.astro';
import { APP_NAME, OSS_LICENSE, PRIMARY_CTA, APP_URL, SIGNUP_URL } from '@/constants';
import { buildProductSchema } from '@/lib/schema';
import { STEPS, COMPARISON, COMPARISON_THEM, CMS_LIST, LOCALE_COUNT, READINESS_SCAN } from '@/data/homepage';

// Base.astro already auto-injects Organization + WebSite + WebPage on every
// page, so passing buildOrganizationSchema() here emitted a duplicate
// Organization node on the homepage only. Dropped 2026-08-15.
const structuredData = [buildProductSchema()];
---

<Marketing
  title="AltoRank | Open-source AI SEO content engine"
  description="Articles that rank, published to your site every week. Free growth plan for any domain in 60 seconds. Keyword research, drafts in your voice, publishing to eleven CMSs. Open source, self-host it free."
  structuredData={structuredData}
  headerOverlay
>
  {/* ── HERO ─────────────────────────────────────────────────────────────
      One claim, one action, one screenshot. The previous hero opened with a
      pill above the h1, ran two CTAs plus a caveat, and put a drawn dashboard
      beside the copy; this one puts the product under the fold line so the
      page reads as a window into something real rather than an illustration.  */}
  <header class="relative overflow-hidden border-b border-line bg-[radial-gradient(760px_400px_at_50%_-14%,oklch(0.46_0.17_275/0.85),transparent_68%),linear-gradient(178deg,oklch(0.24_0.09_275),oklch(0.155_0.02_275)_62%)] -mt-14 px-5 pt-[112px] text-center sm:px-6 lg:-mt-16 lg:pt-[148px]">
    <div class="mx-auto max-w-[1240px]">
      <h1 class="mx-auto mb-4 max-w-[19ch] text-[clamp(30px,7vw,52px)] font-medium leading-[1.12] tracking-[-0.028em] text-white [text-wrap:balance] sm:mb-5">
        Articles that rank, published to your site every week.
      </h1>

      <p class="mx-auto mb-7 max-w-[52ch] text-[15.5px] leading-relaxed text-[oklch(0.82_0.03_275)] [text-wrap:pretty] sm:text-[17px] md:mb-8">
        Point it at a domain Monday. First article live by Friday. Keyword
        research, drafts in your voice, publishing to eleven CMSs. Open source,
        self-host it free.
      </p>

      {/* The hook. RankPill's "free growth plan in 60 seconds, no signup" is
          the one thing on the autopilot tools' pages that turns the visitor's
          own site into the proof, and it is the one thing this page can do
          with zero customers: every line the plan returns names a URL or a
          term on the visitor's site. The form posts cross-origin to the app;
          the results render here. No email gate before the result, because a
          gated result is a promise and a visible one is an outcome. */}
      <form
        id="growth-plan-form"
        class="mx-auto flex max-w-[560px] flex-col gap-2.5 sm:flex-row"
        data-api={`${APP_URL}/api/growth-plan`}
        data-lead={`${APP_URL}/api/growth-plan/lead`}
        data-signup={SIGNUP_URL}
        novalidate
      >
        <label for="growth-plan-domain" class="sr-only">Your domain</label>
        <input
          id="growth-plan-domain"
          name="domain"
          type="text"
          inputmode="url"
          autocomplete="url"
          spellcheck="false"
          required
          placeholder="yourdomain.com"
          class="h-12 flex-1 rounded-[9px] border border-white/15 bg-white/[0.07] px-4 text-[15px] text-white placeholder:text-[oklch(0.68_0.03_275)] focus:border-white/40 focus:outline-none focus:ring-[3px] focus:ring-white/10"
        />
        <button
          type="submit"
          class="inline-flex h-12 shrink-0 cursor-pointer items-center justify-center gap-1.5 rounded-[9px] bg-white px-5 text-[15px] font-medium text-[oklch(0.2_0.06_275)] transition-colors hover:bg-[oklch(0.94_0.01_275)] disabled:cursor-wait disabled:opacity-70"
        >
          <span data-label>Get my growth plan</span>
        </button>
      </form>

      <p class="mb-9 mt-4 text-[12.5px] text-[oklch(0.68_0.03_275)] sm:text-[13px] md:mb-12">
        Free. About 60 seconds. No signup. Or <a href={PRIMARY_CTA.href} class="underline decoration-white/30 underline-offset-[3px] hover:decoration-white">add your domain</a> and self-host it free.
      </p>

      {/* Results land here. Hidden until there is something to show, so the
          page reads exactly as before for anyone who never types a domain. */}
      <section
        id="growth-plan"
        hidden
        aria-live="polite"
        class="mx-auto mb-10 max-w-[1040px] text-left md:mb-14"
      ></section>

      <AppShot />
    </div>
  </header>

  {/* Sentinel for the header overlay. It needs real height: a zero-area
      element can never intersect, so the observer fires once and never again.
      -mb-px cancels the 1px it costs the layout. */}
  <div data-header-overlay-end aria-hidden="true" class="h-px -mb-px"></div>

  {/* ── COMPARISON ───────────────────────────────────────────────────────
      Was two cards, one of them dark with a radial gradient, separated by a
      circled arrow and topped with an ALL-IN-ONE badge. It was always a table.  */}
  <section id="vs" class="border-b border-line py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <h2 class="mb-3 max-w-[22ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Same job as the autopilot tools. Opposite answer on who presses publish.
      </h2>
      <p class="mb-8 max-w-[58ch] md:mb-11 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
        Outrank, Distribb and BabyLoveGrowth all open with the word
        &ldquo;autopilot&rdquo;. Every row below is checkable against their own
        homepages.
      </p>

      {/* Two renderings of one array. A three-column table needs about 640px
          to stay readable, so on a phone it either scrolls sideways or the
          columns collapse to two words each. Below md the same rows stack as
          per-job cards; from md up it is the table. COMPARISON is the single
          source, so the two cannot drift. */}
      <ul class="flex flex-col gap-3 md:hidden">
        {COMPARISON.map((row) => (
          <li class="rounded-lg border border-line bg-bg p-4">
            <div class="text-[14px] font-semibold tracking-[-0.01em] text-ink">{row.label}</div>
            <dl class="mt-3 flex flex-col gap-2.5">
              <div class="flex flex-col gap-0.5">
                <dt class="text-[12px] text-ink-3">{COMPARISON_THEM}</dt>
                <dd class="ml-0 text-[14px] text-ink-3">{row.legacy}</dd>
              </div>
              <div class="flex flex-col gap-0.5 border-t border-line-soft pt-2.5">
                <dt class="text-[12px] text-accent-ink">{APP_NAME}</dt>
                <dd class="ml-0 text-[14px] font-medium text-ink">{row.ours}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>

      <table class="hidden w-full border-collapse text-left md:table">
        <thead>
          <tr>
            <th class="w-[30%] border-b border-ink pb-3 text-[13.5px] font-medium text-ink-3">
              <span class="sr-only">Job</span>
            </th>
            <th class="w-[35%] border-b border-ink pb-3 text-[14px] font-medium text-ink-3">
              Traditional SEO stack
            </th>
            <th class="w-[35%] border-b border-ink pb-3 text-[14px] font-semibold tracking-[-0.01em] text-ink">
              {APP_NAME}
            </th>
          </tr>
        </thead>
        <tbody>
          {COMPARISON.map((row) => (
            <tr>
              <td class="border-b border-line-soft py-3.5 pr-6 align-top text-[14px] text-ink-2">
                {row.label}
              </td>
              <td class="border-b border-line-soft py-3.5 pr-6 align-top text-[14px] text-ink-3">
                {row.legacy}
              </td>
              <td class="border-b border-line-soft py-3.5 align-top text-[14px] font-medium text-ink">
                {row.ours}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {/* ── OPEN SOURCE ──────────────────────────────────────────────────────  */}
  <section class="border-b border-line bg-panel py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <div class="grid items-start gap-10 lg:gap-12 lg:grid-cols-[1.15fr_1fr]">
        <div>
          <h2 class="mb-4 max-w-[22ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
            Run it yourself, put your brand on it, keep the margin.
          </h2>
          <p class="mb-6 max-w-[56ch] md:mb-7 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
            {APP_NAME} is going open source with the whole product in the open:
            multi-client workspaces, white-label reporting and the approval gate
            all sit in the free self-hosted build, not behind a paid tier.
            You get the whole execution layer without a licence conversation. We
            get paid when you would rather not run it yourself.
          </p>
          <Button href="/open-source" variant="secondary" arrow>
  What open source means for you
</Button>
        </div>

        <div class="overflow-hidden rounded-lg border border-line bg-bg">
          <ul>
            {[
              'Multi-client workspaces',
              'White-label reports',
              'All 12 publishing destinations',
              'Editorial approval gate',
              'The SEO scoring algorithm, readable',
            ].map((item, i) => (
              <li
                class={`flex items-center gap-3 px-5 py-3.5 text-[14px] text-ink-2 ${
                  i > 0 ? 'border-t border-line-soft' : ''
                }`}
              >
                <svg
                  class="h-4 w-4 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--ok)"
                  stroke-width="2.2"
                >
                  <path d="M5 12.5 10 17 19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <p class="border-t border-line px-5 py-4 text-[13px] leading-relaxed text-ink-3">
            No <code class="rounded bg-panel-2 px-1 py-0.5 font-mono text-[0.85em]">ee/</code>
            directory. No paid tier held back from the source.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── HOW IT WORKS ─────────────────────────────────────────────────────
      Numbered, because this is genuinely a sequence and the order is the
      information. The number sits inside the h3 rather than floating above it
      as a separate label.                                                    */}
  <section id="how-it-works" class="border-b border-line py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <h2 class="mb-3 max-w-[20ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Five working days from domain to first published article.
      </h2>
      <p class="mb-8 max-w-[58ch] md:mb-11 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
        Ten minutes of setup: the domain, three published pieces so it learns
        your voice, and the CMS connection. After that it runs on its own, and
        stops at your inbox.
      </p>

      <div class="grid overflow-hidden rounded-lg border border-line bg-bg md:grid-cols-2 lg:grid-cols-4">
        {STEPS.map((step, i) => (
          <div
            class={`p-5 sm:p-6 ${i < STEPS.length - 1 ? 'border-b border-line md:border-b-0 md:border-r' : ''}`}
          >
            <h3 class="mb-2.5 text-[17px] font-semibold tracking-[-0.015em]">
              <span class="mr-1 font-medium tabular-nums text-ink-3">{step.n}.</span>
              {step.title}
            </h3>
            <p class="text-sm leading-relaxed text-ink-2">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── AGENT READINESS ──────────────────────────────────────────────────
      Replaces the dark card that drew a fake AI-citation tracker for a feature
      that does not exist (the removed comment said so outright). This is the
      one piece of original data the site owns, so it gets a real section.     */}
  <section class="border-b border-line bg-panel py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <div class="grid items-start gap-10 lg:gap-12 lg:grid-cols-[1.15fr_1fr]">
        <div>
          <h2 class="mb-4 max-w-[20ch] text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
            Most sites are invisible to AI assistants.
          </h2>
          <p class="mb-5 max-w-[56ch] text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
            We scanned {READINESS_SCAN.sites} agency websites against nine checks
            that decide whether an assistant can read a site at all: crawler
            rules, structured data, a resolvable entity, a machine-readable copy
            of each page. {READINESS_SCAN.failedEverything}% had done none of
            them. Agency sites are the population we measured; nothing suggests
            the rest of the web does better.
          </p>
          <p class="mb-6 max-w-[56ch] md:mb-7 text-[15.5px] leading-relaxed text-ink-2 sm:text-[16.5px] [text-wrap:pretty]">
            {APP_NAME} runs those nine checks on any domain you add, then
            generates the fixes rather than handing you a list.
          </p>
          <Button href="/geo/track-ai-citations-for-clients" variant="secondary" arrow>
  Read the methodology
</Button>
        </div>

        <div class="rounded-lg border border-line bg-bg p-5 sm:p-6">
          <div class="flex items-baseline gap-3">
            <span class="text-[56px] font-semibold leading-none tracking-[-0.035em] tabular-nums text-ink">
              {READINESS_SCAN.failedEverything}%
            </span>
            <span class="text-[15px] leading-snug text-ink-2">
              failed every check
            </span>
          </div>
          <p class="mt-4 border-t border-line-soft pt-4 text-[13.5px] leading-relaxed text-ink-3">
            {READINESS_SCAN.sites} agency sites, scanned August 2026.
            Nine checks, run by the same code that runs on client domains.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── WHAT IT DOES ─────────────────────────────────────────────────────
      Three real capabilities, stated once. The six numbered cards this
      replaces included a drawn Google SERP with invented competitors, a
      language card claiming 142 languages the code does not have, and a
      domain-rating ticker for two agencies that were deleted as fabricated in
      cfd78ef / edc6ed9 and had survived here.                                */}
  <section id="features" class="border-b border-line py-14 md:py-20 lg:py-[88px]">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-8">
      <h2 class="mb-8 max-w-[24ch] md:mb-11 text-[clamp(25px,5vw,40px)] font-semibold leading-[1.08] tracking-[-0.026em] text-ink [text-wrap:balance]">
        Built to be read, not just run.
      </h2>

      <div class="grid gap-4 md:grid-cols-3">
        <div class="flex flex-col rounded-lg border border-line bg-bg p-5 sm:p-6">
          <h3 class="mb-3 text-[19px] font-semibold leading-snug tracking-[-0.018em] [text-wrap:balance]">
            It writes in your voice, not a model&rsquo;s
          </h3>
          <p class="text-[14.5px] leading-relaxed text-ink-2">
            Upload three to five published pieces. {APP_NAME} extracts tone,
            cadence, vocabulary and the phrases you refuse to use, into a voice
            profile every draft is written against. One profile per workspace,
            so a second site never inherits the first one&rsquo;s voice.
          </p>
        </div>

        <div class="flex flex-col rounded-lg border border-line bg-bg p-5 sm:p-6">
          <h3 class="mb-3 text-[19px] font-semibold leading-snug tracking-[-0.018em] [text-wrap:balance]">
            Nothing publishes unreviewed
          </h3>
          <p class="text-[14.5px] leading-relaxed text-ink-2">
            Not a setting you leave switched off, an absence. The MCP server
            exposes no publish tool, and <code class="rounded bg-panel-2 px-1 py-0.5 font-mono text-[0.85em]">auto_generate</code>
            has no publish counterpart. A machine picks the topic and writes the
            draft. A person decides it ships.
          </p>
          <a
            href="/approval-first-seo-content"
            class="mt-4 inline-flex items-center gap-1.5 text-[13.5px] font-medium text-accent-ink underline decoration-line decoration-1 underline-offset-[3px] transition-colors hover:decoration-current"
          >
            Why the gate is the product
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="flex flex-col rounded-lg border border-line bg-bg p-5 sm:p-6">
          <h3 class="mb-3 text-[19px] font-semibold leading-snug tracking-[-0.018em] [text-wrap:balance]">
            Publishes where you already are
          </h3>
          <p class="mb-5 text-[14.5px] leading-relaxed text-ink-2">
            Eleven destinations you can connect today, plus {LOCALE_COUNT}
            locales if you do not sell in English.
          </p>
          <div class="mt-auto flex flex-wrap gap-1.5">
            {CMS_LIST.map((cms) => (
              <span
                class:list={[
                  'rounded-md border px-2.5 py-1 text-[12px]',
                  cms.soon
                    ? 'border-dashed border-line bg-transparent text-ink-3'
                    : 'border-line bg-panel text-ink-2',
                ]}
              >
                {cms.name}
                {cms.soon && (
                  <span class="ml-1.5 text-[10.5px] uppercase tracking-[0.04em]">
                    Soon
                  </span>
                )}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTABanner />
</Marketing>

<script>
  // ClientRouter swaps the document without re-executing module scripts,
  // so this re-binds the form each time the homepage is navigated to.
  // Every listener below is bound to an element inside the swapped DOM,
  // which takes them with it when it goes: nothing to tear down.
  document.addEventListener('astro:page-load', () => {

  // The growth plan hook. Progressive in the only way that matters here: with
  // no script the form still submits nowhere harmful (novalidate, no action),
  // and the rest of the page is unchanged.
  const form = document.getElementById("growth-plan-form") as HTMLFormElement | null;
  const out = document.getElementById("growth-plan");
  if (form && out) {
    // Read at submit time, not load time, so the endpoints are one attribute
    // to point elsewhere (a local API while developing, a staging app).
    const endpoints = () => ({ api: form.dataset.api!, leadApi: form.dataset.lead!, signup: form.dataset.signup! });
    const input = form.querySelector<HTMLInputElement>("input[name=domain]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const label = button.querySelector<HTMLElement>("[data-label]")!;

    const esc = (s: unknown) =>
      String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
    const n = (v: number | null) => (v === null || v === undefined ? "—" : v.toLocaleString("en-US"));
    const clean = (d: string) => d.trim().toLowerCase().replace(/^https?:\/\//, "").replace(/^www\./, "").replace(/[/?#].*$/, "");

    const card = (title: string, sub: string, body: string) => `
      <div class="rounded-xl border border-white/12 bg-white/[0.05] p-5 sm:p-6">
        <h3 class="text-[15px] font-semibold text-white">${title}</h3>
        <p class="mb-4 mt-1 text-[13px] leading-relaxed text-[oklch(0.72_0.03_275)]">${sub}</p>
        ${body}
      </div>`;
    const empty = (msg: string) => `<p class="text-[13.5px] text-[oklch(0.78_0.03_275)]">${msg}</p>`;
    const row = (l: string, r: string) =>
      `<li class="flex items-baseline justify-between gap-4 border-t border-white/10 py-2.5 text-[13.5px] first:border-t-0"><span class="text-white">${l}</span><span class="shrink-0 font-mono text-[12px] text-[oklch(0.78_0.03_275)]">${r}</span></li>`;

    const render = (plan: any) => {
      const { leadApi, signup } = endpoints();
      const d = esc(plan.domain);
      const ranked = plan.layers?.find((l: any) => l.id === "ranked");
      const wins = plan.closestWins ?? [];
      const gaps = plan.gaps ?? [];
      const failing = plan.readiness?.failing ?? [];
      const artifacts = (plan.readiness?.artifacts ?? []).filter((a: any) => a.body);

      const winsBody = wins.length
        ? `<ul>${wins.map((w: any) => row(`${esc(w.keyword)} <span class="text-[oklch(0.68_0.03_275)]">· ${esc(w.path)}</span>`, `#${w.position} · ${n(w.volume)}/mo`)).join("")}</ul>`
        : ranked && !ranked.ok
          ? empty("No rank data came back for this domain.")
          : plan.rankingKeywords
            ? empty(`${n(plan.rankingKeywords)} ranking terms found, none sitting on page two right now. The gaps are where the work is.`)
            : empty("Nothing ranking yet. Every article is a first one, so the gaps below are the plan.");

      const gapsBody = gaps.length
        ? `<ul>${gaps.map((g: any) => row(esc(g.keyword), `${n(g.volume)}/mo · ${g.rankedBy.map((r: any) => `${esc(r.domain)} #${r.position}`).join(", ")}`)).join("")}</ul>`
        : empty(plan.competitors?.length ? "Nothing on page one for your competitors that you lack." : "No organic competitors could be identified for this domain yet.");

      const readyBody = plan.readiness?.error
        ? empty(esc(plan.readiness.error))
        : `<p class="mb-3 text-[28px] font-semibold leading-none text-white">${plan.readiness.score}<span class="text-[14px] font-normal text-[oklch(0.68_0.03_275)]">/100</span></p>` +
          (failing.length
            ? `<ul>${failing.map((f: any) => row(esc(f.check.replace(/_/g, " ")), "")).join("")}</ul>` +
              (artifacts.length ? `<p class="mt-3 text-[12.5px] text-[oklch(0.72_0.03_275)]">${artifacts.length} fix${artifacts.length === 1 ? "" : "es"} generated, ready to paste. They come with the full plan.</p>` : "")
            : empty("Every check passes. AI assistants can read this site."));

      const targets = (plan.cadence?.firstTargets ?? []).map(esc);
      out.innerHTML = `
        <p class="mb-4 font-mono text-[11px] uppercase tracking-[0.08em] text-[oklch(0.72_0.03_275)]">Growth plan for ${d}${plan.cached ? " · cached today" : ""}</p>
        <div class="grid gap-3 md:grid-cols-3">
          ${card("Closest wins", "Terms you already rank for on page two. One revision from page one.", winsBody)}
          ${card("Gaps", `What ${plan.competitors?.map((c: any) => esc(c.domain)).join(" and ") || "competitors"} rank for on page one and you do not.`, gapsBody)}
          ${card("Can AI read your site?", "Nine checks: crawler rules, structured data, a machine-readable copy.", readyBody)}
        </div>
        <div class="mt-4 rounded-xl border border-white/12 bg-white/[0.05] p-5 sm:p-6">
          <p class="text-[14.5px] leading-relaxed text-white">
            ${plan.cadence?.articlesPerMonth ?? 4} articles a month${targets.length ? `, starting with <em class="font-display-italic">${targets.join("</em>, <em class=\"font-display-italic\">")}</em>` : ""}. First one published in ${plan.cadence?.firstPublishDays ?? 5} working days, after you approve it.
          </p>
          <div class="mt-4 flex flex-col gap-2.5 sm:flex-row sm:items-center">
            <a href="${signup}?domain=${encodeURIComponent(plan.domain)}" class="inline-flex h-11 items-center justify-center rounded-[9px] bg-white px-5 text-[14px] font-medium text-[oklch(0.2_0.06_275)] hover:bg-[oklch(0.94_0.01_275)]">Start publishing against this plan &rarr;</a>
            <form id="growth-plan-lead" class="flex flex-1 gap-2">
              <input name="email" type="email" required placeholder="you@company.com" class="h-11 min-w-0 flex-1 rounded-[9px] border border-white/15 bg-white/[0.07] px-3.5 text-[14px] text-white placeholder:text-[oklch(0.68_0.03_275)] focus:border-white/40 focus:outline-none" />
              <button type="submit" class="h-11 shrink-0 cursor-pointer rounded-[9px] border border-white/25 px-4 text-[14px] text-white hover:bg-white/10">Email me the full plan</button>
            </form>
          </div>
          <p data-lead-status class="mt-2 min-h-[1.2em] text-[12.5px] text-[oklch(0.72_0.03_275)]"></p>
        </div>`;
      out.hidden = false;

      const lead = document.getElementById("growth-plan-lead") as HTMLFormElement | null;
      const status = out.querySelector<HTMLElement>("[data-lead-status]")!;
      lead?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = (lead.querySelector<HTMLInputElement>("input[name=email]")!).value.trim();
        status.textContent = "Sending…";
        try {
          const res = await fetch(leadApi, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email, domain: plan.domain }) });
          const body = await res.json();
          status.textContent = !res.ok
            ? body.error ?? "Could not save that."
            : body.emailed
              ? "Sent. The full plan, generated fixes included, is in your inbox."
              : "Saved. We will email you the full plan.";
        } catch {
          status.textContent = "Could not reach the server. Try again.";
        }
      });
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const domain = clean(input.value);
      if (!/^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*\.[a-z]{2,}$/.test(domain)) {
        out.innerHTML = empty("That does not look like a domain. Try example.com.");
        out.hidden = false;
        input.focus();
        return;
      }
      const { api } = endpoints();
      button.disabled = true;
      label.textContent = "Reading your site…";
      out.innerHTML = empty(`Checking what ${esc(domain)} ranks for, who else ranks for it, and whether AI assistants can read it. About 60 seconds at most, usually a few.`);
      out.hidden = false;
      try {
        const res = await fetch(api, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ domain }) });
        const body = await res.json();
        if (!res.ok) {
          out.innerHTML = empty(esc(body.error ?? "Could not build a plan for that domain right now."));
        } else {
          render(body);
        }
      } catch {
        out.innerHTML = empty("Could not reach the server. Try again in a moment.");
      } finally {
        button.disabled = false;
        label.textContent = "Get my growth plan";
      }
    });
  }
  });
</script>
