---
import Marketing from '@/layouts/Marketing.astro';
import Button from '@/components/shared/Button.astro';
---

<Marketing
  title="Page not found | AltoRank"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <section class="flex min-h-[60vh] items-center justify-center py-[88px]">
    <div class="text-center">
      <div class="mb-4 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">404</div>
      <h1 class="mb-3 text-[36px] font-semibold tracking-[-0.025em]">Page not found</h1>
      <p class="mx-auto mb-8 max-w-[400px] text-base text-ink-2">
        The page you&apos;re looking for doesn&apos;t exist or has been moved.
      </p>
      <Button href="/" arrow>
  Back to homepage
</Button>
    </div>
  </section>
</Marketing>
