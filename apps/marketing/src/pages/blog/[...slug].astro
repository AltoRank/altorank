---
import Article from '@/layouts/Article.astro';
import { getCollection, render } from 'astro:content';
import { relatedPosts } from '@/lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Every post shared the product card in og-default.png, so a link to the
// schema-markup post and a link to the pricing page arrived in a Slack channel
// looking identical. `scripts/generate-og-posts.mjs` writes one card per post
// at these paths; frontmatter still wins if a post supplies its own.
const ogImage = post.data.ogImage ?? `/og/${post.id}.png`;

// Related posts by shared tag. In-body links were the only post-to-post
// navigation, which leaves any post nobody happened to link to unreachable
// except through the index. Three siblings that share a tag is the smallest
// block that fixes that without inventing relevance.
const published = await getCollection('blog', ({ data }) => !data.draft);
const related = relatedPosts(published, post).map((p) => ({
  title: p.data.title,
  description: p.data.description,
  href: `/blog/${p.id}/`,
}));
---

<Article
  title={post.data.title}
  description={post.data.description}
  publishDate={post.data.publishDate}
  dateModified={post.data.dateModified}
  author={post.data.author}
  category={post.data.category}
  tags={post.data.tags}
  ogImage={ogImage}
  schemaType="BlogPosting"
  faq={post.data.faq}
  related={related}
>
  <Content />
</Article>
