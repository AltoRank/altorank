---
import Marketing from '@/layouts/Marketing.astro';
import { getCollection } from 'astro:content';

// Most recently touched first: a revised post surfaces above an untouched one
// published the same day, which is also the order the sitemap's lastmod
// reports. Most posts still share one publishDate, so the id tiebreak keeps
// the output deterministic across builds.
const lastTouched = (p: { data: { publishDate: Date; dateModified?: Date } }) =>
  (p.data.dateModified ?? p.data.publishDate).valueOf();
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => lastTouched(b) - lastTouched(a) || a.id.localeCompare(b.id));
const shortDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Marketing
  title="Blog | AltoRank"
  description="SEO insights, content strategy, and generative engine optimization, from the AltoRank team."
>
  <section class="border-b border-line py-[88px]">
    <div class="mx-auto max-w-[1240px] px-8">
      <div class="mb-14 max-w-[720px]">
        <h1 class="mb-3 text-[42px] font-semibold leading-[1.08] tracking-[-0.025em]">
          Insights for SEO teams
        </h1>
        <p class="text-base text-ink-2">
          Content strategy, keyword research, and agency growth, practical advice from the AltoRank team.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group flex flex-col rounded-xl border border-line bg-bg p-6 transition-colors hover:border-accent-soft"
          >
            <span class="mb-3 w-fit rounded-full bg-accent-soft px-2 py-0.5 font-mono text-[10.5px] uppercase tracking-wider text-accent-ink">
              {post.data.category}
            </span>
            <h2 class="mb-2 text-lg font-semibold tracking-[-0.015em] group-hover:text-accent-ink transition-colors">
              {post.data.title}
            </h2>
            <p class="mb-4 text-sm text-ink-2 leading-relaxed line-clamp-3">
              {post.data.description}
            </p>
            <div class="mt-auto flex items-center gap-2 text-xs text-ink-3">
              {post.data.dateModified ? (
                <span>Updated <time datetime={post.data.dateModified.toISOString()}>{shortDate(post.data.dateModified)}</time></span>
              ) : (
                <time datetime={post.data.publishDate.toISOString()}>{shortDate(post.data.publishDate)}</time>
              )}
              <span aria-hidden="true">&middot;</span>
              <span>{post.data.author}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Marketing>
