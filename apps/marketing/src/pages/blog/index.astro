---
import Marketing from '@/layouts/Marketing.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
// Every post currently carries the same publishDate, so this comparison returns
// 0 for every pair and the resulting order is whatever getCollection happens to
// hand back: incidental, and it changes when the framework's internal ordering
// does. The id tiebreak makes the output deterministic. It does NOT fix the
// underlying problem, which is that the posts need real publish dates before
// "newest first" means anything.
  .sort((a, b) =>
    b.data.publishDate.valueOf() - a.data.publishDate.valueOf() || a.id.localeCompare(b.id),
  );
---

<Marketing
  title="Blog | AltoRank"
  description="SEO insights, content strategy, and generative engine optimization, from the AltoRank team."
>
  <section class="border-b border-line py-[88px]">
    <div class="mx-auto max-w-[1240px] px-8">
      <div class="mx-auto mb-14 max-w-[720px] text-center">
        <h1 class="mb-3 text-[42px] font-semibold leading-[1.08] tracking-[-0.025em]">
          Insights for SEO teams
        </h1>
        <p class="text-base text-ink-2">
          Content strategy, keyword research, and agency growth, practical advice from the AltoRank team.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group flex flex-col rounded-xl border border-line bg-bg p-6 transition-colors hover:border-accent-soft"
          >
            <span class="mb-3 w-fit rounded-full bg-accent-soft px-2 py-0.5 font-mono text-[10.5px] uppercase tracking-wider text-accent-ink">
              {post.data.category}
            </span>
            <h2 class="mb-2 text-lg font-semibold tracking-[-0.015em] group-hover:text-accent-ink transition-colors">
              {post.data.title}
            </h2>
            <p class="mb-4 text-sm text-ink-2 leading-relaxed line-clamp-3">
              {post.data.description}
            </p>
            <div class="mt-auto flex items-center gap-2 text-xs text-ink-3">
              <time datetime={post.data.publishDate.toISOString()}>
                {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <span>&middot;</span>
              <span>{post.data.author}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Marketing>
