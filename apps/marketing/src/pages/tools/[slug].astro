---
import PSEO from '@/layouts/PSEO.astro';
import Button from '@/components/shared/Button.astro';
import SerpPreview from '@/components/tools/SerpPreview.astro';
import WordCounter from '@/components/tools/WordCounter.astro';
import KeywordDensity from '@/components/tools/KeywordDensity.astro';
import RobotsTxt from '@/components/tools/RobotsTxt.astro';
import SchemaGenerator from '@/components/tools/SchemaGenerator.astro';
import SlugGenerator from '@/components/tools/SlugGenerator.astro';
import { getCollection, render } from 'astro:content';
import { buildArticleSchema, buildFAQSchema, buildHowToSchema } from '@/lib/schema';
import { SIGNUP_URL, APP_NAME, AUTHOR_NAME, AUTHOR_URL, SITE_URL } from '@/constants';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  const publishedSlugs = new Set(
    tools.filter((t) => t.data.published).map((t) => t.data.slug),
  );
  return tools.map((tool) => ({
    params: { slug: tool.data.slug },
    props: { tool, publishedSlugs },
  }));
}

const { tool, publishedSlugs } = Astro.props;
const { Content } = await render(tool);
const d = tool.data;
const url = `${SITE_URL}/tools/${d.slug}`;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: d.title, href: `/tools/${d.slug}` },
];

// These are guides and templates, not an on-page app, so the schema is Article
// (+ HowTo when the body is a method, + FAQ). Article is emitted only when we
// have a real datePublished; the SoftwareApplication schema was removed because
// asserting a free web app that does not exist is the same class of false claim
// the site's hard rules forbid.
const structuredData = [
  ...(d.datePublished
    ? [buildArticleSchema({
        title: d.title,
        description: d.description,
        publishDate: d.datePublished,
        dateModified: d.dateModified,
        author: AUTHOR_NAME,
        authorType: 'Person',
        authorUrl: AUTHOR_URL,
        url,
      })]
    : []),
  ...(d.steps && d.steps.length
    ? [buildHowToSchema({ name: d.title, description: d.description, steps: d.steps })]
    : []),
  ...(d.faq ? [buildFAQSchema(d.faq)] : []),
];

// Only cross-link to sibling guides that are themselves indexable, so an indexed
// page never passes links to a noindex draft.
const relatedPublished = d.relatedTools.filter((slug) => publishedSlugs.has(slug));
const relatedTitles = await getCollection('tools').then((tools) =>
  Object.fromEntries(tools.map((t) => [t.data.slug, t.data.title])),
);

// Widget lookup. The schema already restricts `widget` to these keys, so an
// unknown value cannot reach here; the ?? undefined is belt and braces for a
// content file edited ahead of a schema change.
const WIDGETS = {
  'serp-preview': SerpPreview,
  'word-counter': WordCounter,
  'keyword-density': KeywordDensity,
  'robots-txt': RobotsTxt,
  'schema-generator': SchemaGenerator,
  'slug-generator': SlugGenerator,
} as const;
const Widget = d.widget ? WIDGETS[d.widget] ?? undefined : undefined;

const displayDate = d.dateModified ?? d.datePublished;
const dateLabel = displayDate
  ? displayDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<PSEO
  title={d.title}
  description={d.description}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
  noindex={!d.published}
>
  <section class="border-b border-line py-[88px]">
    <div class="mx-auto max-w-[1240px] px-8">
      <div class="mx-auto max-w-[720px] text-center">
        <h1 class="mb-4 text-[42px] font-semibold leading-[1.08] tracking-[-0.025em] [text-wrap:balance]">
          {d.heroHeadline}
        </h1>
        <p class="mb-6 text-lg text-ink-2">
          {d.heroSubhead}
        </p>
        {dateLabel && (
          <p class="mb-8 text-sm text-ink-3">
            By{' '}
            <a href={AUTHOR_URL} rel="author" class="text-ink-2 underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-accent">
              {AUTHOR_NAME}
            </a>
            {' '}· Updated {dateLabel}
          </p>
        )}
        <Button href={SIGNUP_URL} size="lg" arrow>
  Run this for every client with {APP_NAME}
</Button>
      </div>
    </div>
  </section>

  {/* The tool itself, directly under the hero.
      A "free tool" page that makes you read 800 words before it does anything
      is an article wearing a tool's title. If there is a widget, it goes above
      the explanation, and the explanation becomes the thing you scroll to when
      the widget raises a question. */}
  {Widget && (
    <section class="border-b border-line bg-panel py-10 md:py-14">
      <div class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-8">
        <Widget />
      </div>
    </section>
  )}

  {/* Use cases */}
  <section class="border-b border-line py-16">
    <div class="mx-auto max-w-[720px] px-8">
      <h2 class="mb-6 text-2xl font-semibold tracking-[-0.015em]">What you can do</h2>
      <ul class="flex flex-col gap-3">
        {d.useCases.map((useCase) => (
          <li class="flex items-start gap-3 text-ink-2">
            <svg class="mt-0.5 w-[16px] h-[16px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="oklch(0.55 0.13 155)" stroke-width="2">
              <path d="M5 12.5 10 17 19 7" />
            </svg>
            {useCase}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Method (HowTo) */}
  {d.steps && d.steps.length > 0 && (
    <section class="border-b border-line py-16">
      <div class="mx-auto max-w-[720px] px-8">
        <h2 class="mb-6 text-2xl font-semibold tracking-[-0.015em]">The method, step by step</h2>
        <ol class="flex flex-col gap-5">
          {d.steps.map((step, i) => (
            <li class="flex items-start gap-4">
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-soft font-mono text-[13px] font-medium text-accent-ink">
                {i + 1}
              </span>
              <div>
                <h3 class="mb-1 font-semibold">{step.name}</h3>
                <p class="text-sm text-ink-2 leading-relaxed">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {/* Content */}
  <section class="border-b border-line py-16">
    <div class="mx-auto max-w-[720px] px-8 prose prose-lg max-w-none">
      <Content />
    </div>
  </section>

  {/* FAQ */}
  {d.faq && d.faq.length > 0 && (
    <section class="border-b border-line py-16">
      <div class="mx-auto max-w-[720px] px-8">
        <h2 class="mb-6 text-2xl font-semibold tracking-[-0.015em]">Frequently asked questions</h2>
        <div class="flex flex-col gap-4">
          {d.faq.map((item) => (
            <div class="rounded-lg border border-line bg-panel p-5">
              <h3 class="mb-2 font-semibold">{item.question}</h3>
              <p class="text-sm text-ink-2 leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Keep exploring: internal links into the indexable TOFU cluster */}
  <section class="border-b border-line py-16">
    <div class="mx-auto max-w-[720px] px-8">
      <h2 class="mb-6 text-2xl font-semibold tracking-[-0.015em]">Keep exploring</h2>
      <div class="flex flex-col gap-3 text-ink-2">
        {relatedPublished.map((slug) => (
          <a href={`/tools/${slug}`} class="underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-accent">
            {relatedTitles[slug]}
          </a>
        ))}
        <a href="/alternatives" class="underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-accent">
          Compare {APP_NAME} against the alternatives
        </a>
        <a href="/blog" class="underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-accent">
          More on SEO and GEO for agencies on the blog
        </a>
      </div>
    </div>
  </section>
</PSEO>
