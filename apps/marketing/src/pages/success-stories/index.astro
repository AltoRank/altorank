---
import Marketing from '@/layouts/Marketing.astro';
import Button from '@/components/shared/Button.astro';
import { getCollection } from 'astro:content';

const stories = (await getCollection('success-stories', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Marketing
  title="Success Stories | AltoRank"
  description="Worked examples of the AltoRank content workflow, from keyword research through to an approved, published article."
  {/* Both stories are correctly draft:true (no real customers yet), so this hub
      renders empty at 269 words. Keep it reachable but out of the index until
      there is a real story to show. */}
  noindex={true}
>
  <section class="border-b border-line py-[88px]">
    <div class="mx-auto max-w-[1240px] px-8">
      <div class="mx-auto mb-14 max-w-[720px] text-center">
        <h1 class="mb-3 text-[42px] font-semibold leading-[1.08] tracking-[-0.025em]">
          Real results from real teams
        </h1>
        <p class="text-base text-ink-2">
          How teams are using AltoRank to ship ranking content, without handing over the publish button.
        </p>
      </div>

      {stories.length === 0 ? (
        <div class="mx-auto max-w-[640px] rounded-xl border border-dashed border-line bg-panel/40 p-10 text-center">
          <h2 class="mb-3 text-2xl font-semibold tracking-[-0.015em] text-ink">
            We're onboarding the first cohort now.
          </h2>
          <p class="mb-6 text-base leading-relaxed text-ink-2">
            Real case studies land here once those customers have shipped content for long enough to measure. Until then, the honest answer is: it's day one. The pilot cohort is agencies, because that is who we approached first, not because the product needs one.
          </p>
          <Button href="/pricing">
  See pricing
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="16" height="16">
              <path d="M5 12h14m0 0-6-6m6 6-6 6" />
            </svg>
</Button>
        </div>
      ) : (
        <div class="grid gap-6 md:grid-cols-2">
          {stories.map((story) => (
            <a
              href={`/success-stories/${story.data.slug}/`}
              class="group flex flex-col rounded-xl border border-line bg-bg p-6 transition-colors hover:border-accent-soft"
            >
              <div class="mb-4 flex items-center gap-3">
                <div class="grid h-10 w-10 place-items-center rounded-lg bg-panel font-mono text-sm font-semibold text-ink-2">
                  {story.data.company.slice(0, 2).toUpperCase()}
                </div>
                <div>
                  <h2 class="font-semibold tracking-[-0.01em] group-hover:text-accent-ink transition-colors">
                    {story.data.company}
                  </h2>
                  <span class="text-xs text-ink-3">{story.data.industry}</span>
                </div>
              </div>
              <p class="mb-4 text-sm text-ink-2 leading-relaxed">
                {story.data.description}
              </p>
              <div class="mt-auto grid grid-cols-2 gap-3">
                <div class="rounded-md border border-line bg-panel p-3 text-center">
                  <div class="text-xl font-semibold text-ok-ink">{story.data.results.trafficGrowth}</div>
                  <div class="text-[11px] text-ink-3">Traffic growth</div>
                </div>
                <div class="rounded-md border border-line bg-panel p-3 text-center">
                  <div class="text-xl font-semibold text-accent-ink">{story.data.results.timeToFirstRank}</div>
                  <div class="text-[11px] text-ink-3">Time to first rank</div>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Marketing>
