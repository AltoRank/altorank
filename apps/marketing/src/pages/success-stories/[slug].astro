---
import Article from '@/layouts/Article.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const stories = await getCollection('success-stories', ({ data }) => !data.draft);
  return stories.map((story) => ({
    params: { slug: story.data.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);
---

<Article
  title={`${story.data.company}: ${story.data.description}`}
  description={story.data.description}
  publishDate={story.data.publishDate}
  author="AltoRank Team"
  category="case-study"
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Success Stories', href: '/success-stories' },
    { label: story.data.company, href: `/success-stories/${story.data.slug}` },
  ]}
>
  {/* Results summary */}
  <div class="mb-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="rounded-lg border border-line bg-panel p-4">
      <div class="text-2xl font-semibold text-ok-ink">{story.data.results.trafficGrowth}</div>
      <div class="mt-1 text-xs text-ink-3">Traffic growth</div>
    </div>
    <div class="rounded-lg border border-line bg-panel p-4">
      <div class="text-2xl font-semibold text-accent-ink">{story.data.results.timeToFirstRank}</div>
      <div class="mt-1 text-xs text-ink-3">Time to rank</div>
    </div>
    {story.data.results.articlesPublished && (
      <div class="rounded-lg border border-line bg-panel p-4">
        <div class="text-2xl font-semibold">{story.data.results.articlesPublished}</div>
        <div class="mt-1 text-xs text-ink-3">Articles</div>
      </div>
    )}
    {story.data.results.backlinksGained && (
      <div class="rounded-lg border border-line bg-panel p-4">
        <div class="text-2xl font-semibold">{story.data.results.backlinksGained}</div>
        <div class="mt-1 text-xs text-ink-3">Backlinks</div>
      </div>
    )}
  </div>

  <Content />
</Article>
