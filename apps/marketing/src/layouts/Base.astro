---
import '@/styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import { buildOrganizationSchema, buildBreadcrumbSchema } from '@/lib/schema';
import { imageDimensions, ogLocale, breadcrumbsFromPath } from '@/lib/seo';
import { SITE_URL, APP_NAME } from '@/constants';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  structuredData?: object | object[];
  noindex?: boolean;
  lang?: string;
  alternateLanguages?: { hreflang: string; href: string }[];
  /** Alt text for the social card. Defaults to the page title. */
  ogImageAlt?: string;
  /**
   * Emitted as article:* Open Graph tags when ogType is "article". Dates are
   * ISO strings; the layout that knows the post supplies them.
   */
  article?: { publishedTime: string; modifiedTime: string; author?: string; tags?: string[] };
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage = '/og-default.png',
  ogType = 'website',
  structuredData,
  noindex = false,
  lang = 'en',
  alternateLanguages,
  ogImageAlt,
  article,
} = Astro.props;

const ogImageUrl = new URL(ogImage, Astro.site).href;
// Real pixel size read from the file in public/, so the tags are never a guess.
// Undefined for a remote or unreadable image, in which case they are omitted.
const ogSize = imageDimensions(ogImage);
const locale = ogLocale(lang);
// og:locale:alternate lists the OTHER languages this page exists in. x-default
// is a search-engine hint, not a locale, and the page's own language is the
// og:locale itself, so both are skipped.
const localeAlternates = (alternateLanguages ?? [])
  .map((a) => a.hreflang)
  .filter((l) => l !== 'x-default' && l !== lang)
  .map(ogLocale);

// hreflang must resolve to the SAME URL as the canonical, or the annotation
// points at a redirect and the pair is weaker than it looks. Canonicals here
// carry a trailing slash: astro.config.ts leaves `trailingSlash` at the default
// and the build is directory-format, so `Astro.url.href` ends in "/". Pages
// author their alternates as `${SITE_URL}/path` with no slash, so normalise in
// one place rather than trusting six call sites (and every future one) to
// remember.
const withTrailingSlash = (href: string) => (href.endsWith('/') ? href : `${href}/`);

const siteName = APP_NAME;

// Cloudflare Web Analytics, env-driven so the token can rotate without a
// code change. Set PUBLIC_CF_ANALYTICS_TOKEN in Cloudflare Pages env vars
// (Production + Preview). If unset, the beacon simply isn't emitted.
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

// Open-source, cookieless analytics. Cloudflare Web Analytics gives pageviews
// but cannot record events, and the question that actually matters here is
// whether organic traffic reaches the signup, which is an outbound click to
// another host. That needs event tracking.
//
// Provider-agnostic on purpose: Umami (MIT) and Plausible (AGPL-3.0) expose the
// same "track a named event" shape, so either can be dropped in by setting the
// matching env vars, and neither sets a cookie or collects personal data, so no
// consent banner is required under GDPR. Self-hosting keeps the data in the EU.
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const plausibleSrc = import.meta.env.PUBLIC_PLAUSIBLE_SRC;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;

const hasUmami = Boolean(umamiSrc && umamiWebsiteId);
const hasPlausible = Boolean(plausibleSrc && plausibleDomain);
const hasEventAnalytics = hasUmami || hasPlausible;

// Sitewide entity schemas, every page contributes Organization + WebSite
// signals to search engines and AI crawlers. Page-specific structuredData
// (Article, FAQPage, ItemList, BreadcrumbList, etc.) layers on top via the
// `structuredData` prop and gets concatenated below.
const sitewideSchemas = [
  buildOrganizationSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: SITE_URL,
    // SearchAction omitted (2026-06-20): on-site blog search isn't implemented,
    // so advertising a sitelinks-searchbox would be an inaccurate schema claim.
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonicalUrl,
    isPartOf: { '@type': 'WebSite', name: siteName, url: SITE_URL },
    inLanguage: lang,
  },
];

const pageSchemas = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];

// Every page below the root gets a BreadcrumbList. Templated pages author
// theirs; the hub pages (/about, /pricing, /blog, ...) never did, so nine
// routes shipped without one. Derive it from the URL when absent, with the
// page's own title (minus the " | AltoRank" suffix) as the last crumb. The
// 404 page is skipped: it has no stable URL to describe.
const hasBreadcrumbs = pageSchemas.some((s) => (s as { '@type'?: string })['@type'] === 'BreadcrumbList');
const pathname = Astro.url.pathname;
const is404 = /^\/404\/?$/.test(pathname);
const fallbackBreadcrumbs =
  !hasBreadcrumbs && pathname !== '/' && !is404
    ? [buildBreadcrumbSchema(breadcrumbsFromPath(pathname, title.replace(/\s*\|\s*AltoRank$/, '')))]
    : [];

const allSchemas = [...sitewideSchemas, ...pageSchemas, ...fallbackBreadcrumbs];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Icons. favicon.ico is listed first as the bare-path fallback: browsers
         request /favicon.ico unprompted, and it 404'd on every page before.
         Regenerate the whole set with `npm run favicon:generate`. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1A1815" />

    <!-- Client-side routing. Internal <a> navigations swap the document instead
         of reloading it, so the stylesheet, fonts and analytics scripts are
         parsed once for the whole session rather than once per page.

         The cost is that module scripts do not re-execute on a soft navigation:
         anything that binds to the DOM has to re-bind on `astro:page-load`.
         See Header.astro, index.astro and pricing.astro. -->
    <ClientRouter />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@1,16..72,400&display=swap"
      rel="stylesheet"
    />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateLanguages?.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={withTrailingSlash(alt.href)} />
    ))}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />
    {localeAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:image" content={ogImageUrl} />
    {ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
    {ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}
    <meta property="og:image:alt" content={ogImageAlt ?? title} />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        <meta property="article:modified_time" content={article.modifiedTime} />
        {article.author && <meta property="article:author" content={article.author} />}
        {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? title} />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} Blog`}
      href="/rss.xml"
    />

    <!-- Structured Data (sitewide Organization + WebSite + WebPage, plus any page-specific layers) -->
    <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
    {cfAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
      ></script>
    )}

    {hasUmami && (
      <script defer src={umamiSrc} data-website-id={umamiWebsiteId}></script>
    )}
    {hasPlausible && (
      <script defer src={plausibleSrc} data-domain={plausibleDomain}></script>
    )}

    {hasEventAnalytics && (
      /* Records the one conversion that matters: a click through to the signup
         app. Delegated from the document so it covers every CTA on every page
         without touching 27 call sites, and it reads the destination from the
         link itself rather than a hardcoded host. Fails silently if the
         provider script is blocked, which is the correct behaviour for a
         tracker: it must never break navigation. */
      <script is:inline>
        document.addEventListener('click', function (event) {
          var link = event.target instanceof Element ? event.target.closest('a[href]') : null;
          if (!link) return;
          var href = link.getAttribute('href') || '';
          if (href.indexOf('app.altorank.co') === -1) return;
          var name = href.indexOf('/signup') !== -1 ? 'signup-click' : 'app-click';
          var props = { path: window.location.pathname };
          try {
            if (window.umami && typeof window.umami.track === 'function') {
              window.umami.track(name, props);
            } else if (typeof window.plausible === 'function') {
              window.plausible(name, { props: props });
            }
          } catch (err) {
            /* analytics must never interfere with the click */
          }
        });
      </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />

    <!--
      FAQ answers live inside <details>, and a closed <details> hides its content
      in the UA shadow DOM where CSS cannot reach it. Printing therefore produced
      a list of questions with no answers. Open them for print and restore after,
      so the printed page and the PDF leave-behind carry the full text.
    -->
    <script is:inline>
      (function () {
        var opened = [];
        function expand() {
          opened = [];
          document.querySelectorAll('details:not([open])').forEach(function (d) {
            opened.push(d);
            d.open = true;
          });
        }
        function restore() {
          opened.forEach(function (d) { d.open = false; });
          opened = [];
        }
        window.addEventListener('beforeprint', expand);
        window.addEventListener('afterprint', restore);
        // Headless Chrome's --print-to-pdf does not reliably fire beforeprint,
        // so honour an explicit ?print=1 for generating the PDF artifact.
        if (location.search.indexOf('print=1') !== -1) expand();
      })();
    </script>
  </body>
</html>
