{
  "name": "altorank-marketing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-agent-files.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "og:generate": "node scripts/generate-og-default.mjs",
    "favicon:generate": "node scripts/generate-favicon.mjs",
    "pdf": "node scripts/generate-pdf.mjs",
    "deploy": "npm run build && npx --yes wrangler pages deploy dist --branch main --project-name ${CF_PAGES_PROJECT:?set CF_PAGES_PROJECT to your Cloudflare Pages project name (and CLOUDFLARE_API_TOKEN, or run: npx wrangler login)}",
    "brand:generate": "node scripts/generate-brand.mjs",
    "og:posts": "node scripts/generate-og-posts.mjs",
    "og": "npm run og:generate && npm run og:posts"
  },
  "dependencies": {
    "astro": "^5.7.10",
    "@astrojs/mdx": "^4.2.6",
    "@astrojs/sitemap": "^3.3.1",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.5",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
